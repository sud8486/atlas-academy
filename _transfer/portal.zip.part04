pic": "", "source": "U.P.P.C.S. (Pre) 2002", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0259", "q": "राष्ट्रीय वन नीति (1952) के अनुसार‚ निम्नलिखित में से कौन-सा वन का संवर्ग नहीं है?", "options": ["राष्ट्रीय वन", "राष्ट्रीय उद्यान", "संरक्षित वन", "ग्राम वन"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2016", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0260", "q": "2015 में निम्नलिखित राज्यों में से किसके भौगोलिक क्षेत्रफल का सबसे अधिक प्रतिशतांश वनों के अंतर्गत था?", "options": ["अरुणाचल प्रदेश", "नगालैंड", "मेघालय", "मिजोरम"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2017", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0261", "q": "पर्यावरण मंत्र्ाालय द्वारा जारी किए गए इंडियन स्टेट ऑफ फॉरेस्ट रिपोर्ट‚ 2015 के अनुसार‚ भारत के पूरे भौगोलिक क्षेत्र का कितना प्रतिशत क्षेत्र वनों और पेड़ों से आच्छादित है?", "options": ["22.48", "23.00", "24.16", "24.48"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Pre) 2016", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0262", "q": "‘इंडिया स्टेट ऑफ फॉरेस्ट रिपोर्ट‚ 2017’ के अनुसार‚ देश के कुल भौगोलिक क्षेत्रफल का कितना प्रतिशत वनाच्छादित है?", "options": ["21.04", "21.54", "20.54", "20.04"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2017", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0263", "q": "‘भारत वन स्थिति रिपोर्ट‚ 2019’ के अनुसार‚ निम्नलिखित में से किस राज्य में जनजातीय जिलों की संख्या सबसे अधिक है?", "options": ["नगालैंड", "मेघालय", "मिजोरम", "मणिपुर"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2021", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0264", "q": "भारत वन स्थिति रिपोर्ट , 2023 के अनु सार, उत्तर प्रदे श के निम्नलिखित में से किन जिलों में उनके कुल क्षेत्रफल के 20 प्रतिशत से अधिक पर वन है?\n1. बहराइच\n2. चंदौली\n3. श्रावस्ती\nनीचे दिए गए कूट से सही उत्तर चुनिए :\nकूट :", "options": ["1 और 2", "केवल 3", "2 और 3", "केवल 1"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Pre) 2025", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0265", "q": "भारत का वह कौन-सा राज्य है‚ जिसका वनाच्छादित क्षेत्रफल सर्वाधिक है?", "options": ["मध्य प्रदेश", "पश्चिम बंगाल", "महाराष्ट्र", "असम"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2000 | R.A.S./R.T.S. (Pre) 2004", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0266", "q": "भारत के किस राज्य में उसके क्षेत्र का अधिकतम प्रतिशत क्षेत्र वनाच्छादित है?", "options": ["अरुणाचल प्रदेश", "मेघालय", "मिजोरम", "नगालैंड पारिस्थितिकी in @ (Mains) 2012"], "answer": 2, "explanation": "", "topic": "", "source": "JoU.P.P.C.S.", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0267", "q": "भारतीय वन सवक्षण की रिपोर्ट के अनुसार‚ भारत के निम्नलिखित में से किस राज्य में भौगोलिक क्षेत्र का सर्वाधिक प्रतिशत वन क्षेत्र है?", "options": ["मणिपुर", "मेघालय", "मिजोरम", "नगालैंड"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Pre) 2016", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0268", "q": "कुल भौगोलिक क्षेत्रफल के संदर्भ में वनों का उच्चतम प्रतिशत मिलता है", "options": ["अरुणाचल प्रदेश में", "नगालैंड में", "त्रिपुरा में", "मिजोरम में"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2002 | U.P.U.D.A./L.D.A. (Pre) 2010", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0269", "q": "भारत में अति सघन वनों का सर्वाधिक क्षेत्र जिस राज्य में पाया जाता है‚ वह है", "options": ["अरुणाचल प्रदेश", "मध्य प्रदेश", "महाराष्ट्र", "उड़ीसा"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2011", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0270", "q": "7224.42\nनिम्न में से भारत में किस राज्य/संघीय क्षेत्र के भौगोलिक क्षेत्रफल का अधिकतम भाग वनाच्छादित है?", "options": ["त्रिपुरा", "अंडमान एवं निकोबार", "नगालैंड", "मिजोरम"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2008", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0271", "q": "निम्नलिखित कथनों में से कौन एक सत्य नहीं है?", "options": ["मध्य प्रदेश में सर्वाधिक वन क्षेत्र है।", "अरुणाचल प्रदेश में सर्वाधिक घना वन क्षेत्र है।", "नगालैंड भारत का सर्वाधिक वनाच्छादित राज्य है।", "हरियाणा भारत का सबसे कम वनाच्छादित राज्य है।"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.S.C. (GIC) 2010", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0272", "q": "वृक्षाच्छादित क्षेत्र सर्वाधिक हैं", "options": ["पूर्वी दक्कन में", "उत्तरी मैदानी क्षेत्र में", "पश्चिमी तट में", "पूर्वी तट में"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2009", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0273", "q": "भारत के कुल भौगोलिक क्षेत्र में सघन वनावरण का प्रतिशत है", "options": ["लगभग 8 प्रतिशत", "लगभग 10 प्रतिशत", "लगभग 12 प्रतिशत", "लगभग 14 प्रतिशत"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2008", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0274", "q": "59.00 वर्ग किमी.\n61.72 वर्ग किमी.\n12.00 वर्ग किमी.\n3.93 वर्ग किमी.\n0.00 वर्ग किमी.\n12.78 वर्ग किमी.\n2.91 वर्ग किमी.\n0.00 वर्ग किमी.\nराष्ट्रीय दूर संवदे न अभिकरण (NRSA) के अनुसार‚ निम्न में से किस राज्य में कुल क्षेत्रफल का सर्वाधिक प्रतिशत वनाच्छादित है?", "options": ["हिमाचल प्रदेश", "अरुणाचल प्रदेश", "मेघालय", "सिक्किम"], "answer": 1, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2004", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0275", "q": "निम्नलिखित राज्य समूहों में से किसमें वन कुल भौगोलिक क्षेत्र के 75 प्रतिशत से अधिक क्षेत्र पर आच्छादित हैं", "options": ["अरुणाचल प्रदेश‚ असम‚ नगालैंड", "अरुणाचल प्रदेश‚ मणिपुर‚ नगालैंड", "असम‚ मेघालय‚ नगालैंड", "अरुणाचल प्रदेश‚ नगालैंड"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 1995", "lang": "hi", "test_no": 11, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0276", "q": "किस राज्य का 80 प्रतिशत से अधिक क्षेत्र वनाच्छादित है?", "options": ["अरुणाचल प्रदेश", "केरल", "मध्य प्रदेश", "पश्चिम बंगाल"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Spl.) (Mains) 2008", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0277", "q": "‘इंडिया स्टेट ऑफ फॉरेस्ट रिपोर्ट‚ 2021’ के अनुसार‚ कितने राज्यों/ केंद्रशासित प्रदेशों में उनके भौगोलिक क्षेत्र का 33% से अधिक क्षेत्रफल वन आच्छादित है?", "options": ["07", "13", "17", "23"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Mains) 2021", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0278", "q": "भारत में मैंग्रोव का दूसरा सबसे बड़ा क्षेत्र पाया जाता है", "options": ["अंडमान एवं निकोबार तट के सहारे", "आंध्र प्रदेश तट के सहारे", "गुजरात तट के सहारे", "उड़ीसा तट के सहारे"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2008", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0279", "q": "रिक्त स्थान में उचित चयन को भरें 2011 में उ.प्र. का अभिलिखित (रिकॉडड) वन क्षेत्र अपने कुल क्षेत्रफल का लगभग ........ था।", "options": ["3%", "5%", "7%", "9%"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2012", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0280", "q": "भारत की सबसे बड़ी मछली है", "options": ["स्टोन फिश", "व्हेल शाक", "मार्लिन", "हिलसा"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Spl.) (Pre) 2008", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0281", "q": "पगमाक तकनीक का प्रयोग किया जाता है", "options": ["वनों में पक्षी का अवलोकन करने में।", "दुर्लभ वन्य जंतु के बद्ध स्थल में प्रजनन के लिए।", "विभिन्न वन्य जंतुओं की जनसंख्या के आकलन के लिए।", "वन्य जंतुओं में गुदना गोदने के लिए‚ ताकि एक स्पीशीज का दूसरे से भेद किया जा सके।"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2008", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0282", "q": "निम्नलिखित राज्यों में से किसके द्वारा ‘अपना वन अपना धन’ योजना प्रारंभ की गई है?", "options": ["उत्तर प्रदेश द्वारा", "मध्य प्रदेश द्वारा", "हिमाचल प्रदेश द्वारा", "अरुणाचल प्रदेश द्वारा"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2012", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0283", "q": "सूची-I को सूची-II से सुमेलित कीजिए तथा नीचे दिए गए कूट का\nप्रयोग करके सही उत्तर का चयन कीजिएसूची-I\nसूची-II\n(भारतवर्ष में अधिनियमों के नाम) (वर्ष)\nA. वन संरक्षण अधिनियम\n1. 1980\nB. पर्यावरण संरक्षण\n2. 1986\nअधिनियम\nC. वायु (प्रदूषण निवारण\n3. 1981\nएवं नियंत्रण) अधिनियम\nD. जल प्रदूषण नियंत्रण अधिनियम\nकूट A", "options": ["3", "1", "4", "1 B 1 4 3 2 C 4 2 2 3 4. 1974 D 2 3 1 4"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2021", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0284", "q": "2016 में कार्यान्वित नवीन राष्ट्रीय वन सूची डिजाइन के अंतर्गत वन\nसूची समीक्षा का समय घटाकर किया गया है–", "options": ["5 वर्ष", "2 वर्ष", "6 माह", "10 वर्ष"], "answer": 0, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Mains) 2017", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0285", "q": "भारत में‚ निम्नलिखित में से कौन-सा अधिनियम वन्य जीवों को संरक्षण प्रदान करता है?", "options": ["वन्यजीव संरक्षण अधिनियम‚ 1972", "वन संरक्षण अधिनियम‚ 1982", "पर्यावरण संरक्षण अधिनियम‚ 1996", "पश्चिम बंगाल वन्यजीव संरक्षण अधिनियम‚ 1959 पर्यावरण एवं प"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2016", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0286", "q": "भारत में वन संरक्षण अधिनियम कब पारित किया गया?", "options": ["1978", "1979", "1980", "1981"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2013", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0287", "q": "वन अनुसंधान संस्थान स्थापित है", "options": ["हैदराबाद में", "नैनीताल में", "सोलन में", "देहरादून में"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Spl.) (Mains) 2008", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0288", "q": "वन अनुसंधान संस्थान स्थित है", "options": ["देहरादून में", "भोपाल में", "नई दिल्ली में", "नागपुर में"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Re-Exam) 2016", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0289", "q": "‘चिपको’ आंदोलन मूल रूप से किसके विरुद्ध था?", "options": ["जल प्रदूषण के", "ध्वनि प्रदूषण के", "वन कटाई के", "सांस्कृतिक प्रदूषण के"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2003 | U.P.P.C.S. (Pre) 2012", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0290", "q": "राजीव गांधी वन्यजीव संरक्षण पुरस्कार दिया जाता है", "options": ["शैक्षिक तथा शोध संस्थाओं को", "वन एवं वन्यजीव अधिकारियों को", "वन्यजीव संरक्षकों को", "उपर्युक्त सभी को"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 1998", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0291", "q": "‘नेशनल ब्यूरो ऑफ प्लांट जेनेटिक रिसोसस’ स्थित है–", "options": ["नई दिल्ली में", "कोलकाता में", "मुंबई में", "चेन्नई में"], "answer": 0, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Mains) 2013", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0292", "q": "निम्नलिखित में से कौन-सा एक वन्यप्राणियों के विलुप्तीकरण का प्रमुख कारण नहीं है?", "options": ["प्राकृतिक आवास का नष्ट होना", "जंगलों में आग लगा देना", "वन्यप्राणियों का अवैध वाणिज्यिक व्यापार", "जनसंख्या की तीव्र वृद्धि"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2020", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0293", "q": "वर्ल्ड वाइल्डलाइफ फंड (W.W.F.) का प्रतीक कौन जानवर है?", "options": ["शेर", "जाइन्ट पांडा", "हार्नबल", "सफेद भालू"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2001 | U.P. Lower Sub. (Spl.) (Pre) 2002 | U.P. Lower Sub. (Spl.) (Pre) 2003", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0294", "q": "किस देश में उसके भौगोलिक क्षेत्र का उच्चतम प्रतिशत वनाच्छादित है?", "options": ["चीन", "भारत", "इंडोनेशिया", "जापान"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2013", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0295", "q": "निम्नलिखित देशों में से किसमें कुल भौगोलिक क्षेत्रफल के 60 प्रतिशत भाग पर वन बनाए रखने का संवैधानिक प्रावधान है?", "options": ["मालदीव", "नेपाल", "भूटान", "अफगानिस्तान"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2016", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0296", "q": "किस देश में कुल का सर्वाधिक प्रतिशत वनाच्छादित है?", "options": ["जापान", "इंडोनेशिया", "सूरीनाम", "गुयाना"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2009", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0297", "q": "माइक्रोनेशिया फेडरेटेड स्टेटस सेशेल्स\n92.2%\nतुवालू पलाऊ गैबन सोलोमन द्वीपसमूह मोजाम्बिक स्वीडन गिनी-बिसाऊ बेलिज लाओ पीडीआर गुयाना फिनलैंड जापान इंडोनेशिया\n33.3%\n73.3%\n90.5%\n91.2%\n90.1 %\n45.8 %\n68.7%\n69.5%\n54.5%\n71.5%\n87.1%\n73.7%\n68.4%\n47.7%\nविश्व बाघ शिखर सम्मेलन‚ 2010 आयोजित किया गया था", "options": ["बैंकॉक में", "नैरोबी में", "नई दिल्ली में", "पीटर्सबर्ग में"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2011", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0298", "q": "राष्ट्रीय वनीकरण एवं पारिस्थितिक विकास बोर्ड (NAEB) की स्थापना भारत सरकार द्वारा की गई थी", "options": ["1987 में", "1992 में", "1995 में", "1998 में"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2017", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0299", "q": "निम्नलिखित में से कौन-सा भारत में स्थापित प्रथम राष्ट्रीय उद्यान है?", "options": ["चंदोली राष्ट्रीय उद्यान", "जिम काबट राष्ट्रीय उद्यान", "गिर वन राष्ट्रीय उद्यान", "दुधवा राष्ट्रीय उद्यान"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2017", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0300", "q": "राजीव गांधी नेशनल पाक अवस्थित है", "options": ["आंध्र प्रदेश में", "राजस्थान में", "मध्य प्रदेश में", "कर्नाटक में"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2002 | U.P.P.C.S. (Pre) 2002", "lang": "hi", "test_no": 12, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0301", "q": "निम्नलिखित अभयारण्यों में से कौन उल्लिखित संरक्षित प्रजातियों से सुमेलित नहीें है?", "options": ["जिम काबट-बाघ", "घाना-शेर", "काज़ीरंगा-गैंडा", "पेरियार-हाथी"], "answer": 1, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2009", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0302", "q": "दाचीगाम राष्ट्रीय उद्यान निम्नलिखित में से किससे संबंधित है?", "options": ["कस्तूरी मृग", "गोल्डेन ओरियोल", "येलो-थ्रोटेड मार्टन", "हंगुल या कश्मीर स्टैग"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre), 2018", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0303", "q": "गैंडे को पुनर्वासित करने का कार्य निम्नलिखित में से किस राष्ट्रीय उद्यान में चल रहा है?", "options": ["काबट राष्ट्रीय उद्यान", "दुधवा राष्ट्रीय उद्यान", "कान्हा राष्ट्रीय उद्यान", "काजीरंगा राष्ट्रीय उद्यान"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Spl.) (Mains) 2004", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0304", "q": "दुधवा राष्ट्रीय उद्यान उत्तर प्रदेश के निम्नलिखित में से किस जनपद में अवस्थित है?", "options": ["लखीमपुर खीरी", "सीतापुर", "बहराइच", "पीलीभीत"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2022", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0305", "q": "निम्नलिखित राज्यों में से उस राज्य को चुनिए जिसमें सर्वाधिक संख्या में राष्ट्रीय उद्यान हैं", "options": ["उत्तर प्रदेश", "राजस्थान", "मध्य प्रदेश", "प. बंगाल U.P. Lower Sub. (Pre) 2004 पर्यावरण एवं प"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2008", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0306", "q": "निम्नलिखित में से कौन सही सुमेलित नहीं है? राज्य राष्ट्रीय उद्यान", "options": ["बांदीपुर कर्नाटक", "राजाजी उत्तराखंड", "सिमिलीपाल ओडिशा", "पिन वैली जम्मू और कश्मीर"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2016", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0307", "q": "निम्नलिखित में से कौन-सा एक बस्तर क्षेत्र में अवस्थित है?", "options": ["बांधवगढ़ राष्ट्रीय उद्यान", "दांडेली अभयारण्य", "राजाजी राष्ट्रीय उद्यान", "इंद्रावती राष्ट्रीय उद्यान"], "answer": 3, "explanation": "", "topic": "", "source": "I.A.S. (Pre) 2007 | U.P. Lower Sub. (Pre) 2015", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0308", "q": "निम्नलिखित में से कौन-सा युग्म सही सुमेलित है?", "options": ["महान हिमालयी राष्ट्रीय उद्यान मनाली", "राजाजी राष्ट्रीय उद्यान देहरादून", "केवलादेव राष्ट्रीय उद्यान भरतपुर", "वन विहार राष्ट्रीय उद्यान जबलपुर"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2009", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0309", "q": "यलोस्टोन नेशनल पाक अवस्थित है", "options": ["कनाडा में", "कोलंबिया में", "केन्या में", "संयुक्त राज्य अमेरिका में"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Spl.) (Mains) 2004 | Uttarakhand P.C.S. (Pre) 2005, 2006 | U.P.P.S.C. (GIC) 2010 | U.P.P.C.S. (Mains) 2011", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0310", "q": "निम्न में से कौन-सा सागरीय राष्ट्रीय उद्यान है?", "options": ["भितरकनिका", "सुंदरबन", "गहीरमाथा", "मन्नार की खाड़ी"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) (Re Exam.) 2015", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0311", "q": "बुक्सा बाघ परियोजना भारत के किस राज्य में स्थित है?", "options": ["मध्य प्रदेश", "राजस्थान", "गुजरात", "पश्चिम बंगाल"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2003", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0312", "q": "भारत का राष्ट्रीय जैविक उद्यान स्थित है", "options": ["मुंबई में", "लखनऊ में", "नई दिल्ली में", "बंगलुरू में"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Mains) 2014", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0313", "q": "निम्न कथनों का परीक्षण करें तथा कूट से सही उत्तर ज्ञात करें1. सिमिलीपाल राष्ट्रीय उद्यान उड़ीसा राज्य में अवस्थित है।\n2. थाईलैंड को पुराने समय में स्याम नाम से जाना जाता था।\n3. अष्टदिग्गज शिवाजी के दरबार की शोभा बढ़ाते थे।\n4. ‘अष्टछाप’ भक्तों का एक समूह था‚ जो आदिशंकर के शिष्य थे।\nकूट :", "options": ["1 व 2", "2 व 3", "3 व 4", "सभी चारों"], "answer": 0, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2002", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0314", "q": "निम्नलिखित युग्मों में कौन सही सुमेलित नहीं है?", "options": ["बांदीपुर राष्ट्रीय उद्यान - कर्नाटक", "मानस वन्यजीव अभयारण्य - असम", "पेरियार वन्यजीव अभयारण्य - केरल", "सिमिलीपाल राष्ट्रीय उद्यान - मध्य प्रदेश"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2018", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0315", "q": "सूची-I तथा सूची-II को सुमेलित कीजिए तथा नीचे दिए गए कूट\nसे सही उत्तर चुनिएसूची-I\nसूची-II\n(राज्य) (राष्ट्रीय उद्यान)\nA. उत्तराखंड\n1. बांदीपुर\nB. असम\n2. राजाजी राष्ट्रीय उद्यान\nC. ओडिशा\n3. सिमिलीपाल\nD. कर्नाटक\n4. मानस\nकूट :", "options": ["A-1, B-2, C-3, D-4", "A-2, B-4, C-3, D-1", "A-4, B-3, C-2, D-1", "A-2, B-3, C-1, D-4"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 1998", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0316", "q": "मध्य प्रदेश असम\nसूची-I को सूची-II के साथ सुमेलित कीजिए तथा सूचियों के नीचे\nदिए गए कूट का प्रयोग करते हुए सही उत्तर का चयन कीजिएसूची-II\nसूची-I\nराष्ट्रीय पाक राज्य/केंद्रशासित प्रदेश\n(A) दाचीगाम\n1. आंध्र प्रदेश\n(B) पापीकोंडा\n2. जम्मू एवं कश्मीर\n(C) सरिस्का\n3. राजस्थान\n(D) बांदीपुर\n4. कर्नाटक\nकूट :\nA\nB\nC\nD", "options": ["3 1 2 4", "2 1 3 4", "1 2 4 3", "3 4 2 1"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2015", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0317", "q": "राष्ट्रीय उद्यान राज्य काजीरंगा राष्ट्रीय उद्यान असम कॉबट राष्ट्रीय उद्यान उत्तराखंड बांदीपुर राष्ट्रीय उद्यान कर्नाटक संजय राष्ट्रीय उद्यान मध्य प्रदेश निम्नलिखित राष्ट्रीय उद्यानों को सर्व प्र थम से सबसे बाद के कालक्रमानुसार व्यवस्थित कीजिए और पाक के नीचे दिए गए कूट से\nसही उत्तर चुनिए1. साइलेंट वैली\n2. जिम कॉबट\n3. काजीरंगा\n4. कान्हा\nकूट :", "options": ["1, 3, 2, 4", "4, 2, 1, 3", "3, 1, 4, 2", "2, 4, 3, 1"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Pre) 2016", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0318", "q": "राष्ट्रीय उद्यान स्थापना वर्ष जिम कॉबट कान्हा काजीरंगा साइलेंट वैली 1936 1955 1974 1984 निम्नलिखित में से कौन छत्तीसगढ़ में स्थित है?", "options": ["अंशी राष्ट्रीय उद्यान", "बेतला राष्ट्रीय उद्यान", "इंद्रावती राष्ट्रीय उद्यान", "गूगामल राष्ट्रीय उद्यान"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Pre) 2016", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0319", "q": "मुख्य संरक्षित वन्य पशु काजीरंगा गैंडा गिर शेर सुंदरबन पेरियार बाघ हाथी निम्नलिखित में से कौन एक सही सुमेलित नहीं है?", "options": ["राजाजी राष्ट्रीय उद्यान : हाथी", "पेरियार राष्ट्रीय उद्यान : हंगुल", "मानस राष्ट्रीय उद्यान : हाथी", "दुधवा राष्ट्रीय उद्यान : टाइगर"], "answer": 1, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Pre) 2014", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0320", "q": "केइबुल लामजाओ राष्ट्रीय उद्यान निम्नलिखित में से किस झील में अवस्थित है?", "options": ["डल", "कोलेरू", "लोकटक", "वूलर"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Pre) 2022", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0321", "q": "धूपगढ़ चोटी निम्नलिखित राष्ट्रीय उद्यानों में किसमें स्थित है?", "options": ["सतपुड़ा राष्ट्रीय उद्यान", "कान्हा राष्ट्रीय उद्यान", "बांधवगढ़ राष्ट्रीय उद्यान", "माधव राष्ट्रीय उद्यान"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2021", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0322", "q": "निम्नलिखित युग्मों (राष्ट्रीय उद्यान - राज्य/संघ-राज्य क्षेत्र) में से कौन-सा सही सुमिे लत नहीं है?", "options": ["राजाजी — उत्तराखंड", "पिन वैली — जम्मू और कश्मीर", "बांदीपुर — कर्नाटक", "सिमलीपाल — ओडिशा"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2024", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0323", "q": "नीलगिरि की ‘मेघ बकरियां’ पाई जाती हैं", "options": ["इरावीकुलम राष्ट्रीय पाक में", "मन वन में", "पेरियार आरक्षित क्षेत्र में", "शांत घाटी में"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2005", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0324", "q": "निम्नलिखित में से किस देश में उसके कुल क्षेत्रफल का 30 प्रतिशत से अधिक क्षेत्र राष्ट्रीय पाक के अंतर्गत आता है?", "options": ["इस्राइल", "भूटान", "आइसलैंड", "गैबन"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) (Re Exam.) 2015", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0325", "q": "रानी झांसी समुद्री राष्ट्रीय पाक की स्थापना हुई थी", "options": ["1994 में", "1995 में", "1996 में", "1997 में"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2017", "lang": "hi", "test_no": 13, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0326", "q": "भारत का ओशनिक नेशनल पाक स्थित है", "options": ["सुंदरबन", "चिल्का झील", "निकोबार आइलैंड", "कच्छ"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Re-Exam)(Pre) 2016 | U.P.P.C.S. (Mains) (Pre) 2016", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0327", "q": "जैवमंडल आरक्षित परिरक्षण क्षेत्र है", "options": ["घास स्थल के", "कृषि उत्पादन के", "वायुमंडलीय संतुलन के", "आनुवंशिक विभिन्नता के"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Spl.) (Pre) 2004", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0328", "q": "कंचनजंगा, 12. पन्ना तथा 13. कोल्ड डेजर्ट । प्रश्नकाल में कंचनजंगा यूनेस्को सूची में शामिल नहीं था। वर्ष 2018, 2020 तथा 2025 में क्रमश: कंचनजंगा तथा पन्ना तथा कोल्ड डेजर्ट को यूनेस्को कीAविश्व nविरासत p @ में शामिल किया गया है। पारिस्थितिकी\n3. निम्नलिखित में से कौन एक यूनेस्को के जैवमंडल निचय की सूची में\nनहीं है?", "options": ["सुंदरबन", "मन्नार की खाड़ी", "कच्छ का रण", "नीलगिरि"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2009", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0329", "q": "निम्नलिखित में से कौन एक ‘विश्व धरोहर स्थल’ (वर्ल्ड हेरिटेज साइट) घोषित है?", "options": ["नंदा देवी नेशनल पाक", "काबट राष्ट्रीय पाक", "राजाजी राष्ट्रीय पाक", "गिर वन"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2005 | U.P.P.C.S. (Pre) 2008", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0330", "q": "निम्नलिखित युग्मों में से कौन-सा एक सही सुमेलित है?", "options": ["बायोस्फीयर रिजर्व - एडवर्ड सुएस", "इकोसिस्टम - ए.पी.डी. कंडोल", "इकोलॉजी -ए.जी. टांसले", "जैव विविधता - रीटर"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2013", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0331", "q": "सूची-I को सूची-II से सुमेलित कीजिए तथा सूचियों के नीचे दिए\nगए कूट से सही उत्तर का चयन कीजिएसूची-I\nसूची-II\n(जैवमंडल स्थल) (स्थापना वर्ष)\nA. नीलगिरि\n1. 2000\nB. नंदा देवी\n2. 1989\nC. सुंदरबन\n3. 1988\nD. कंचनजंगा\n4. 1986\nकूट :\nA\nB\nC\nD", "options": ["1 2 3 4", "4 3 2 1", "3 4 1 2", "2 3 1 4"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2012", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0332", "q": "निम्नलिखित में से कौन-सा/से युग्म सही सुमेलित नहीं है/हैं? (बायोस्फीयर रिजर्व) (राज्य)\n1. नोकरेक\n– मणिपुर\n2. मानस\n– असम\n3. अगस्त्यमलाई\n– केरल\nनीचे दिए गए कूट से सही उत्तर चुनिए :\nकूट :", "options": ["1 और 2", "केवल 3", "2 और 3", "केवल 1"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Pre) 2025", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0333", "q": "सूची-I को सूची-II में सुमेलित कीजिए और नीचे दिए गए कूट का\nप्रयोग कर सही उत्तर चुनिए :\nसूची-I\nसूची-II\n(जीवमंडल आरक्षित (अवस्थिति राज्य) क्षेत्र का नाम)\nA. मानस i. मेघालय\nB. सिमिलीपाल ii. केरल\nC. अगस्त्यमलाई iii. ओडिशा\nD. नोकरेक iv. असम पर्यावरण एवं प\nकूट :", "options": ["A-ii, B-iii, C-iv, D-i", "A-i, B-ii, C-iii, D-iv", "A-iv, B-iii, C-ii, D-i", "A-iv, B-ii, C-iii, D-i"], "answer": 2, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Re-Exam) (Pre) 2023", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0334", "q": "निम्नलिखित युग्मों में से कौन-सा सही सुमेलित नहीं है? जैवमंडल आगार अवस्थिति", "options": ["मानस : मेघालय", "नंदा देवी : उत्तराखंड", "कंचनजंगा : सिक्किम", "अगस्त्यमलाई : केरल"], "answer": 0, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Mains) 2013", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0335", "q": "सूची-I को सूची-II से सुमेलित कीजिए तथा सूचियों के अंत में दिए\nकूटों से सही उत्तर चुनिएसूची-I\nसूची-II\n(जैवमंडल आरक्षित क्षेत्र) (राज्य)\nA. सिमिलीपाल\n1. हिमाचल प्रदेश\nB. दिहांग-दिबांग\n2. उत्तराखंड\nC. नोकरेक\n3. अरुणाचल प्रदेश\nD. कोल्ड डेज़र्ट\n4. ओडिशा\n5. मेघालय\nकूट :\nA", "options": ["1", "1", "4 B 3 5 5 C 5 2 2 D 4 4 1", "4 3 5 1"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Pre) 2016", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0336", "q": "सूची-I को सूची-II से सुमेलित कीजिए तथा सूचियों के नीचे दिए\nगए कूट से सही उत्तर का चयन कीजिए।\nसूची-II\nसूची-I\n(जैवमंडल) (अवस्थिति)\nA. सिमिलीपाल\n1. उत्तराखंड\nB. पंचमढ़ी\n2. मेघालय\nनंदादेवी\nD. नोकरेक\nकूट :\nC. मध्य प्रदेश ओडिशा\n3. 4.\nA\nB\nC\nD", "options": ["4 3 2 1", "4 3 1 2", "1 3 4 2", "3 4 1 2"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2021", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0337", "q": "भारत के निम्नलिखित जैव भंडारों में से कौन गारो पहाड़ियों पर फैला हुआ है?", "options": ["नोकरेक", "अगस्त्यमलाई", "दिहांग-दिबांग", "नंदा देवी"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.S.C. (R.I.) 2014", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0338", "q": "निम्नलिखित में से कौन एक यूनेस्को द्वारा प्रमाणित (क्षेत्रफल की दृष्टि से) भारत की वृहत्तम जैवमंडलीय आगार है?", "options": ["नीलगिरि", "नंदा देवी", "सुंदरबन", "मन्नार की खाड़ी"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Mains) 2013", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0339", "q": "भारत का सोलहवां जैवमंडल आरक्षित क्षेत्र ‘शीत मरुस्थल’ स्थित है", "options": ["अरुणाचल प्रदेश में", "हिमाचल प्रदेश में", "जम्मू एवं कश्मीर में", "उत्तराखंड में"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2010", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0340", "q": "पेरियार गेम अभयारण्य प्रसिद्ध है", "options": ["शेरों के लिए", "चित्तीदार हिरणों के लिए", "बाघों के लिए", "जंगली हाथियों के लिए"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2011", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0341", "q": "निम्नलिखित में से कौन-सा युग्म सही सुमेलित है?", "options": ["सिमिलीपाल असम", "नोकरेक मेघालय", "दिहांग-दिबांग in ट@ Joकर्ना", "अगस्त्यमलाई क पारिस्थितिकी"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2007", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0342", "q": "जंगली गदहों का अभयारण्य कहां है?", "options": ["यू.पी. में", "असम में", "गुजरात में", "राजस्थान में"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2010", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0343", "q": "काजीरंगा किसलिए जाना जाता है?", "options": ["गैंडा के लिए", "बाघ के लिए", "पक्षी के लिए", "शेर के लिए"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2012 | Jharkhand P.C.S. (Pre) 2013", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0344", "q": "सूची-I को सूची-II के साथ सुमेल कीजिए और सूचियों के नीचे दिए\nगए कूट का प्रयोग करते हुए सही उत्तर का चयन कीजिए :\nसूची-I (अभयारण्य)\nसूची-II (राज्य)\nA. गरम पानी\n1. आंध्र प्रदेश\nB. नामदफा\n2. अरुणाचल प्रदेश\nC. पाखल\n3. असम\nD. सरिस्का\n4. राजस्थान\nकूट :\nA\nB\nC\nD", "options": ["2 3 1 4", "4 3 1 2", "1 2 4 3", "3 2 1 4"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2003", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0345", "q": "सूची-I को सूची-II से सुमेलित कीजिए और नीचे दिए गए कूट से\nसही उत्तर चुनिए :\nसूची-I\nसूची-II\n(पाक तथा वन्यजीव अभयारण्य) (राज्य)\nA. दाचीगाम वन्यजीव अभयारण्य 1. मध्य प्रदेश\nB. केवलादेव घाना पक्षी\n2. राजस्थान\nअभयारण्य\nC. कान्हा राष्ट्रीय पाक\n3. केरल\nD. पेरियार वन्यजीव अभयारण्य 4. जम्मू एवं कश्मीर\nकूट :\nA", "options": ["4", "1 B 2 3 C 1 2 D 3 4", "2 1 4 3", "3 4 2 1"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2014", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0346", "q": "शुक्लाफांटा वन्यजीव अभयारण्य स्थित है–", "options": ["नेपाल में", "म्यांमार में", "भूटान में", "श्रीलंका में"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2016", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0347", "q": "राष्ट्रीय चंबल अभयारण्य निम्नलिखित में से किस राज्य का हिस्सा नहीं है?", "options": ["उत्तर प्रदेश", "मध्य प्रदेश", "हरियाणा", "राजस्थान"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2020", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0348", "q": "‘अंतरराष्ट्रीय टाइगर दिवस’ मनाया जाता है", "options": ["24 जुलाई को", "29 जुलाई को", "20 जुलाई को", "25 जुलाई को"], "answer": 1, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Mains) 2014", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0349", "q": "सरकार की ‘बाघ परियोजना’ का उद्देश्य है", "options": ["बाघ की आदतों का अध्ययन", "विभिन्न प्रजातियों के संबंध में महत्वपूर्ण जानकारी एकत्र करना", "भारतीय बाघ को समाप्त होने से बचाना", "इनमें से कोई नहीं"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 1994", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0350", "q": "भारत में ‘प्रोजेक्ट टाइगर’ प्रारंभ किया गया था", "options": ["1970 में", "1973 में", "1981 में", "1984 में"], "answer": 1, "explanation": "", "topic": "", "source": "M.P.P.C.S. (Pre) 2008 | U.P.P.C.S. (Pre) 2002", "lang": "hi", "test_no": 14, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0351", "q": "भारत में सबसे बड़ा बाघ आवास पाया जाता है", "options": ["आंध्र प्रदेश में", "कर्नाटक में", "मध्य प्रदेश में", "उत्तर प्रदेश में"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2011", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0352", "q": "भारत के निम्न टाइगर रिजर्व में से कौन-सा मिज़ोरम में अवस्थित है?", "options": ["मेलघाट", "बुक्सा", "दम्पा", "भद्रा"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2012", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0353", "q": "निम्नलिखित में से कौन-सा युग्म सुमेलित नहीं है? राज्य बाघ आरक्षित क्षेत्र", "options": ["बुक्सा बिहार", "दम्फा मिजोरम", "नमेरी असम", "नामदफा - अरुणाचल प्रदेश"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2010", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0354", "q": "निम्नलिखित में से कौन-सा बाघ आरक्षित क्षेत्र दो राज्यों में विस्तृत है?", "options": ["कान्हा", "मानस", "पेंच", "सरिस्का"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Spl.) (Mains) 2008", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0355", "q": "निम्नलिखित बाघ अभयारण्य (टाइगर रिजर्व) में से कौन-सा मध्य प्रदेश में स्थित नहीं है?", "options": ["अमनगढ़", "बांधवगढ़", "कान्हा", "संजय-दुबरी"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Mains) 2021", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0356", "q": "बाघों का प्रमुख रिजर्व ‘सरिस्का’ किस राज्य में अवस्थित है?", "options": ["उत्तर प्रदेश", "राजस्थान", "उत्तराखंड", "मध्य प्रदेश"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2012", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0357", "q": "निम्नलिखित में से किसे हाल ही में ‘टाइगर रिजर्व’ घोषित किया गया है?", "options": ["बालपकरम राष्ट्रीय पाक", "राजाजी राष्ट्रीय पाक", "बेतला राष्ट्रीय पाक", "काजीरंगा राष्ट्रीय पाक"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2015", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0358", "q": "भारत सरकार द्वारा जुलाई‚ 2020 में बाघों की गणना 2018 पर जारी विस्तृत प्रतिवेदन के संदर्भ में निम्नलिखित कथन/कथनों में से कौनसा/से सही है/हैं?\n1. भारत में विश्व की कुल बाघों की आबादी का 70% है।\nभारत के लगभग 30% बाघ‚ बाघ अभयारण्यों के बाहर रहते हैं।\nनीचे दिए गए कूट से सही उत्तर चुनिए\nकूट :", "options": ["केवल 1", "केवल 2", "1 और 2 दोनों", "न तो 1 न ही 2 2."], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2020", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0359", "q": "निम्नलिखित में से किस राष्ट्रीय उद्यान ने वन्यजीव प्रबंधन के लिए ड्रोन या मानवरहित हवाई वाहन का उपयोग करना प्रारंभ कर दिया है?", "options": ["बांदीपुर टाइगर रिजर्व", "काबट टाइगर रिजर्व", "रणथम्भौर टाइगर रिजर्व", "पेरियार टाइगर रिजर्व"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2014", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0360", "q": "सूची-I एवं सूची-II को सुमेलित कीजिए और सूचियों के नीचे दिए\nगए कूट से सही उत्तर का चुनिएसूची-I\nसूची-II\n(बाघ आरक्षित क्षेत्र) (राज्य)\nA. बांदीपुर\n1. पश्चिम बंगाल\nB. मेलघाट\n2. कर्नाटक\nC. बुक्सा\n3. अरुणाचल प्रदेश\nD. पाखुई (पक्के)\n4. महाराष्ट्र\nकूट :\nA\nB\nC\nD", "options": ["3 4 2 1", "2 4 1 3", "2 3 1", "1 2 4 अध्ययन pdfs Apna @ n i o J 4 3"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2008", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0361", "q": "बाघ आरक्षित क्षेत्र राज्य बांदीपुर कर्नाटक मेलघाट महाराष्ट्र बुक्सा पश्चिम बंगाल पाखुई (पक्के) अरुणाचल प्रदेश निम्नलिखित युग्मों में से कौन सुमेलित नहीं है?", "options": ["बांदीपुर राष्ट्रीय उद्यान - कर्नाटक", "मानस वन्यजीव अभयारण्य - असम", "पेरियार वन्यजीव अभयारण्य - केरल", "सिमिलीपाल राष्ट्रीय उद्यान - मध्य प्रदेश"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2009", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0362", "q": "यूनेस्को ने जुलाई‚ 2016 में भारत के निम्नलिखित किस राष्ट्रीय उद्यान को विश्व धरोहर स्थल घोषित किया?", "options": ["काजीरंगा राष्ट्रीय उद्यान", "कंचनजंगा (खांगचेंग जोंगा) राष्ट्रीय उद्यान", "काबट राष्ट्रीय उद्यान", "फूलों की घाटी राष्ट्रीय उद्यान"], "answer": 1, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Pre) 2016", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0363", "q": "पांच मौसमों का बाग स्थित है", "options": ["डल झील के समीप", "महरौली के समीप", "शांत घाटी के समीप", "ऊटी के समीप"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2009", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0364", "q": "काबट राष्ट्रीय उद्यान अपना जल प्राप्त करता है", "options": ["अलकनंदा नदी से", "रामगंगा नदी से", "धौलीगंगा नदी से", "शारदा नदी से"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2006", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0365", "q": "चिनार वन्यजीव विहार अवस्थित है", "options": ["जम्मू व कश्मीर में", "केरल में", "सिक्किम में", "तमिलनाडु में"], "answer": 1, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2005", "lang": "hi", "test_no": 15, "exam": "uppsc", "subject": "environment", 