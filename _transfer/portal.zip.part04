anation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "note": "भारत का पहला टेलीकॉम मैन्युफैक्चरिंग जोन (TMZ) कहां विकसित करने की घोषणा की गई? → ग्वालियर, मध्य प्रदेश", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0021", "q": "भारत का पहला घरेलू बेंचमार्क-आधारित प्राकृतिक गैस वायदा अनुबंध किस एक्सचेंज पर लॉन्च हुआ?", "options": ["यंत्र इंडिया लिमिटेड (YIL)", "राष्ट्रीय स्टॉक एक्सचेंज (NSE)", "आर्थिक सहयोग और विकास संगठन (OECD)", "ग्लोबल फाइनेंस (न्यूयॉर्क)"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0022", "q": "भारत ने किन उत्पादों के निर्यात पर लगने वाले अप्रत्याशित लाभ करों (Windfall Taxes) को कम किया?", "options": ["माल वाहक द्वारा जारी दस्तावेज", "घरेलू यूरिया विनिर्माण बढ़ाना", "जेब से किया गया स्वास्थ्य खर्च (OOPME)", "पेट्रोल, डीजल और विमानन टरबाइन ईंधन"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0023", "q": "केंद्रीय मंत्रिमंडल ने भारत में मोबाइल फोन निर्माण को बढ़ावा देने के लिए किस योजना को मंजूरी दी?", "options": ["मोबाइल फोन विनिर्माण योजना (MPMS)", "निर्यात संवर्धन मिशन (EPM) के तहत", "जनगणना प्रबंधन एवं निगरानी प्रणाली (CMMS) पोर्टल", "रक्षा, अर्धसैनिक और सरकारी कर्मी"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0024", "q": "इस योजना का कुल बजटीय परिव्यय कितना है?", "options": ["₹88,750 करोड़", "₹48,750 करोड़", "₹55,000 करोड़", "₹62,500 करोड़"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "note": "केंद्रीय मंत्रिमंडल ने भारत में मोबाइल फोन निर्माण को बढ़ावा देने के लिए किस योजना को मंजूरी दी? → मोबाइल फोन विनिर्माण योजना (MPMS)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0025", "q": "MPMS की अवधि कितनी है?", "options": ["आठ वर्ष", "चार वर्ष", "पांच वर्ष", "छह वर्ष"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "note": "केंद्रीय मंत्रिमंडल ने भारत में मोबाइल फोन निर्माण को बढ़ावा देने के लिए किस योजना को मंजूरी दी? → मोबाइल फोन विनिर्माण योजना (MPMS)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0026", "q": "भारतीय रिजर्व बैंक (RBI) का निर्दिष्ट गैरवित्तीय परिसंपत्तियों (SNFA) संबंधी प्रूडेंशियल फ्रेमवर्क कब लागू होगा?", "options": ["1 अक्टूबर, 2025", "1 अक्टूबर, 2026", "1 अगस्त, 2026", "1 नवंबर, 2026"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0027", "q": "कैबिनेट समिति आर्थिक मामलों पर (CCEA) ने 15 जुलाई, 2026 को किस नीति को मंजूरी दी?", "options": ["आत्मनिर्भर भारत के लिए यूरिया-2026 हेतु राष्ट्रीय निवेश नीति (NIPU - 2026)", "आत्मनिर्भर भारत के लिए यूरिया-2031 हेतु राष्ट्रीय निवेश नीति (NIPU - 2026)", "आत्मनिर्भर भारत के लिए यूरिया-2028 हेतु राष्ट्रीय निवेश नीति (NIPU - 2026)", "आत्मनिर्भर भारत के लिए यूरिया-2024 हेतु राष्ट्रीय निवेश नीति (NIPU - 2026)"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0028", "q": "NIPU-2026 का प्रमुख उद्देश्य क्या है?", "options": ["एंड-टू-एंड एन्क्रिप्शन का", "USA > UAE > चीन > नीदरलैंड", "घरेलू यूरिया विनिर्माण बढ़ाना", "अबुल फजल के ‘आइन-ए-अकबरी’ में"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "note": "कैबिनेट समिति आर्थिक मामलों पर (CCEA) ने 15 जुलाई, 2026 को किस नीति को मंजूरी दी? → आत्मनिर्भर भारत के लिए यूरिया-2026 हेतु राष्ट्रीय निवेश नीति (NIPU - 2026)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0029", "q": "भारत सरकार ने किन मूल्य वर्गों के पॉलीमर बैंक नोट लाने के प्रस्ताव को मंज़ूरी दी है?", "options": ["12 रुपये और 20 रुपये के पॉलीमर बैंक नोट", "11 रुपये और 20 रुपये के पॉलीमर बैंक नोट", "10 रुपये और 20 रुपये के पॉलीमर बैंक नोट", "13 रुपये और 20 रुपये के पॉलीमर बैंक नोट"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0030", "q": "भारत ने किस वैश्विक समझौते का 123वां पक्ष बनने की औपचारिकता पूरी की?", "options": ["सिंगापुर", "विश्व व्यापार संगठन (WTO) का मत्स्य पालन सब्सिडी समझौता", "न्यूज़ीलैंड", "भारत"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0031", "q": "भारत-यूरोपीय संघ व्यापार और प्रौद्योगिकी परिषद (TTC) की तीसरी बैठक कहां संपन्न हुई?", "options": ["मुंबई", "सानंद, गुजरात", "पुडुचेरी", "ब्रुसेल्स (बेल्जियम)"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 3, "test_no": 1, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0032", "q": "भारतीय पक्ष से बैठक की सह-अध्यक्षता किसने की?", "options": ["एस. सुब्रमण्येस्वर", "चल्ला श्रीनिवासुलु सेट्टी", "डॉ. जितेंद्र सिंह", "एस. जयशंकर (विदेश मंत्री), पीयूष गोयल (वाणिज्य और उद्योग मंत्री) और जितिन प्रसाद (इलेक्ट्रॉनिक्स एवं सूचना