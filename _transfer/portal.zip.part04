": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0282", "q": "UPI–TIPS लिंकिंग का मुख्य लाभ क्या होगा?", "options": ["भारत और यूरो क्षेत्र के बीच रेमिटेंस को सरल और तेज़ बनाना", "डिस्प्ले असेंबली, लिथियम-आयन सेल और इंडक्टर कॉइल मॉड्यूल", "भारत निवासी और भारत के बाहर निवासी पक्षों वाली सीमा-पार गारंटियां", "पतंजलि आयुर्वेद लिमिटेड तथा अन्य सह-अधिग्रहणकर्ता ट्रस्ट"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "आरबीआई ने सीमा पार भुगतान को बढ़ावा देने के लिए यूपीआई को किसके साथ जोड़ने की घोषणा की? → यूरोसिस्टम की टारगेट इंस्टेंट पेमेंट सेटलमेंट (TIPS) प्रणाली", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0283", "q": "TIPS किस क्षेत्र का एक तत्काल भुगतान प्रणाली है?", "options": ["उपग्रह चित्रों का", "यूरोज़ोन", "सोना और चांदी", "UPI और Fawri+"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "आरबीआई ने सीमा पार भुगतान को बढ़ावा देने के लिए यूपीआई को किसके साथ जोड़ने की घोषणा की? → यूरोसिस्टम की टारगेट इंस्टेंट पेमेंट सेटलमेंट (TIPS) प्रणाली", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0284", "q": "भारत–बहरीन रेमिटेंस साझेदारी किन दो संस्थाओं के बीच है?", "options": ["कृषि और प्रसंस्कृत खाद्य उत्पाद निर्यात विकास प्राधिकरण (APEDA)", "केंद्रीय वित्त एवं कार्पोरेट कार्य मंत्री निर्मला सीतारमण", "एनपीसीआई (NPCI) इंटरनेशनल पेमेंट्स लिमिटेड और बहरीन की बेनिफिट (BENEFIT) कंपनी", "भारतीय बीमा विनियामक और विकास प्राधिकरण (IRDAI)"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0285", "q": "यह साझेदारी किन दो भुगतान प्रणालियों को जोड़ती है?", "options": ["भारत सरकार", "मेरठ बिगुल", "यूरोज़ोन", "UPI और Fawri+"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "भारत–बहरीन रेमिटेंस साझेदारी किन दो संस्थाओं के बीच है? → एनपीसीआई (NPCI) इंटरनेशनल पेमेंट्स लिमिटेड और बहरीन की बेनिफिट (BENEFIT) कंपनी", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0286", "q": "12वां एसबीआई बैंकिंग और इकोनॉमिक्स कॉन्क्लेव का आयोजन कहां हुआ?", "options": ["गांधीनगर", "जयपुर", "हैदराबाद", "मुंबई"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0287", "q": "मेरठ (उत्तर प्रदेश) के किस वस्तु/उत्पाद को जियोग्राफिकल इंडिकेशन (GI) टैग प्राप्त हुआ?", "options": ["नीलम और तोतापुरी", "यूरोज़ोन", "भारत सरकार", "मेरठ बिगुल"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0288", "q": "केंद्रीय मंत्रिमंडल ने किस ऋण योजना को मंजूरी दी है?", "options": ["आयुष्मान भारत प्रधानमंत्री जन आरोग्य योजना", "निर्यात संवर्धन मिशन (EPM) के तहत", "मोबाइल फोन विनिर्माण योजना (MPMS)", "निर्यांतको के लिए ऋण गारंटी योजना (CGSE)"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0289", "q": "इस योजना के तहत सदस्य ऋण संस्थानों को कितने प्रतिशत ऋण गारंटी कवरेज दिया जा सकेगा?", "options": ["100%", "62%", "78%", "70%"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "केंद्रीय मंत्रिमंडल ने किस ऋण योजना को मंजूरी दी है? → निर्यांतको के लिए ऋण गारंटी योजना (CGSE)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0290", "q": "इस योजना से एमएसएमई सहित पात्र निर्यातकों को कितने रुपये तक की अतिरिक्त ऋण सुविधा मिलेगी?", "options": ["15,600 करोड़ (धरोहर मुक्त)", "20,000 करोड़ (धरोहर मुक्त)", "14,000 करोड़ (धरोहर मुक्त)", "25,000 करोड़ (धरोहर मुक्त)"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "केंद्रीय मंत्रिमंडल ने किस ऋण योजना को मंजूरी दी है? → निर्यांतको के लिए ऋण गारंटी योजना (CGSE)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0291", "q": "केंद्रीय मंत्रिमंडल ने निर्यात बढ़ाने के लिए किस मिशन को मंजूरी दी है?", "options": ["कपास उत्पादकता मिशन", "निर्यात संवर्धन मिशन (EPM) के तहत", "एक्सपोर्ट प्रमोशन मिशन (EPM)", "पश्चिम एशिया की स्थिति के मद्देनजर"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0292", "q": "कहां भारत और यूरोपीय संघ (EU) के बीच मुक्त व्यापार समझौते (FTA) संबंधी तकनीकी वार्ताएं आयोजित हुईं?", "options": ["नई दिल्ली", "भोपाल", "कोलकाता", "जयपुर"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0293", "q": "भारत ने स्टील क्षमता लक्ष्य वर्ष 2047 तक कितना रखा है?", "options": ["800 मिलियन टन", "440 मिलियन टन", "710 मिलियन टन", "500 मिलियन टन"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0294", "q": "वर्ष 2030 तक भारत का स्टील क्षमता लक्ष्य कितना है?", "options": ["336 मिलियन टन", "234 मिलियन टन", "264 मिलियन टन", "300 मिलियन टन"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "भारत ने स्टील क्षमता लक्ष्य वर्ष 2047 तक कितना रखा है? → 500 मिलियन टन", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0295", "q": "CII स्टील समिट 2025 कहां हुआ?", "options": ["बेंगलुरु", "चेन्नई", "जयपुर", "नई दिल्ली"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "भारत ने स्टील क्षमता लक्ष्य वर्ष 2047 तक कितना रखा है? → 500 मिलियन टन", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0296", "q": "किसने भारतीय मानक ब्यूरो (BIS) के महानिदेशक का पदभार ग्रहण किया?", "options": ["नीति आयोग", "विश्व बैंक", "संजय गर्ग", "डाक विभाग"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0297", "q": "‘विश्व का सर्वश्ष्ठ रे उपभोक्ता बैंक 2025’ और ‘भारत में सर्वश्ष्ठ रे बैंक 2025’ पुरस्कार किस बैंक ने जीते?", "options": ["DBS बैंक", "स्वयं सहायता समूह बचत खाता", "सेंट्रल बैंकिंग (लंदन)", "भारतीय स्टेट बैंक (SBI)"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0298", "q": "SBI को यह पुरस्कार किस संगठन ने प्रदान किया?", "options": ["राष्ट्रीय स्टॉक एक्सचेंज (NSE)", "भारतीय रिजर्व बैंक", "ग्लोबल फाइनेंस (न्यूयॉर्क)", "प्रधानमंत्री नरेंद्र मोदी"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "‘विश्व का सर्वश्ष्ठ रे उपभोक्ता बैंक 2025’ और ‘भारत में सर्वश्ष्ठ रे बैंक 2025’ पुरस्कार किस बैंक ने जीते? → भारतीय स्टेट बैंक (SBI)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0299", "q": "SBI के अध्यक्ष कौन हैं?", "options": ["चल्ला श्रीनिवासुलु सेट्टी", "डॉ. जितेंद्र सिंह", "सोनाली सेन गुप्ता", "सत्य नाडेला"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "‘विश्व का सर्वश्ष्ठ रे उपभोक्ता बैंक 2025’ और ‘भारत में सर्वश्ष्ठ रे बैंक 2025’ पुरस्कार किस बैंक ने जीते? → भारतीय स्टेट बैंक (SBI)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0300", "q": "‘वी राइज’ पहल किन संगठनों द्वारा शुरू की गई?", "options": ["महिला उद्यमिता मंच (नीति आयोग) और डीपी वर्ल्ड", "शिपिंग कॉरपोरेशन ऑफ इंडिया लिमिटेड", "भारतीय प्रतिभूति और विनिमय बोर्ड (SEBI)", "राष्ट्रीय सांख्यिकी कार्यालय (NSO)"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0301", "q": "‘वी राइज’ पहल का मुख्य लक्ष्य क्या है?", "options": ["राष्ट्रीय क्रेडिट गारंटी ट्रस्टी कंपनी लिमिटेड", "कृषि और प्रसंस्कृत खाद्य उत्पाद निर्यात विकास प्राधिकरण (APEDA)", "महिला उद्यमियों को सशक्त बनाना और वैश्विक व्यापार तक उनकी पहुंच बढ़ाना", "उप-जिला, जिला, राज्य और राष्ट्रीय स्तर के अधिकारी"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "note": "‘वी राइज’ पहल किन संगठनों द्वारा शुरू की गई? → महिला उद्यमिता मंच (नीति आयोग) और डीपी वर्ल्ड", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0302", "q": "अंतरराष्ट्रीय मुद्रा कोष (IMF) के पहले उप प्रबंध निदेशक (Deputy MD) के रूप में किसे नियुक्त किया गया?", "options": ["श्रीनिवास इंजेती", "डॉ. जितेंद्र सिंह", "सुधांशु वत्स", "डैन कैट्ज़"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0303", "q": "भारतीय रिज़र्व बैंक (RBI) ने किसे नया कार्यकारी निदेशक (Executive Director) नियुक्त किया है?", "options": ["सोनाली सेन गुप्ता", "उषा जानकीरमण", "डॉ. जितेंद्र सिंह", "श्रीनिवास इंजेती"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0304", "q": "श्रम एवं रोजगार मंत्रालय (भारत सरकार) के अनुसार भारत में महिला श्रम बल भागीदारी दर वित्त वर्ष 2023–24 में बढ़कर कितनी हो गई?", "options": ["66.7%", "59.2%", "41.7%", "32.5%"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0305", "q": "भारत में वित्त वर्ष 2017–18 में महिला श्रम बल भागीदारी दर कितनी थी?", "options": ["18.2%", "16.3%", "14.4%", "23.3%"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "note": "श्रम एवं रोजगार मंत्रालय (भारत सरकार) के अनुसार भारत में महिला श्रम बल भागीदारी दर वित्त वर्ष 2023–24 में बढ़कर कितनी हो गई? → 41.7%", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0306", "q": "प्रधानमंत्री धन-धान्य कृषि योजना (PM Dhan Dhanya Krishi Yojana) किसने प्रारंभ की?", "options": ["राष्ट्रीय आवास बैंक", "भारतीय रिजर्व बैंक", "प्रधानमंत्री नरेंद्र मोदी", "ग्लोबल फाइनेंस (न्यूयॉर्क)"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0307", "q": "प्रधानमंत्री धन-धान्य कृषि योजना के साथ कौन-सा मिशन प्रारंभ किया गया?", "options": ["ECGC लिमिटेड", "भारत समुद्री बीमा पूल", "पश्चिम एशिया की स्थिति के मद्देनजर", "दलहन में आत्मनिर्भरता मिशन"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "note": "प्रधानमंत्री धन-धान्य कृषि योजना (PM Dhan Dhanya Krishi Yojana) किसने प्रारंभ की? → प्रधानमंत्री नरेंद्र मोदी", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0308", "q": "अप्रैल-सितंबर, 2026 के लिए भारतीय रिजर्व बैंक ने ‘वेज एंड मीन्स एडवांसेज (WMA) की सीमा कितनी निर्धारित की है?", "options": ["2,80,000 करोड़", "1,55,000 करोड़", "250,000 करोड़", "4,00,000 करोड़"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0309", "q": "WMA सीमा को आर.बी.आई. किसके परामर्श से परिवर्तित कर सकती है?", "options": ["भारत सरकार", "वैधानिक अपीलीय निकाय", "नीलम और तोतापुरी", "UPI और Fawri+"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "note": "अप्रैल-सितंबर, 2026 के लिए भारतीय रिजर्व बैंक ने ‘वेज एंड मीन्स एडवांसेज (WMA) की सीमा कितनी निर्धारित की है? → 250,000 करोड़", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0310", "q": "WMA की अधिकतम पुनर्भुगतान अवधि कितनी है?", "options": ["4 माह", "6 माह", "1 माह", "3 माह"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 7, "note": "अप्रैल-सितंबर, 2026 के लिए भारतीय रिजर्व बैंक ने ‘वेज एंड मीन्स एडवांसेज (WMA) की सीमा कितनी निर्धारित की है? → 250,000 करोड़", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0311", "q": "भारत-ईएफटीए व्यापार और आर्थिक भागीदारी समझौता (टीईपीए) कब लागू हुआ?", "options": ["1 अक्टूब