, "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0263", "q": "किस विभाग और बॉम्बे स्टॉक एक्सचेंज के बीच समझौता-ज्ञापन हस्ताक्षरित हुआ?", "options": ["नीति आयोग", "भारतीय रिजर्व बैंक", "डाक विभाग", "विश्व बैंक"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 8, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0264", "q": "इस समझौते का उद्देश्य क्या है?", "options": ["भारतीय राष्ट्रीय भुगतान निगम (NPCI)", "म्यूचुअल फंड निवेशों की पहुंच को बढ़ाना", "शेयरों की बिक्री वाली कंपनी के निवास देश को", "दोहरा कराधान निवारण अभिसमय (DTAC)"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 8, "test_no": 6, "note": "किस विभाग और बॉम्बे स्टॉक एक्सचेंज के बीच समझौता-ज्ञापन हस्ताक्षरित हुआ? → डाक विभाग", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0265", "q": "इस समझौते की अवधि कितनी है?", "options": ["3 वर्ष (12 दिसंबर, 2026 से 11 दिसंबर, 2028)", "3 वर्ष (17 दिसंबर, 2025 से 11 दिसंबर, 2028)", "3 वर्ष (12 फरवरी, 2025 से 11 दिसंबर, 2028)", "3 वर्ष (12 दिसंबर, 2025 से 11 दिसंबर, 2028)"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 8, "test_no": 6, "note": "किस विभाग और बॉम्बे स्टॉक एक्सचेंज के बीच समझौता-ज्ञापन हस्ताक्षरित हुआ? → डाक विभाग", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0266", "q": "भारत और इटली के मध्य किस समझौते पर हस्ताक्षर किए गए?", "options": ["आर्थिक सहयोग के लिए संयुक्त आयोग (JCEC) 22वें सत्र के प्रोटोकॉल", "आर्थिक सहयोग के लिए संयुक्त आयोग (JCEC) 31वें सत्र के प्रोटोकॉल", "आर्थिक सहयोग के लिए संयुक्त आयोग (JCEC) 28वें सत्र के प्रोटोकॉल", "आर्थिक सहयोग के लिए संयुक्त आयोग (JCEC) 15वें सत्र के प्रोटोकॉल"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 8, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0267", "q": "इटली का लक्ष्य वर्ष 2027 तक कितने मूल्य का निर्यात हासिल करना है?", "options": ["546 बिलियन यूरो", "700 बिलियन यूरो", "434 बिलियन यूरो", "994 बिलियन यूरो"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 8, "test_no": 6, "note": "भारत और इटली के मध्य किस समझौते पर हस्ताक्षर किए गए? → आर्थिक सहयोग के लिए संयुक्त आयोग (JCEC) 22वें सत्र के प्रोटोकॉल", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0268", "q": "भारतीय प्रतिभूति और विनिमय बोर्ड (SEBI) ने किसे इं फ् रास्ट्रक्चर इन्वेस्टमें ट ट्रस्ट (InvIT) के रूप में पंजीकरण हेतु प्रारंभिक मंजूरी प्रदान की?", "options": ["रिटेल और फास्ट-मूविंग कंज्यूमर गुड्स (FMCG)", "महत्त्वपूर्ण सूचना अवसंरचना के रूप में", "पेट्रोल, डीजल और विमानन टरबाइन ईंधन", "राजमार्ग इंफ्रा इन्वेस्टमेंट ट्रस्ट (RIIT)"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 8, "test_no": 6, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0269", "q": "RIIT के माध्यम से किस परिसंपत्ति का मुद्रीकरण किया जाएगा?", "options": ["महत्त्वपूर्ण सूचना अवसंरचना के रूप में", "परिचालनरत राष्ट्रीय राजमार्ग परिसंपत्तियां", "उच्च गुणवत्ता वाला केरोसिन तेल", "प्रयोगशाला अनुसंधान को बाजार में बदलना"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 9, "test_no": 6, "note": "भारतीय प्रतिभूति और विनिमय बोर्ड (SEBI) ने किसे इं फ् रास्ट्रक्चर इन्वेस्टमें ट ट्रस्ट (InvIT) के रूप में पंजीकरण हेतु प्रारंभिक मंजूरी प्रदान की? → राजमार्ग इंफ्रा इन्वेस्टमेंट ट्रस्ट (RIIT)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0270", "q": "RIIT के लिए निवेश प्रबंधक कौन है?", "options": ["राजमार्ग इंफ्रा इन्वेस्टमेंट मैनेजर्स प्र