0, "test_no": 26, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-1273", "q": "जनगणना 2011 के अनुसार उत्तर प्रदेश का लिंगानुपात कितना था?", "options": ["898", "929", "912", "943"], "answer": 2, "explanation": "", "topic": "SRS एवं जनगणना", "source": "", "lang": "hi", "page": 80, "test_no": 26, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-1274", "q": "जनगणना 2011 के अनुसार सर्वाधिक लिंगानुपात वाला केंद्रशासित प्रदेश कौन-सा है?", "options": ["लक्षद्वीप (947)", "अंडमान एवं निकोबार (876)", "पुडुचेरी (1037)", "चंडीगढ़ (818)"], "answer": 2, "explanation": "", "topic": "SRS एवं जनगणना", "source": "", "lang": "hi", "page": 80, "test_no": 26, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-1275", "q": "जनगणना 2011 के अनुसार जनसंख्या में दूसरा सबसे बड़ा राज्य कौन-सा है?", "options": ["महाराष्ट्र", "पश्चिम बंगाल", "आंध्र प्रदेश", "बिहार"], "answer": 0, "explanation": "", "topic": "SRS एवं जनगणना", "source": "", "lang": "hi", "page": 80, "test_no": 26, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-1276", "q": "जनगणना 2011 में भारत की औसत वार्षिक घातांक वृद्धि दर कितनी थी?", "options": ["2.15 प्रतिशत", "1.64 प्रतिशत", "1.41 प्रतिशत", "1.97 प्रतिशत"], "answer": 1, "explanation": "", "topic": "SRS एवं जनगणना", "source": "", "lang": "hi", "page": 80, "test_no": 26, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}]PK
␀␀␀␀␀�~w]��K ␀␀:␀␀government-exam-portal/data/questions/world_geography.jsonUT	␀�ak�akux␀␀␀␀␀␀␀␀␀[{"id": "world_geography-0001", "q": "`बिग-बैंग सिद्धान्त' निम्नलिखित के उद्भव की व्याख्या करता हैः", "options": ["स्तनधारी जीव", "हिम युग", "ब्रह्माण्ड", "महासागर"], "answer": 2, "explanation": "वर्तमान समय में ब्रह्माण्ड की उत्पत्ति सम्बन्धी सर्वमान्य सिद्धांत महाविस्फोट सिद्धान्त या बिग बैंग सिद्धांत (Big- Bang Theory) है। यह सिद्धांत ब्रह्माण्ड, आकाशगंगा और सौरमंडल की उत्पत्ति की व्याख्या करता है। इस सिद्धांत का प्रतिपादन जार्ज लैमेंतेयर ने वर्ष 1927 में किया था। बाद में राबर्ट वेगनर ने 1967 में इस सिद्धांत की विस्तृत व्याख्या प्रस्तुत की।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 2016", "lang": "hi", "page": 513, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0002", "q": "`सुपर नोवा’ है–", "options": ["एक ग्रहिका", "एक ब्लैक होल", "एक पुच्छलतारा", "एक मृतप्राय तारा"], "answer": 3, "explanation": "सुपरनोवा एक मृतप्राय तारा होता है। खगोलशास्त्र में सुपरनोवा किसी तारे के भयंकर विस्फोट को कहते हैं। थो डे समय के लिए एक सुपरनोवा तारा इतना चमकीला हो जाता है जितनी सम्पूर्ण आकाशगंगा।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP Lower (Mains) GS 2015", "lang": "hi", "page": 514, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0003", "q": "`ब्लैक होल' की जानकारी सर्वप्रथम दी थी", "options": ["हरमान बाण्डी ने", "मेघनाथ साहा ने", "एस . चन्द्रशेखर ने", "जे . वी . नार्लिकर ने"], "answer": 2, "explanation": "ब्लैक होल (कृष्ण छिद्र) की जानकारी सर्वप्रथम एस. चन्द्रशेखर ने दी थी। ब्लैक होल एक ऐसा खगोलीय क्षेत्र है जिसे दूरबीन से नहीं देखा जा सकता है, इसका गुरुत्वाकर्षण क्षेत्र इतना शक्तिशाली होता है कि प्रकाश भी इसके खिंचाव से बच कर नहीं निकल सकता अर्थात प्रकाश का भी अवशोषण कर लिया जाता है। भारतीय अमेरिकी खगोलविद् सुब्रमण्यम चंद्रशेखर ने `चंद्रशेखर सीमा' (ब्लैक होल) के सिद्धान्त का प्रतिपादन किया था। चन्द्रशेखर सीमा का मान 1.44 सौर द्रव्यमान है। इस द्रव्यमान से कम द्रव्यमान वाले तारे मृत होकर श्वेत वामन (ह्वाइट ड्वार्प) बन जाते हैं। इस सिद्धान्त के अनुसार श्वेत वामन ( सफेद बौने ) तारे एक निश्चित द्रव्यमान प्राप्त करने के बाद अपने भार में और आधक वृद्धि नहीं कर सकते और अंततः वे काला वामन में परिवर्तित हो जाते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) GS 2011, 2015", "lang": "hi", "page": 514, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0004", "q": "कथन\n(A) कृष्ण छिद्र एक ऐसा खगोलीय आस्तत्व है जिसे दूरबीन से देखा नहीं जा सकता।\nकारण (R) कृष्ण छिद्र पर गुरुत्वीय क्षेत्र इतना प्रबल होता है कि यह प्रकाश को भी बच निकलने नहीं देती।\nनीचे दिए कूट का प्रयोग करके सही उत्तर का चयन कीजिए\nकूटः", "options": ["A तथा R दोनों सही हैं तथा R, A की सही व्याख्या है", "A तथा R दोनों सही हैं किन्तु R, A की सही व्याख्या है", "A सही है किन्तु R गलत है", "A गलत है किन्तु R सही है"], "answer": 0, "explanation": "ब्लैक होल (कृष्ण छिद्र) की जानकारी सर्वप्रथम एस. चन्द्रशेखर ने दी थी। ब्लैक होल एक ऐसा खगोलीय क्षेत्र है जिसे दूरबीन से नहीं देखा जा सकता है, इसका गुरुत्वाकर्षण क्षेत्र इतना शक्तिशाली होता है कि प्रकाश भी इसके खिंचाव से बच कर नहीं निकल सकता अर्थात प्रकाश का भी अवशोषण कर लिया जाता है। भारतीय अमेरिकी खगोलविद् सुब्रमण्यम चंद्रशेखर ने `चंद्रशेखर सीमा' (ब्लैक होल) के सिद्धान्त का प्रतिपादन किया था। चन्द्रशेखर सीमा का मान 1.44 सौर द्रव्यमान है। इस द्रव्यमान से कम द्रव्यमान वाले तारे मृत होकर श्वेत वामन (ह्वाइट ड्वार्प) बन जाते हैं। इस सिद्धान्त के अनुसार श्वेत वामन ( सफेद बौने ) तारे एक निश्चित द्रव्यमान प्राप्त करने के बाद अपने भार में और आधक वृद्धि नहीं कर सकते और अंततः वे काला वामन में परिवर्तित हो जाते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 2001", "lang": "hi", "page": 514, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0005", "q": "वह सीमा जिसके बाहर तारे आन्तरिक मृत्यु से ग्रसित होते हैं, कहलाती है", "options": ["चन्द्रशेखर सीमा", "एडिंगटन सीमा", "हॉयल सीमा", "फाउलर सीमा"], "answer": 0, "explanation": "वह सीमा जिसके बाहर तारे आंतरिक मृत्यु से ग्रसित होते हैं चंद्रशेखर सीमा कहलाती है। यदि किसी तारे का द्रव्यमान सूर्य के द्रव्यमान से कम अथवा बराबर (चन्द्रशेखर सीमा) है तो वह ‘लाल दानव’ से श्वेत वामन और अन्ततः काला वामन में परावर्तित हो जाता है। यदि तारे का द्रव्यमान सूर्य के द्रव्यमान से आधक या कई गुना है तो द्रव्यमान के अनुरूप सुपरनोवा विस्फोट के बाद वह न्यूट्रान तारा और फिर ब्लैक होल में रूपान्तरित हो जाता है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 1997", "lang": "hi", "page": 515, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0006", "q": "निम्नलिखित में से यह किसका मत था कि पृथ्वी सूर्य की परिक्रमा करती है?", "options": ["आर्यभट्ट", "ब्रह्मगुप्त", "वराहमिहिर", "उपर्युक्त में से कोई नहीं"], "answer": 2, "explanation": "वराहमिहिर का मत था कि पृथ्वी सूर्य की परिक्रमा करती है। इनकी प्रमुख रचनाएँ हैं– बृहत्संहिता और पंचसिद्धान्तिका। ‘आर्यभट्टीयम्’ और ‘सूर्य सिद्धान्तिक’ आर्यभट्ट की प्रमुख रचनाएँ हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP UDA/LDA (Pre) 2006", "lang": "hi", "page": 515, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0007", "q": "तारे का रंग सूचक है", "options": ["सूर्य से दूरी का", "उसकी ज्योति का", "उसकी पृथ्वी से दूरी का", "उसके ताप का"], "answer": 3, "explanation": "किसी तारें का रंग उसके ताप का सूचक होता है। तारों का रंग उसके नियमित `वर्णक्रम (Spectrum) अर्थात् उसकी तरंग दैर्ध्य के विकिरण की तीव्रता के आधार पर निर्धारित किया जाता है। सूर्य ( एक तारा है ) की सतह का तापमान 55000 C से 60000 C होता है। सूर्य का रंग पीला है। तारों में नाभिकीय संलयन की क्रिया से ऊष्मा उत्पन्न होती है। तारे के दीप्ति उसके अमाप, तापमान और पृथ्वी से उसकी दूरी पर निर्भर होती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "IAS (Pre) G.S. 1994 | Jharkhand PSC (Pre) G.S. 2006 | UPPCS (Pre) G.S. 2005 | UPPCS (Mains) G.S. IInd Paper 2008", "lang": "hi", "page": 518, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0008", "q": "तारे अपनी ऊर्जा प्राप्त करते हैं\n1. नाभिकीय संलयन से\n2. गुरुत्वीय संकुचन से\n3. रासायनिक आभक्रिया से\n4. नाभिकीय विखण्डन से अपने उत्तर का चयन\nनीचे दिए गए कूट से कीजिए", "options": ["1 एवं 2", "1, 2 एवं 3", "1 एवं 4", "2 एवं 4"], "answer": 0, "explanation": "तारे अपनी ऊर्जा नाभिकीय संलयन से प्राप्त करते हैं। तारे अत्यधिक गुरुत्वाकर्षण के कारण संकुचित हो जाते हैं। इसका परिणाम यह होता है कि उनका तापमान बढ़ जाता है और नाभिकीय संलयन की प्रक्रिया प्रारम्भ हो जाती है। इसमें मुख्य रूप से हाइड्रोजन गैस होती है, जो परस्पर आभक्रिया द्वारा क्रोड में आकर हीलियम में परिवर्तित होती रहती है। फलतः आधक मात्रा में ऊर्जा मुक्त होती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2000", "lang": "hi", "page": 519, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0009", "q": "निम्न में से कौन जलवायु परिवर्तन के खगोलीय सिद्धान्तों से सम्बन्धित नहीं है?", "options": ["पृथ्वी की कक्षा की उत्केन्द्रता (अण्डाकार कक्षीय मार्ग)", "पृथ्वी की घूर्णन अक्ष की तिर्यकता ( झुकाव )", "विषुव अयन ( पृथ्वी की सूर्य से अपसौर या उपसौर की स्थिति )", "सौर विकरित ऊर्जा ( सौर विकिरण )"], "answer": 3, "explanation": "विषुव अयन ( पृथ्वी की सूर्य से अपसौर या उपसौर की स्थिति), पृथ्वी की घूर्णन अक्ष की तिर्यकता और पृथ्वी को कक्षा की उत्केंद्रता (अण्डाकार कक्षीय मार्ग) इत्यादि जलवायु परिवर्तन के खगोलीय सिद्धान्तों से संबंधित है किन्तु सौर विकरित ऊर्जा (सौर विकिरण) इससे संबंधित नहीं है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. Re-exam. 2015", "lang": "hi", "page": 519, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0010", "q": "एक निश्चित आकृति में व्यवस्थित ताराओं का समूह कहलाता है", "options": ["आकाश गंगा", "नक्षत्र", "एन्ड्रोमेडा", "सौर मण्डल"], "answer": 1, "explanation": "एक निश्चित आकृति में व्यवस्थित ताराआें का समूह नक्षत्र या तारामण्डल कहलाता है। हमारे अन्तरिक्ष मेंे 88 तारामण्डल हैं। सप्तऋषि सात तारों का समूह है जो कि नक्षत्रमण्डल अर्सा मेसर का भाग है। सप्तऋषि तारामण्डल के तारे धु्रव तारे के ओर संकेत करते हैं तथा तारामण्डल ऐसे तारों की आकाश में एक विशेष आकृति, जो पृथ्वी से समदूरस्त नहीं हो सकते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) GS, 2013", "lang": "hi", "page": 519, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0011", "q": "आकाश गंगा वर्गीकृत की गई है", "options": ["सर्पिल गैलेक्सी के रूप में", "विद्युत गैलेक्सी के रूप में", "आनयमित गैलेक्सी के रूप में", "गोलाकार गैलेक्सी के रूप में"], "answer": 0, "explanation": "वह आकाशगंगा जिसमें हमारा सूर्य, पृथ्वी, ग्रह एवं उपग्रह आदि स्थित हैं उसे मंदाकिनी कहा जाता है। यह 24 आकाशगंगाआें का एक वृहद पुंज है। जिसमें हमारी मंदाकिनी आकाशगंगा का आकार सर्पिल है। सौर प्रणाली इसकी कुण्डलित भुजाआें में से एक में स्थित है। जिसमें लगभग 1 खरब तारे पाये जाते हैं। यह तस्तरी सदृश चपटी है इसमें तीन घूर्णनशील भुजायें हैंै। इसका विस्तार 80 हजार प्रकाश वर्ष है, इसके केन्द्र को बल्ज कहा जाता है जिसमें एक ब्लैक होल पाया जाता है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2001", "lang": "hi", "page": 519, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0012", "q": "अन्तरिक्ष यात्री को आकाश का रंग दिखाई देता हैः", "options": ["नीला", "सफेद", "काला", "लाल"], "answer": 2, "explanation": "अंतरिक्ष यात्री को अंतरिक्ष में आकाश का रंग काला दिखाई प डता है, क्योंकि अंतरिक्ष में वायुमंडल अनुपस्थित होता है जिससे प्रकाश का प्रकीर्णन नहीं हो पाता है। पृथ्वी से आकाश का रंग सूर्य के प्रकाश के प्रकीर्णन के कारण ही नीला दिखाई देता है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Mains) G.S. IInd Paper 2005", "lang": "hi", "page": 520, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0013", "q": "सूर्य की ऊर्जा उत्पन्न होती है", "options": ["नाभिकीय विखण्डन के द्वारा", "आयतन के द्वारा", "नाभिकीय संलयन के द्वारा", "ऑक्सीकरण के द्वारा"], "answer": 2, "explanation": "सूर्य सौर्य मण्डल का जनक तथा समस्त ऊर्जा का स्रोत है। इसका व्यास 13 . 84 लाख किमी. तथा इसके केन्द्र का तापमान 15 मिलियन सेंटीग्रेट है। सूर्य निरंतर ऊर्जा का विकिरण करता है और तब भी उसके पृष्ठ का तापमान की (6000 ° C पर) स्थिरता का कारण नाभिकीय संलयन है। इसके कुल द्रव्यमान का 70 भाग हाइड्रोजन, 28 हीलियम एवं 2 अन्य तत्व हैं। सूर्य में न्यूक्लीयर ईंधन हाइड्रोजन में होता है। सूर्य की ऊर्जा का प्रमुख कारण नाभिकीय संलयन है जिसमें हाइड्रोजन के परमाणु परस्पर आभक्रिया द्वारा हाइड्रोजन को हीलियम में परिवर्तित करते हैं, फलतः ब डी मात्रा में ऊर्जा मुक्त होती है। सूर्य के केन्द्र में उपस्थित पदार्थ प्लाज्मा अवस्था में होते हैं। यह ठोस, द्रव एवं गैस के आतरिक्त चौथी अवस्था है। सूर्य पृथ्वी से 14 . 96 करोड़ किमी. ( 149 . 6 मिलियन किमी.) की दूरी पर स्थित है तथा इसका आकार पृथ्वी से 109 गुना आधक है। सूर्य का प्रकाश पृथ्वी तक पहुँचने में 499 सेकेंण्ड ( 8 . 3 मिनट) का समय लगता है। एक खगोलीय (एस्ट्रोनॉमिकल) इकाई पृथ्वी और सूर्य के बीच की औसत दूरी है। सूर्य और पृथ्वी के बीच औसत दूरी लगभग 150 × 106 किमी. है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2006 | UPPCS (Pre) G.S. 1996, 2001", "lang": "hi", "page": 522, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0014", "q": "सूर्य में न्यूक्लियर ईंधन होता है", "options": ["हीलियम", "हाइड्रोजन", "यूरेनियम", "एल्फा कण"], "answer": 1, "explanation": "सूर्य सौर्य मण्डल का जनक तथा समस्त ऊर्जा का स्रोत है। इसका व्यास 13 . 84 लाख किमी. तथा इसके केन्द्र का तापमान 15 मिलियन सेंटीग्रेट है। सूर्य निरंतर ऊर्जा का विकिरण करता है और तब भी उसके पृष्ठ का तापमान की (6000 ° C पर) स्थिरता का कारण नाभिकीय संलयन है। इसके कुल द्रव्यमान का 70 भाग हाइड्रोजन, 28 हीलियम एवं 2 अन्य तत्व हैं। सूर्य में न्यूक्लीयर ईंधन हाइड्रोजन में होता है। सूर्य की ऊर्जा का प्रमुख कारण नाभिकीय संलयन है जिसमें हाइड्रोजन के परमाणु परस्पर आभक्रिया द्वारा हाइड्रोजन को हीलियम में परिवर्तित करते हैं, फलतः ब डी मात्रा में ऊर्जा मुक्त होती है। सूर्य के केन्द्र में उपस्थित पदार्थ प्लाज्मा अवस्था में होते हैं। यह ठोस, द्रव एवं गैस के आतरिक्त चौथी अवस्था है। सूर्य पृथ्वी से 14 . 96 करोड़ किमी. ( 149 . 6 मिलियन किमी.) की दूरी पर स्थित है तथा इसका आकार पृथ्वी से 109 गुना आधक है। सूर्य का प्रकाश पृथ्वी तक पहुँचने में 499 सेकेंण्ड ( 8 . 3 मिनट) का समय लगता है। एक खगोलीय (एस्ट्रोनॉमिकल) इकाई पृथ्वी और सूर्य के बीच की औसत दूरी है। सूर्य और पृथ्वी के बीच औसत दूरी लगभग 150 × 106 किमी. है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP Lower (Pre) 2004", "lang": "hi", "page": 523, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0015", "q": "सूर्य से पृथ्वी तक प्रकाश को आने में लगभग समय लगता हैः", "options": ["2 मिनट", "4 मिनट", "8 मिनट", "16 मिनट"], "answer": 2, "explanation": "सूर्य सौर्य मण्डल का जनक तथा समस्त ऊर्जा का स्रोत है। इसका व्यास 13 . 84 लाख किमी. तथा इसके केन्द्र का तापमान 15 मिलियन सेंटीग्रेट है। सूर्य निरंतर ऊर्जा का विकिरण करता है और तब भी उसके पृष्ठ का तापमान की (6000 ° C पर) स्थिरता का कारण नाभिकीय संलयन है। इसके कुल द्रव्यमान का 70 भाग हाइड्रोजन, 28 हीलियम एवं 2 अन्य तत्व हैं। सूर्य में न्यूक्लीयर ईंधन हाइड्रोजन में होता है। सूर्य की ऊर्जा का प्रमुख कारण नाभिकीय संलयन है जिसमें हाइड्रोजन के परमाणु परस्पर आभक्रिया द्वारा हाइड्रोजन को हीलियम में परिवर्तित करते हैं, फलतः ब डी मात्रा में ऊर्जा मुक्त होती है। सूर्य के केन्द्र में उपस्थित पदार्थ प्लाज्मा अवस्था में होते हैं। यह ठोस, द्रव एवं गैस के आतरिक्त चौथी अवस्था है। सूर्य पृथ्वी से 14 . 96 करोड़ किमी. ( 149 . 6 मिलियन किमी.) की दूरी पर स्थित है तथा इसका आकार पृथ्वी से 109 गुना आधक है। सूर्य का प्रकाश पृथ्वी तक पहुँचने में 499 सेकेंण्ड ( 8 . 3 मिनट) का समय लगता है। एक खगोलीय (एस्ट्रोनॉमिकल) इकाई पृथ्वी और सूर्य के बीच की औसत दूरी है। सूर्य और पृथ्वी के बीच औसत दूरी लगभग 150 × 106 किमी. है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Mains) G.S. IInd Paper 2005 | BPSC (Pre) G.S. 1997-98", "lang": "hi", "page": 523, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0016", "q": "सूर्य के निकटतम् ग्रह है-", "options": ["बुध", "पृथ्वी", "शुक्र", "प्लूटो"], "answer": 0, "explanation": "बुध, सूर्य से निकटतम् ग्रह है। सूर्य के सर्वाधिक नजदीक होने के कारण इसका दैनिक तापान्तर सर्वाधिक है। यह सूर्य की सबसे कम समय (88 दिन ) में परिक्रमा पूरी करता है। ग्रीक लोग इसे ‘अपोलो’ नाम से जानते हैं। बुध और शुक्र के कोई उपग्रह नहीं हैं। यह सौरमण्डल का सबसे छोटा ग्रह है तथा यह सौरमण्डल का न्यूनतम द्रव्यमान वाला ग्रह है। सूर्य से दूरी के बढ़ते क्रम में ग्रहों की स्थिति निम्नलिखित है- बुध ( मरकरी ), शुक्र ( वीनस ), पृथ्वी ( अर्थ ), मंगल ( मार्स ), बृहस्पति ( जूपिटर ), शनि (सैटर्न), अरुण (यूरेनस), वरुण (नेपच्यून)।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Mains) G.S. Ist Paper 2004 | IAS (Pre) G.S. 1994 | UPPCS AFC Exam. 2013", "lang": "hi", "page": 524, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0017", "q": "निम्नलिखित में से कौन-सा ग्रह सबसे कम समय में सूर्य का चक्कर लगाता है?", "options": ["प्लूटो", "बुध", "पृथ्वी", "शनि"], "answer": 1, "explanation": "बुध, सूर्य से निकटतम् ग्रह है। सूर्य के सर्वाधिक नजदीक होने के कारण इसका दैनिक तापान्तर सर्वाधिक है। यह सूर्य की सबसे कम समय (88 दिन ) में परिक्रमा पूरी करता है। ग्रीक लोग इसे ‘अपोलो’ नाम से जानते हैं। बुध और शुक्र के कोई उपग्रह नहीं हैं। यह सौरमण्डल का सबसे छोटा ग्रह है तथा यह सौरमण्डल का न्यूनतम द्रव्यमान वाला ग्रह है। सूर्य से दूरी के बढ़ते क्रम में ग्रहों की स्थिति निम्नलिखित है- बुध ( मरकरी ), शुक्र ( वीनस ), पृथ्वी ( अर्थ ), मंगल ( मार्स ), बृहस्पति ( जूपिटर ), शनि (सैटर्न), अरुण (यूरेनस), वरुण (नेपच्यून)।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2002", "lang": "hi", "page": 525, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0018", "q": "सौर परिवार का सबसे छोटा ग्रह कौन-सा है", "options": ["प्लूटो", "मंगल", "शुक्र", "बुध"], "answer": 3, "explanation": "बुध, सूर्य से निकटतम् ग्रह है। सूर्य के सर्वाधिक नजदीक होने के कारण इसका दैनिक तापान्तर सर्वाधिक है। यह सूर्य की सबसे कम समय (88 दिन ) में परिक्रमा पूरी करता है। ग्रीक लोग इसे ‘अपोलो’ नाम से जानते हैं। बुध और शुक्र के कोई उपग्रह नहीं हैं। यह सौरमण्डल का सबसे छोटा ग्रह है तथा यह सौरमण्डल का न्यूनतम द्रव्यमान वाला ग्रह है। सूर्य से दूरी के बढ़ते क्रम में ग्रहों की स्थिति निम्नलिखित है- बुध ( मरकरी ), शुक्र ( वीनस ), पृथ्वी ( अर्थ ), मंगल ( मार्स ), बृहस्पति ( जूपिटर ), शनि (सैटर्न), अरुण (यूरेनस), वरुण (नेपच्यून)।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 1991", "lang": "hi", "page": 525, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0019", "q": "वे दो ग्रह जिनके उपग्रह नहीं हैंः", "options": ["पृथ्वी व बृहस्पति", "बुध एवं शुक्र", "बुध एवं शनि", "शुक्र एवं मंगल"], "answer": 1, "explanation": "बुध, सूर्य से निकटतम् ग्रह है। सूर्य के सर्वाधिक नजदीक होने के कारण इसका दैनिक तापान्तर सर्वाधिक है। यह सूर्य की सबसे कम समय (88 दिन ) में परिक्रमा पूरी करता है। ग्रीक लोग इसे ‘अपोलो’ नाम से जानते हैं। बुध और शुक्र के कोई उपग्रह नहीं हैं। यह सौरमण्डल का सबसे छोटा ग्रह है तथा यह सौरमण्डल का न्यूनतम द्रव्यमान वाला ग्रह है। सूर्य से दूरी के बढ़ते क्रम में ग्रहों की स्थिति निम्नलिखित है- बुध ( मरकरी ), शुक्र ( वीनस ), पृथ्वी ( अर्थ ), मंगल ( मार्स ), बृहस्पति ( जूपिटर ), शनि (सैटर्न), अरुण (यूरेनस), वरुण (नेपच्यून)।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 1999 | UPPCS Spl, (Pre) G.S. 2008 | UPPCS (Mains) G.S. IInd Paper, 2016 | Uttrakhand PCS (M) 2002-03 | BPSC (Pre) 1997-98, 2000-01 | Uttrakhand PCS (M) Ist 2002-03", "lang": "hi", "page": 525, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0020", "q": "निम्नलिखित ग्रहांे में से कौन सा ग्रह सूर्य के चारों ओर पूरब से पश्चिम की तरफ (घड़ी की तरह) घूमता है?", "options": ["पृथ्वी", "मंगल", "शुक्र", "बृहस्पति"], "answer": 2, "explanation": "शुक्र ( Venus ) सूर्य से दूसरा सबसे नजदीक स्थित ग्रह है इसका आकार, त्रिज्या और भार हमारी पृथ्वी के आकार, त्रिज्या और भार के लगभग समान है। इसी कारण इसे ‘ पृथ्वी की जुड़वा बहन ’ कहा जाता है। यह पृथ्वी का निकटतम ग्रह है। उल्लेखनीय है कि सभी ग्रह पश्चिम से पूर्व दिशा में सूर्य का चक्कर लगाते हैं जबकि शुक्र और अरुण पूर्व से पश्चिम दिशा में सूर्य का चक्कर लगाते हैं। यह सबसे गर्म और चमकीला ग्रह है। इसे भोर का तारा या संध्या का तारा भी कहते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPSC ACF-RFO (M) II Paper 2019", "lang": "hi", "page": 526, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0021", "q": "पृथ्वी की जुड़वा बहन कहे जाने वाले ग्रह का नाम है ─", "options": ["बुध", "शुक्र", "मंगल", "प्लूटो"], "answer": 1, "explanation": "शुक्र ( Venus ) सूर्य से दूसरा सबसे नजदीक स्थित ग्रह है इसका आकार, त्रिज्या और भार हमारी पृथ्वी के आकार, त्रिज्या और भार के लगभग समान है। इसी कारण इसे ‘ पृथ्वी की जुड़वा बहन ’ कहा जाता है। यह पृथ्वी का निकटतम ग्रह है। उल्लेखनीय है कि सभी ग्रह पश्चिम से पूर्व दिशा में सूर्य का चक्कर लगाते हैं जबकि शुक्र और अरुण पूर्व से पश्चिम दिशा में सूर्य का चक्कर लगाते हैं। यह सबसे गर्म और चमकीला ग्रह है। इसे भोर का तारा या संध्या का तारा भी कहते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2007 | UP Lower (Pre) 2008", "lang": "hi", "page": 526, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0022", "q": "निम्नलिखित में से किस एक को `भोर का तारा' के नाम से जाना जाता है?", "options": ["बुध", "शुक्र", "मंगल", "शनि"], "answer": 1, "explanation": "शुक्र ( Venus ) सूर्य से दूसरा सबसे नजदीक स्थित ग्रह है इसका आकार, त्रिज्या और भार हमारी पृथ्वी के आकार, त्रिज्या और भार के लगभग समान है। इसी कारण इसे ‘ पृथ्वी की जुड़वा बहन ’ कहा जाता है। यह पृथ्वी का निकटतम ग्रह है। उल्लेखनीय है कि सभी ग्रह पश्चिम से पूर्व दिशा में सूर्य का चक्कर लगाते हैं जबकि शुक्र और अरुण पूर्व से पश्चिम दिशा में सूर्य का चक्कर लगाते हैं। यह सबसे गर्म और चमकीला ग्रह है। इसे भोर का तारा या संध्या का तारा भी कहते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP Lower (Pre) 2015", "lang": "hi", "page": 526, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0023", "q": "पृथ्वी से निकटतम दूरी पर ग्रह है ─", "options": ["बुध", "शुक्र", "मंगल", "बृहस्पति"], "answer": 1, "explanation": "शुक्र ( Venus ) सूर्य से दूसरा सबसे नजदीक स्थित ग्रह है इसका आकार, त्रिज्या और भार हमारी पृथ्वी के आकार, त्रिज्या और भार के लगभग समान है। इसी कारण इसे ‘ पृथ्वी की जुड़वा बहन ’ कहा जाता है। यह पृथ्वी का निकटतम ग्रह है। उल्लेखनीय है कि सभी ग्रह पश्चिम से पूर्व दिशा में सूर्य का चक्कर लगाते हैं जबकि शुक्र और अरुण पूर्व से पश्चिम दिशा में सूर्य का चक्कर लगाते हैं। यह सबसे गर्म और चमकीला ग्रह है। इसे भोर का तारा या संध्या का तारा भी कहते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 1991, 1997, 1993 | UPPCS (Mains) G.S. IInd Paper 2012 | Uttrakhand PCS (Pre) 2002-03", "lang": "hi", "page": 527, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0024", "q": "पृथ्वी की परिक्रमण धुरी ( ध्रुवीय धुरी ) सदा झुकी होती हैः", "options": ["दीर्घवृत्तीय धुरी से 23.0o पर", "दीर्घवृत्तीय धुरी से 23.1o पर", "दीर्घवृत्तीय धुरी से 24.5o पर", "दीर्घवृत्तीय धुरी से 23.5o पर"], "answer": 3, "explanation": "उपर्युक्त ग्रहों में सबसे बड़ा आकार पृथ्वी का है। पृथ्वी का भूमध्य रेखीय व्यास 12756 किमी. तथा धु्रवीय व्यास 12714 किमी. है। पृथ्वी की भूमध्य रेखीय परिधि 40075 किमी. तथा ध्रुवीय परिधि 40008 किमी. है। यह अपने अक्ष पर 23 . 5 अंश झुकी हुई है, पृथ्वी को अपने अक्ष पर एक चक्कर लगाने में 23 घण्टे 56 मिनट तथा 4 . 09 सेकेन्ड का समय लगता है तथा यह सूर्य की परिक्रमा 365 . 25 दिन में पूरी करती है। यह 29 . 8 किमी./से. के माध्य वेग से सूर्य का चक्कर लगाती है। पृथ्वी शुक्र एवं मंगल के बीच में अवस्थित है। पृथ्वी की आयु लगभग 4 . 6 बिलियन वर्ष मानी जाती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 2016 | MPPSC (Pre) GS, 1990", "lang": "hi", "page": 528, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0025", "q": "पृथ्वी स्थित है", "options": ["शुक्र एवं मंगल के मध्य", "मंगल एवं बृहस्पति के मध्य", "शुक्र एवं बृहस्पति के मध्य", "बुध एवं शुक्र के मध्य"], "answer": 0, "explanation": "उपर्युक्त ग्रहों में सबसे बड़ा आकार पृथ्वी का है। पृथ्वी का भूमध्य रेखीय व्यास 12756 किमी. तथा धु्रवीय व्यास 12714 किमी. है। पृथ्वी की भूमध्य रेखीय परिधि 40075 किमी. तथा ध्रुवीय परिधि 40008 किमी. है। यह अपने अक्ष पर 23 . 5 अंश झुकी हुई है, पृथ्वी को अपने अक्ष पर एक चक्कर लगाने में 23 घण्टे 56 मिनट तथा 4 . 09 सेकेन्ड का समय लगता है तथा यह सूर्य की परिक्रमा 365 . 25 दिन में पूरी करती है। यह 29 . 8 किमी./से. के माध्य वेग से सूर्य का चक्कर लगाती है। पृथ्वी शुक्र एवं मंगल के बीच में अवस्थित है। पृथ्वी की आयु लगभग 4 . 6 बिलियन वर्ष मानी जाती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Main) G.S. Ist Paper 2012", "lang": "hi", "page": 528, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0026", "q": "इसके दिन की अवधि तथा इसके अक्ष का झुकाव सन्निकटतः पृथ्वी के ही समान है। यह सत्य है", "options": ["यूरेनस के बारे में", "नेपच्यून के बारे में", "शनि के बारे में", "मंगल के बारे में"], "answer": 3, "explanation": "पृथ्वी के एक दिन की अवधि 23 घंटे 56 मिनट 4. 09 सेकेण्ड है तथा पृथ्वी अपने अक्ष पर 23.5 अंश झुकी हुई है। पृथ्वी के समान ही मंगल के दिन की अवधि 24 घंटे 37 मिनट है तथा अक्ष का झुकाव 25012' है। इसी के कारण मंगल और पृथ्वी के दिन-रात की अवधि लगभग समान पायी जाती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2001", "lang": "hi", "page": 529, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0027", "q": "किसमें पृथ्वी के अलावा अन्य पर भी जीवन की संभावना है, क्योंकि वहाँ का पर्यावरण जीवन के लिए बहुत अनुकूल है?", "options": ["बृहस्पति", "मंगल", "यूरोपा- बृहस्पति का चन्द्रमा", "चन्द्रमा-पृथ्वी का चन्द्रमा"], "answer": 1, "explanation": "मंगल ग्रह पर जीवन की संभावना के लिए वहाँ पर बर्फ घटकों और हिमशीतित जल की उपस्थिति ने यह सिद्ध कर दिया है कि वहाँ पर मानव जीवन संभव है। इसके वायुमण्डल में कार्बन डाईऑक्साइड 95%, नाइट्रोजन लगभग 3% व ऑर्गन लगभग 1-2% तथा ऑक्सीजन 0.1 से 4% तक पायी जाती है। निक्स ओलंपिया मंगल ग्रह पर स्थित सर्वोच्च ज्वालामुखी पर्वत है, जो माउण्ट एवरेस्ट की तुलना में तीन गुना ऊँचा है। नासा के स्रोतों के अनुसार मंगल ग्रह पर उपस्थित जीवन के निम्नलिखित लक्षण पाये गये हैं, जिनमें जल, जिप्सम तथा मीथेन की विद्यमानता हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 2000", "lang": "hi", "page": 530, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0028", "q": "नासा के अनुसार, मंगल ग्रह पर उपस्थित जीवन के अब तक पाए गए लक्षणों में सम्मिलित हैं", "options": ["केवल जल", "केवल जल और जिप्सम", "जल, जिप्सम और मीथेन", "उपर्युक्त में से कोई नहीं"], "answer": 2, "explanation": "मंगल ग्रह पर जीवन की संभावना के लिए वहाँ पर बर्फ घटकों और हिमशीतित जल की उपस्थिति ने यह सिद्ध कर दिया है कि वहाँ पर मानव जीवन संभव है। इसके वायुमण्डल में कार्बन डाईऑक्साइड 95%, नाइट्रोजन लगभग 3% व ऑर्गन लगभग 1-2% तथा ऑक्सीजन 0.1 से 4% तक पायी जाती है। निक्स ओलंपिया मंगल ग्रह पर स्थित सर्वोच्च ज्वालामुखी पर्वत है, जो माउण्ट एवरेस्ट की तुलना में तीन गुना ऊँचा है। नासा के स्रोतों के अनुसार मंगल ग्रह पर उपस्थित जीवन के निम्नलिखित लक्षण पाये गये हैं, जिनमें जल, जिप्सम तथा मीथेन की विद्यमानता हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Mains) G.S. IInd Paper 2009", "lang": "hi", "page": 530, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0029", "q": "बृहस्पति का वलय होता है-", "options": ["सिलिकेटो का बना हुआ", "आस्तत्वविहीन", "बहुत घना एवं अपारदर्शक", "उपरोक्त सभी"], "answer": 0, "explanation": "बृहस्पति सौरमंडल का सबसे बड़ा एवं भारी ग्रह है। इसका व्यास 142984 किमी. है। सूर्य से इसकी औसत दूरी 77.83 करो ड किमी. है। यह अपने अक्ष पर सबसे तेज घूर्णन करता है जो 9 घंटे 55 मिनट में अपने अक्ष का एक चक्कर पूरा करता है। बृहस्पति के वलयों का निर्माण सिलिकेटों से हुआ है जिसे ‘जोवियन वलय’ कहा जाता है। बृहस्पति के वायुमण्डल में हाइड्रो जन, हीलियम, मीथेन तथा अमोनिया गैस पायी जाती है। इसके उपग्रहों की संख्या वर्तमान में 95 है। बृहस्पति का परिक्रमण अवधि 11 . 86 वर्ष है तथा इसका धारालीय गुरुत्वाकषर्ण पृथ्वी से आधक है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Mains) G.S. Ist Paper 2004", "lang": "hi", "page": 531, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0030", "q": "मिथेन जिसके वायुमण्डल में उपस्थित है, वह है", "options": ["चन्द्रमा", "सूर्य", "बृहस्पति", "मंगल"], "answer": 2, "explanation": "बृहस्पति सौरमंडल का सबसे बड़ा एवं भारी ग्रह है। इसका व्यास 142984 किमी. है। सूर्य से इसकी औसत दूरी 77.83 करो ड किमी. है। यह अपने अक्ष पर सबसे तेज घूर्णन करता है जो 9 घंटे 55 मिनट में अपने अक्ष का एक चक्कर पूरा करता है। बृहस्पति के वलयों का निर्माण सिलिकेटों से हुआ है जिसे ‘जोवियन वलय’ कहा जाता है। बृहस्पति के वायुमण्डल में हाइड्रो जन, हीलियम, मीथेन तथा अमोनिया गैस पायी जाती है। इसके उपग्रहों की संख्या वर्तमान में 95 है। बृहस्पति का परिक्रमण अवधि 11 . 86 वर्ष है तथा इसका धारालीय गुरुत्वाकषर्ण पृथ्वी से आधक है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) GS, 2010", "lang": "hi", "page": 531, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0031", "q": "शनि ग्रह के वायुमण्डल में निम्नलिखित में से कौन-सी गैस सबसे आधक मात्रा में पाई जाती है।", "options": ["नाइट्रोजन", "कार्बन मोनोऑ क्साइड", "मीथेन", "सल्फर डाईऑक्साइड"], "answer": 2, "explanation": "दिये गये विकल्पों के अनुसार शनि ग्रह के वायुमण्डल में सबसे आधक मात्रा में पायी जाने वाली गैस मीथेन है। शनि के वायुमण्डल में मीथेन एवं अमोनिया के बादल पाये जाते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) 2022", "lang": "hi", "page": 531, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0032", "q": "सूर्य की परिक्रमा में कौन सा ग्रह सर्वाधिक समय लेता है?", "options": ["यूरेनस", "बृहस्पति", "वरुण", "प्लूटो"], "answer": 2, "explanation": "सूर्य की परिक्रमा करने में सर्वाधिक समय वरुण (Neptune) लेता है। यह 164 वर्षों में सूर्य की परिक्रमा करता है। सौर जगत का सबसे दूर का ग्रह है यह सौर मण्डल का सबसे ठंडा ग्रह है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP Lower (Pre) Spl. 2004", "lang": "hi", "page": 532, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0033", "q": "ग्रहों के बारे में निम्न में क्या सत्य है", "options": ["ये प्रकाशहीन होते हैं किन्तु चमकते नहीं हैं।", "ये अप्रकाशमान होते हुए भी चमकते हैं।", "ये प्रकाशवान होते हैं किंतु चमकते नहीं।", "ये प्रकाशवान भी हैं और चमकते भी हैं।"], "answer": 1, "explanation": "ग्रह (Planet) वे खगोलीय पिण्ड होते हैं जोे स्वयं के प्रकाश से न प्रकाशित होकर तारों के प्रकाश से प्रकाशित होते हैं अर्थात् ये अप्रकाशमान होते हुए भी चमकते हैं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 1992", "lang": "hi", "page": 533, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0034", "q": "निम्नलिखित ग्रहों को उनकी सूर्य से दूरी के बढ़ते क्रम में व्यवस्थित कीजिए\n1. प्लूटो\n2. पृथ्वी\n3. बृहस्पति\n4. अरुण\nकूटः", "options": ["2, 3, 4, 1", "4, 3, 2, 1", "3, 2, 4, 1", "1, 2, 4, 3"], "answer": 0, "explanation": "प्रश्नकाल के दौरान सौर मंडल में कुल 9 ग्रह, (सूर्य से दूरी के अनुसार) क्रमशः बुध, शुक्र, पृथ्वी, मंगल, बृहस्पति, शनि, अरुण, वरुण व यम थे। वर्ष 2006 में प्राग में आयोजित खगोलशास्त्रियों की बैठक में ग्रहों के नये मानक तय किए गये हैं। इस आधार पर प्लेटो को ग्रह न मानकर एक खगोलीय पिण्ड माना गया है। अतः वर्तमान समय में ग्रहों की कुल संख्या 8 है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP Lower (Pre) Spl. G.S. 2002", "lang": "hi", "page": 534, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0035", "q": "निम्नलिखित युग्मों में से कौन सा सुमेलित नहीं है?", "options": ["सौरमंडल का सबसे बड़ा ग्रह बृहस्पति ग्रह", "सौरमंडल का सबसे छोटा ग्रह बुध ग्रह", "सौरमंडल का सर्वाधिक चमकीला ग्रह शुक्र", "सौरमंडल का मन्दतम गति वाला ग्रह मंगल"], "answer": 3, "explanation": "बृहस्पति सौरमण्डल का सबसे बड़ा ग्रह है, जबकि बुध सबसे छोटा ग्रह है। शुक्र सबसे चमकीला तथा गर्म ग्रह है। मंगल ग्रह का सूर्य की कक्षा में परिक्रमण काल 687 दिन है जबकि वरूण का सूर्य की कक्षा में परिक्रमण काल 164 वर्ष है। अतः सौरमण्डल का मन्दतम ग्रह वरुण है। अतः विकल्प (d) सही सुमेलित नहीं है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Mains) G.S. IInd Paper 2011", "lang": "hi", "page": 534, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0036", "q": "निम्नलिखित कथनों पर विचार कीजिए और उत्तर\nनीचे दिए हुए कूटों की सहायता से दीजिए करण\n(A) पृथ्वी पर से चन्द्रमा के पृष्ठ का केवल एक फलक ही दिखाई देता है।\nकारण (R) अपने अक्ष पर चन्द्रमा के घूर्णन का काल उसके पृथ्वी के चारों ओर घूमने के काल के बराबर होता है।\nकूटः", "options": ["A तथा R दोनों सही हैं और R, A का सही स्पष्टीकरण है", "A तथा R दोनों सही हैं परन्तु R, A का सही स्पष्टीकरण नहीं है", "A सही है किन्तु R गलत है", "A गलत है किन्तु R सही है"], "answer": 0, "explanation": "चन्द्रमा की परिक्रमण एवं परिभ्रमण दोनों की ही अवधि 27 दिन 7 घंटे 43 मिनट है। यही कारण है कि हमें चन्द्रमा का एक भाग ही दिखाई पड़ता है। पृथ्वी से चंद्रमा की संपूर्ण सतह नहीं दिखाई प डती है। चन्द्रमा का केवल 59% भाग ही पृथ्वी से दिखाई पड़ता है। चन्द्रमा दीर्घवृत्ताकार पथ में पृथ्वी की परिक्रमा करता है। जब चन्द्रमा पृथ्वी के सबसे निकट होता है, तो इस अवस्था को उपभू (पेरेजी) कहा जाता है। चन्द्रमा की पृथ्वी से सबसे दूर की अवस्था अपभू (अपोजी) कहलाती है। चन्द्रमा की पृथ्वी से आधकतम दूरी 407000 किमी . एवं न्यूनतम दूरी 356000 किमी . है। चंद्रमा एक उपग्रह है। पृथ्वी से चन्द्रमा की औसत दूरी 384400 किमी. है। अतः (A) तथा (R) दोनों सही हैं तथा (R), (A) की सही स्पष्टीकरण है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2006", "lang": "hi", "page": 535, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0037", "q": "चन्द्रमा की पृथ्वी से दूरी है-", "options": ["364 हजार किमी .", "300 हजार किमी .", "446 हजार किमी .", "350 हजार किमी ."], "answer": 0, "explanation": "चन्द्रमा की परिक्रमण एवं परिभ्रमण दोनों की ही अवधि 27 दिन 7 घंटे 43 मिनट है। यही कारण है कि हमें चन्द्रमा का एक भाग ही दिखाई पड़ता है। पृथ्वी से चंद्रमा की संपूर्ण सतह नहीं दिखाई प डती है। चन्द्रमा का केवल 59% भाग ही पृथ्वी से दिखाई पड़ता है। चन्द्रमा दीर्घवृत्ताकार पथ में पृथ्वी की परिक्रमा करता है। जब चन्द्रमा पृथ्वी के सबसे निकट होता है, तो इस अवस्था को उपभू (पेरेजी) कहा जाता है। चन्द्रमा की पृथ्वी से सबसे दूर की अवस्था अपभू (अपोजी) कहलाती है। चन्द्रमा की पृथ्वी से आधकतम दूरी 407000 किमी . एवं न्यूनतम दूरी 356000 किमी . है। चंद्रमा एक उपग्रह है। पृथ्वी से चन्द्रमा की औसत दूरी 384400 किमी. है। अतः (A) तथा (R) दोनों सही हैं तथा (R), (A) की सही स्पष्टीकरण है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP Lower (Pre) 2008", "lang": "hi", "page": 535, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0038", "q": "चन्द्रमा पर वायुमण्डल नहीं होने का क्या कारण है?", "options": ["यह पृथ्वी के निकट है।", "यह सूर्य से प्रकाश प्राप्त करता है।", "यह पृथ्वी की परिक्रमा करता है।", "इस पर गैस अणुओं का पलायन वेग उनके वर्ग माध्य मूल वेग से कम होता है।"], "answer": 3, "explanation": "चंद्रमा पर वायुमण्डल नहीं होने का कारण इस पर गैस के अणुओं का पलायन वेग उनके वर्ग माध्य मूल वेग से कम होना है। चन्द्रमा का भार पृथ्वी की तुलना में कम होने से चन्द्रमा का पलायन वेग कम होता है। फलतः चन्द्रमा पर वायुमण्डल का अभाव है। चन्द्रमा पर गुरूत्वाकर्षण नहीं होना वायुमण्डल का प्रमुख कारण है। चन्द्रमा पर कोई चुम्बकीय क्षेत्र नहीं है इसलिए इसकी ज्यादातर सतह सीधे सूर्य, हवा और दूसरे अंतरिक्ष विकिरण के सम्पर्क में रहती है। चंद्रमा पर मानव का वजन (किसी वस्तु का) पृथ्वी की तुलना में 1 / 6 रहता है क्योंकि चंद्रमा पर पृथ्वी की तरह गुरुत्वाकर्षण नहीं पाया जाता है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Main) G.S. IInd Paper 2012 | 70th BPSC (Pre) 2024 (Re-Exam)", "lang": "hi", "page": 536, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0039", "q": "एक भू-उपग्रह अपनी कक्षा में निरन्तर गति करता है। यह अपकेन्द्र बल के प्रभाव से होता है जो प्राप्त होता है", "options": ["उपग्रह को प्रेरित करने वाले रॉकेट इंजन से", "पृथ्वी द्वारा उपग्रह पर लगने वाले गुरुत्वाकर्षण से", "सूर्य द्वारा उपग्रह पर लगने वाले गुरुत्वाकर्षण से", "उपग्रह द्वारा पृथ्वी पर लगने वाले गुरुत्वाकर्षण से"], "answer": 1, "explanation": "एक भू-उपग्रह अपनी कक्षा में निरंतर गति करता है यह अपकेन्द्र बल पृथ्वी द्वारा उपग्रह पर लगने वाले गुरुत्वाकर्षण बल के प्रभाव से होता है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2006", "lang": "hi", "page": 536, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0040", "q": "यदि चन्द्रमा की सतह से एक शैल पृथ्वी पर लाया गया है, तो-", "options": ["इसके द्रव्यमान में परिवर्तन हो जाएगा", "इसके भार में परिवर्तन होगा परन्तु द्रव्यमान में नहीं", "द्रव्यमान एवं भार दोनों में परिवर्तन होगा", "द्रव्यमान एवं भार दोनों समान रहेंगे"], "answer": 1, "explanation": "चन्द्रमा की सतह से कोई शैल पृथ्वी पर लाया जाएगा तो उसके भार में परिवर्तन होगा परन्तु द्रव्यमान में नहीं।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP Lower (Pre) 2004", "lang": "hi", "page": 537, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0041", "q": "टाइटन सबसे बड़ा चन्द्रमा या उपग्रह है", "options": ["मंगल का", "शुक्र का", "बृहस्पति का", "शनि का"], "answer": 3, "explanation": "टाइटन शनि का सबसे बड़ा उपग्रह है जिसका व्यास 5150 किमी. है। सौरमंडल का यही एक उपग्रह है जिसके पास अपना स्थायी वायुमण्डल है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP UDA/LDA (Pre) 2006", "lang": "hi", "page": 537, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0042", "q": "अन्तरिक्ष यान मैगेलन किस ग्रह पर भेजा गया था?", "options": ["मंगल", "शनि", "बृहस्पति", "शुक्र"], "answer": 3, "explanation": "मैगेलन अंतरिक्ष यान को शुक्र की सतह के मानचित्रण और ग्रहीय गुरुत्वाकर्षण को मापने के लिए 4 मई 1989 को नासा द्वारा प्रक्षेपित किया गया था।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 2000", "lang": "hi", "page": 537, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0043", "q": "पृथ्वी के परितः घूमने वाले कृत्रिम उपग्रह से बाहर गिराई गई गेंद-", "options": ["सूर्य पर चली जाएगी", "चन्द्रमा पर चली जाएगी", "पृथ्वी पर गिरेगा", "पृथ्वी के परितः उपग्रह के समान आवर्तकाल के साथ उसी के कक्ष में घूमती रहेगी।"], "answer": 3, "explanation": "पृथ्वी के परितः घूमने वाले कृत्रिम उपग्रह से बाहर गिराई गई गेंद पृथ्वी के परितः उपग्रह के समान आवर्तकाल के साथ उसी के कक्षा में घूमती रहेगी। F. धूमकेतु एवं क्षुद्रग्रह (Comets & Asteroids) धूमकेतु एवं क्षुद्रग्रह धूमकेतु- पत्थर, धूल, बर्प, जलकणों और हिमानी गैसों का वह चट्टानी तथा धातुई पिण्ड जो सूर्य के चारों ओर परवलयाकार एवं आतपरवलयाकार पथ पर घूमते हुए पृथ्वी से (कुछ दिनों या महीनों) नग्न आँखों से चमकीले रूप में दृष्टिगोचर होते हैं, धूमकेतु या पुच्छल तारा कहलाते हैं। ये सौर मण्डल के स्थायी सदस्य होते हैं। सर्वप्रथम टाइको ब्राहे महोदय ने इनकी खोज की थी। इनकी पूँछ सदैव सूर्य के विपरीत दिशा में होती है। कुछ प्रमुख पुच्छल तारे जैसे- हेली पुच्छल तारा, वेस्ट एवं शूमेकर लेबी पुच्छल आदि हैं। क्षुद्रग्रह- मंगल और बृहस्पति ग्रह के मध्य करो डों कमी. क्षेत्र में भिन्न- भिन्न आकार के पिण्डों की पट्टी है, जिन्हें क्षुद्रग्रह कहते हैं। इनकी अनुमानित संख्या 40000 से आधक है। सौरमण्डल के प्रमुख क्षुद्रग्रहों के नाम- सिरस, पलास, वेस्टा, हाइजिया, इंट्र ाम्निया आदि।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 1995", "lang": "hi", "page": 537, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0044", "q": "मंगल और वृहस्पति की कक्षाओं के बीच सूर्य के चारों ओर परिक्रमा करने वाले शैल के छोटे टुकड़ों के समूह को क्या कहते हैं?", "options": ["उल्का", "धूमकेतु", "उल्कापिण्ड", "क्षुद्रग्रह"], "answer": 3, "explanation": "मंगल एवं बृहस्पति ग्रह की कक्षाओं के बीच कुछ छोटे-छोटे आकाशीय पिण्ड हैं जो सूर्य की परिक्रमा करते रहते हैं, उसे क्षुद्रग्रह कहते हैं। क्षुद्र ग्रहों में धूमकेतु की तरह पूँछ नहीं पाई जाती है। खगोलशास्त्रियों के अनुसार ग्रहों के विस्फोट के फलस्वरूप टूटे टुकड़ों से क्षुद्रग्रह का निर्माण हुआ है। आधकांश क्षुद्रग्रह छोटे हैं, किन्तु कुछ का व्यास 1000 किमी. तक ब डा होता है। क्षुद्रग्रहों मंे सिरस सर्वाधिक चमकीला एवं विशाल है (व्यास 1025 किमी.)। सौरमण्डल के छोर पर बहुत ही छोटे-छोटे पिण्ड विद्यमान हैं जो धूमकेतु या पुच्छल तारे कहलाते हैं। यह सौर तंत्र के स्थायी सदस्य होते हैं। यह हिमशीतित गैस एवं धूल का संग्रह है, जो आकाश में लम्बी चमकदार पूँछ सहित प्रकाश के चमकीले गोले के रूप में दिखाई देते हैं जो सौर्यिक चुम्बकीय क्षेत्र से उत्पन्न विद्युत चुम्बकीय बल एवं सौर्यिक हवाआें के कारण सूर्य के विपरीत दिशा में रहते हैं। अतः विकल्प (b) सही है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "IAS (Pre) 1997 | UPPCS (Mains) G.S.-IInd Paper, 2006", "lang": "hi", "page": 539, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0045", "q": "सूर्य ग्रहण कब होता है", "options": ["चतुर्थांश चन्द्रमा के दिन", "प्रतिपदा", "किसी दिन", "पूर्णिमा को"], "answer": 1, "explanation": "जब चन्द्रमा सूर्य और पृथ्वी के बीच आ जाता है या सूर्य, चन्द्रमा, पृथ्वी के एक ही परिक्रमण तल पर आते हैं तो सूर्य का प्रकाश पृथ्वी पर नहीं पड़ता है इस स्थिति को सूर्य ग्रहण कहते हैं। जब सूर्य और चन्द्रमा के बीच पृथ्वी आ जाती है, तो सूर्य का प्रकाश चन्द्रमा पर नहीं पड़ता है, इस स्थिति को चन्द्रग्रहण कहा जाता है। जब सूर्य तथा चन्द्रमा पृथ्वी के एक ओर सीधी रेखा में होते हैं तो इस स्थिति को युति कहते हैं युति हमेशा अमावस्या (प्रतिपदा) के दिन ही होता है यह स्थिति सूर्य ग्रहण की होती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre.) G.S. 1991", "lang": "hi", "page": 540, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0046", "q": "प्रत्येक सूर्यग्रहण होता है–", "options": ["न ही", "", "Both", "Neither"], "answer": 1, "explanation": "जब चन्द्रमा सूर्य और पृथ्वी के बीच आ जाता है या सूर्य, चन्द्रमा, पृथ्वी के एक ही परिक्रमण तल पर आते हैं तो सूर्य का प्रकाश पृथ्वी पर नहीं पड़ता है इस स्थिति को सूर्य ग्रहण कहते हैं। जब सूर्य और चन्द्रमा के बीच पृथ्वी आ जाती है, तो सूर्य का प्रकाश चन्द्रमा पर नहीं पड़ता है, इस स्थिति को चन्द्रग्रहण कहा जाता है। जब सूर्य तथा चन्द्रमा पृथ्वी के एक ओर सीधी रेखा में होते हैं तो इस स्थिति को युति कहते हैं युति हमेशा अमावस्या (प्रतिपदा) के दिन ही होता है यह स्थिति सूर्य ग्रहण की होती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UP UDA/LDA (Pre) 2006", "lang": "hi", "page": 540, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography", "source_defect": "Options garbled in the original source (correct option b is blank). Kept as-is; please check against the book (UP UDA/LDA Pre 2006, page 540)."}, {"id": "world_geography-0047", "q": "`ब्लू मून' परिघटना होती है–", "options": ["जब एक ही माह में दो पूर्णिमा हों", "जब एक कैलेण्डर वर्ष में दो लगातार माहों में चार पूर्णिमायें हों", "जब एक ही कैलेण्डर वर्ष में तीन बार एक ही माह में दो पूर्णिमायें हों", "उपर्युक्त में से किसी में भी नहीं"], "answer": 0, "explanation": "ब्लू मून वह परिघटना है जब एक ही माह में दो पूर्णिमा हों। यह परिघटना एक सौर वर्ष में 12 चन्द्र माहों से कुछ आधक दिन होने के कारण घटित होती है।", "topic": "ब्रह्माण्ड एवं सौरमंडल", "source": "UPPCS (Pre) G.S. 2009 | UPPCS (Mains) G.S. IInd Paper 2007", "lang": "hi", "page": 541, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0048", "q": "निम्न कथनों पर विचार कीजिए तथा\nनीचे दिए कूट से सही उत्तर चुनिए\n1. पृथ्वी के अक्ष के उत्तरी सिरे को उत्तरी ध्रुव कहते हैं।\n2. 45o अक्षांश की लम्बाई विषुवत रेखा की आधी होती है\n3. पृथ्वी के अक्ष की समान्तरता है।\n4. अपसौर अवस्था में पृथ्वी के परिभ्रमण की गति तीव्र होती है।\nकूटः", "options": ["1 एवं 2", "2 एवं 3", "3 एवं 4", "1 एवं 3"], "answer": 3, "explanation": "पृथ्वी के अक्ष के उत्तरी सिरे को उत्तरी ध्रुव कहते हैं एवं दक्षिणी सिरे को दक्षिणी ध्रुव कहते हैं। 450 अक्षांश रेखा उत्तरी ध्रुव व विषुवतरेखा के बीच की दूरी की आधी है न कि विषुवतरेखा की आधी है। 600 अक्षांश रेखा विषुवत रेखा की आधी है। अपसौर में पृथ्वी और सूर्य के बीच की दूरी आधकतम होती है इसीलिए परिक्रमण की गति कम होती है। पृथ्वी के अक्ष की समान्तरता है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre.) G.S. 2000", "lang": "hi", "page": 544, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0049", "q": "उत्तर कोरिया तथा दक्षिण कोरिया की अंतर्राष्ट्रीय सीमा है-", "options": ["250 उ . अक्षांश", "330 उ . अक्षांश", "380 उ . अक्षांश", "480 अक्षांश"], "answer": 2, "explanation": "380 उत्तरी अक्षांश, उत्तर कोरिया तथा दक्षिण कोरिया के मध्य अंतर्राष्ट्रीय सीमा का निर्धारण करती है। अन्य प्रमुख देशों की सीमा रेखायें निम्न हैं- 49 वीं समानांतर रेखा- अमेरिका तथा कनाडा के मध्य। 1410 पश्चिमी देशांतर रेखा - अलास्का (यू.एस.ए.) तथा कनाडा के मध्य सीमा रेखा। ओडरनीसे रेखा - पूर्व जर्मनी और पोलैण्ड के मध्य सीमा रेखा।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Mains) G.S. Ist Paper, 2005", "lang": "hi", "page": 545, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0050", "q": "निम्न अक्षांशों ( उत्तरी अथवा दक्षिणी ) में से किसे आप “हॉर्स अक्षांश” से सम्बद्ध करेंगे?", "options": ["300", "450", "600", "23 1/ 0 2"], "answer": 0, "explanation": "दोनों गोलार्द्धों में 300 उत्तरी से 350 उत्तरी तथा 300 दक्षिणी से 350 दक्षिणी अक्षाशों के मध्य उपोष्ण कटिबन्धीय उच्च वायुदाब पाया जाता है। इस पेटी को अश्व अक्षांश भी (Hors latitude) कहा जाता है। अन्य महत्वपूर्ण तथ्य - • उपोष्ण उच्च वायु दाब पेटी में शीतकाल के दो महीनों को छोड़कर वर्ष भर ऊँचा तापमान रहता है। • उपोष्ण उच्च वायुदाब पेटी का दाब तापमान से संबधित न होकर पृथ्वी की दैनिक गति तथा वायु के अवतलन से संबधित है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP Lower (Pre) Spl. 2008", "lang": "hi", "page": 546, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0051", "q": "किसी जहाज को सबसे कम समय में एक स्थान से दूसरे स्थान तक जाने के लिये निम्न में से किसे मार्ग बनाना चाहिए–", "options": ["समुद्री धारा", "समुद्री हवा", "देशांतर", "अक्षांश"], "answer": 2, "explanation": "किसी जहाज को एक स्थान से दूसरे स्थान तक कम समय में पहुँचने के लिए यात्रा देशांतर के सापेक्ष करनी होगी। 180 देशांतर पर पूरब से पश्चिम जाने पर एक दिन कम हो जाता है और पश्चिम से पूरब जाने पर एक दिन बढ़ जाता है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre.) G.S. 1992", "lang": "hi", "page": 547, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0052", "q": "निम्न में से कौन देशान्तर प्रधान याम्योत्तर के साथ ग्लोब पर वृहत-वृत्त का निर्माण करता है?", "options": ["0o", "90o पूर्व", "90o पश्चिम", "180o"], "answer": 3, "explanation": "180o देशान्तर और 0o देंशान्तर को एक साथ मिलाने पर वृहत-वृत्त का निर्माण होता है। 0o देशान्तर को प्रधान याम्योत्तर भी कहते हैं। 0o अक्षांश या विषुवत रेखा भी एक वृहत्त वृत्त है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre.) G.S. 2000", "lang": "hi", "page": 547, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0053", "q": "प्रधान याम्योत्तर गुजरती है\n1. अल्जीरिया से\n2. फ्रांस से\n3. नाइजीरिया से\n4. पुर्तगाल से सही उत्तर के चयन हेतु\nनीचे दिये गये कूट का प्रयोग कीजियेः\nकूटः", "options": ["1 एवं 2", "2 एवं 3", "3 एवं 4", "1 एवं 3"], "answer": 0, "explanation": "प्रधान याम्योत्तर रेखा ग्रेट बि्रटेन, फ्रांस, स्पे न, अल्जीरिया, माली, बुर्किना फासो, घाना और टोगो से गुजरती है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Main) Spl. G.S. Ist Paper 2008", "lang": "hi", "page": 547, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0054", "q": "प्रधान याम्योत्तर नहीं गुजरती है", "options": ["अल्जीरिया से", "फ्रांस से", "नाइजर से", "स्पेन से"], "answer": 2, "explanation": "प्रधान याम्योत्तर रेखा ग्रेट बि्रटेन, फ्रांस, स्पे न, अल्जीरिया, माली, बुर्किना फासो, घाना और टोगो से गुजरती है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP UDA/LDA (M) 2010", "lang": "hi", "page": 547, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0055", "q": "कथन\n(A) सभी देशांतर रेखायें वृहत् वृत्त होती हैं।\nकारण (R) वृहत् वृत्त ग्लो ब को दो समान भागों में वभा जत करता है। नीचे दिय गये कूट से सही उत्तर चु नए-\nकूटः", "options": ["(A) तथा (R) दोनों सत्य हैं तथा (R) (A) की सही व्याख्या है।", "(A) तथा (R) दोनों सत्य हैं परन्तु (R) (A) की सही व्याख्या नहीं है।", "(A) सत्य है परन्तु (R) असत्य है।", "(A) असत्य है परन्तु (R) सत्य है।"], "answer": 0, "explanation": "सभी देशान्तर रेखायें वृहत-वृत होती हैं क्योंकि वृहत् वृत ग्लोब को दो बराबर भागों में विभाजित करता है। दो देशान्तरों के बीच की दूरी भूमध्य रेखा पर सर्वाधिक 111 . 32 किमी. होती है तथा ध्रुवों पर यह न्यूनतम (श्ूान्य) होती है। देशान्तर रेखाआें के आतरिक्त 0º अक्षांश रेखा (विषुवत रेखा) भी वृहद वृत का निर्माण करती है। अतः कथन (A) और कारण (R) दोनों सत्य हैं तथा (R), (A) की सही व्याख्या कर रहा है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "U.P.P.C.S. (Pre) G.S. 2002", "lang": "hi", "page": 547, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0056", "q": "निम्नलिखित में किस देश से होकर भूमध्य रेखा नहीं गुजरती है?", "options": ["केन्या", "युगांडा", "गैबोन", "जाम्बिया"], "answer": 3, "explanation": "जाम्बिया से भूमध्य रेखा नही गुजरती है। भूमध्य रेखा कुल 13 देशों से होकर गुजरती है जो इस प्रकार हैं– इक्वेडोर, कोलम्बिया, ब्राजील, गैबोन, कांगो, कांगो लोकतांत्रिक गणराज्य, युगाण्डा, केन्या, सोमालिया, मालदीव, इंडोनेशिया, किरिबाती, साओटोम और प्रिंसिपे।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPSC GIC Lecturer 2021", "lang": "hi", "page": 549, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0057", "q": "निम्नलिखित में से किन देशों से होकर भूमध्य रेखा नहीं गुजरती है?\n1. गैबन\n2. सोमालिया\n3. भूमध्य रेखीय गिनी\n4. रवाण्डा\nनीचे दिये गये कूट से सही उत्तर चुनिए। कूट", "options": ["1 और 4", "2 और 4", "2 और 3", "3 और 4"], "answer": 3, "explanation": "जाम्बिया से भूमध्य रेखा नही गुजरती है। भूमध्य रेखा कुल 13 देशों से होकर गुजरती है जो इस प्रकार हैं– इक्वेडोर, कोलम्बिया, ब्राजील, गैबोन, कांगो, कांगो लोकतांत्रिक गणराज्य, युगाण्डा, केन्या, सोमालिया, मालदीव, इंडोनेशिया, किरिबाती, साओटोम और प्रिंसिपे।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP PSC (Pre) 2020", "lang": "hi", "page": 549, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0058", "q": "भूमध्य रेखा गुजरती है", "options": ["कैमरून से", "कोस्टारिका से", "केन्या से", "वेनेजुएला से"], "answer": 2, "explanation": "जाम्बिया से भूमध्य रेखा नही गुजरती है। भूमध्य रेखा कुल 13 देशों से होकर गुजरती है जो इस प्रकार हैं– इक्वेडोर, कोलम्बिया, ब्राजील, गैबोन, कांगो, कांगो लोकतांत्रिक गणराज्य, युगाण्डा, केन्या, सोमालिया, मालदीव, इंडोनेशिया, किरिबाती, साओटोम और प्रिंसिपे।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. 2008 | UPPCS (Mains) G.S. Ist Paper 2007", "lang": "hi", "page": 550, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0059", "q": "निम्नलिखित देशों में से कौन भूमध्य रेखा पर अवस्थित है?\n1. ब्रूनई\n2. कोलम्बिया\n3. केन्या\n4. वेनेजुएला\nनीचे दिए गये कूट की सहायता से सही उत्तर चुनियेः\nकूटः", "options": ["1 एवं 2", "2 एवं 3", "3 एवं 4", "1 एवं 4"], "answer": 1, "explanation": "जाम्बिया से भूमध्य रेखा नही गुजरती है। भूमध्य रेखा कुल 13 देशों से होकर गुजरती है जो इस प्रकार हैं– इक्वेडोर, कोलम्बिया, ब्राजील, गैबोन, कांगो, कांगो लोकतांत्रिक गणराज्य, युगाण्डा, केन्या, सोमालिया, मालदीव, इंडोनेशिया, किरिबाती, साओटोम और प्रिंसिपे।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) GS, 2010", "lang": "hi", "page": 550, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0060", "q": "निम्नलिखित नदियों में से कौन-सी वषुवत् रेखा को दो बार पार करती है?", "options": ["जायरे", "नाइजर", "नील", "अमेजन"], "answer": 0, "explanation": "अप्रीका की कांगो/जायरे मध्य अप्रीका में बहते हुए विषुवत रेखा को दो बार पार करती है। यह नदी अफ्रीकी उच्च भूमि से निकलकर अटलांटिक महासागर में जाकर मिल जाती है। कांगो और कसाई नदी जायरे की सहायक नदी है। स्टैनली और लिविंग स्टोन जलप्रपात इस नदी पर स्थित प्रमुख जलप्रपात हैं।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP Lower (Pre) 2015", "lang": "hi", "page": 550, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0061", "q": "प्रधान याम्योत्तर ( ध्रुववृत्तीय ) तथा विषुवत ( भूमध्य ) रेखा का प्रतिच्छेदन बिन्दु अवस्थित है", "options": ["अंध महासागर में", "घाना में", "मोरक्को में", "प्रशान्त महासागर में"], "answer": 0, "explanation": "प्रधान याम्योत्तर तथा विषुवत रेखा एक-दूसरे को अटलांटिक महासागर या अंध महासागर में काटती हैं।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP Lower (Pre) 2009", "lang": "hi", "page": 550, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0062", "q": "वह कौन-सी तिथि तिथियाँ हैं, जब दोनों गोलार्द्धों में दिन और रात बराबर होते हैं?", "options": ["21 जून", "22 दिसंबर", "21 मार्च व 23 सितंबर", "21 जून एवं 22 दिसंबर"], "answer": 2, "explanation": "विषुवत रेखा ( 00 अक्षांश) पृथ्वी को दो बराबर भागों में बाँटती है। इसके उत्तर में स्थित भाग को उत्तरी गोलार्द्ध तथा दक्षिण में स्थित भाग को दक्षिणी गोलार्द्ध कहते हैं। 21 मार्च एवं 23 सितम्बर को सूर्य विषुवत् रेखा पर लम्बवत् चमकता है तथा इन दोनों तिथियों को पूरे ग्लोब पर दिन एवं रात की अवधि बराबर होती है। इसे विषुव (इक्वीनॉक्स) कहते हैं। जैसे-जैसे सूर्य कर्क और मकर रेखा की ओर बढ़ता है, दिन-रात की अवधि में अन्तर स्पष्ट होता है। इसमें 21 मार्च वाले विषुव को बसन्त विषुव तथा 23 सितम्बर वाले विषुव को शरद विषुव कहते हैं। ध्यातव्य है कि सूर्य 21 जून को कर्क रेखा (उत्तरी गोलार्द्ध में स्थित) पर लम्बवत् चमकता है, जिसे ‘उत्तरी अयनांत’ या ‘कर्क संक्रान्ति’ कहते हैं तथा 22 दिसम्बर को सूर्य मकर रेखा (दक्षिणी गोलार्द्ध मंे स्थित) पर लम्बवत् चमकता है जिसे ‘दक्षिण अयनांत’ या ‘मकर संक्रान्ति’ कहते हैं। अतः कथन ( 1 ) एवं ( 3 ) सही हैं।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. 2004", "lang": "hi", "page": 552, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0063", "q": "इक्वीनॉक्स वर्ष के दो काल, जब दिन और रात बराबर होते हैं होता है ─", "options": ["21 मार्च और 23 सितम्बर को", "22 फरवरी और 23 अगस्त को", "15 अक्टूबर और 23 अप्रैल को", "22 जुलाई और 22 दिसंबर को"], "answer": 0, "explanation": "विषुवत रेखा ( 00 अक्षांश) पृथ्वी को दो बराबर भागों में बाँटती है। इसके उत्तर में स्थित भाग को उत्तरी गोलार्द्ध तथा दक्षिण में स्थित भाग को दक्षिणी गोलार्द्ध कहते हैं। 21 मार्च एवं 23 सितम्बर को सूर्य विषुवत् रेखा पर लम्बवत् चमकता है तथा इन दोनों तिथियों को पूरे ग्लोब पर दिन एवं रात की अवधि बराबर होती है। इसे विषुव (इक्वीनॉक्स) कहते हैं। जैसे-जैसे सूर्य कर्क और मकर रेखा की ओर बढ़ता है, दिन-रात की अवधि में अन्तर स्पष्ट होता है। इसमें 21 मार्च वाले विषुव को बसन्त विषुव तथा 23 सितम्बर वाले विषुव को शरद विषुव कहते हैं। ध्यातव्य है कि सूर्य 21 जून को कर्क रेखा (उत्तरी गोलार्द्ध में स्थित) पर लम्बवत् चमकता है, जिसे ‘उत्तरी अयनांत’ या ‘कर्क संक्रान्ति’ कहते हैं तथा 22 दिसम्बर को सूर्य मकर रेखा (दक्षिणी गोलार्द्ध मंे स्थित) पर लम्बवत् चमकता है जिसे ‘दक्षिण अयनांत’ या ‘मकर संक्रान्ति’ कहते हैं। अतः कथन ( 1 ) एवं ( 3 ) सही हैं।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. 1994 | UP Lower (Pre) Spl. 2004 | MPPSC (Pre) G.S. 1992", "lang": "hi", "page": 552, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0064", "q": "उत्तरी गोलार्द्ध में कर्क संक्रान्ति के समय 12 घण्टे का दिन होगा ─", "options": ["कर्क रेखा पर", "मकर रेखा पर", "आर्कटिक वृत्त पर", "विषुवत रेखा पर"], "answer": 3, "explanation": "विषुवत् रेखा पर सम्पूर्ण वर्ष ( कर्क एवं मकर संक्रांति सहित ) दिन-रात 12-12 घण्टे का बराबर होता है। जब सूर्य विषुवत् रेखा को पार करते हुए कर्क रेखा की ओर ब ढता है, उसे कर्क संक्रांति कहते हैं। यह संक्रांति जून माह में प डता है। इस दौरान विषुवत् रेखा पर दिन-रात बराबर होते हैं।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre.) G.S. 1997", "lang": "hi", "page": 553, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0065", "q": "कर्क रेखा नहीं गुजरती है", "options": ["भारत से", "मैक्सिको से", "ईरान से", "मिस्र से"], "answer": 2, "explanation": "कर्क रेखा भारत, मैक्सिको तथा मिस्र से गुजरती है जबकि ईरान से यह नही गुजरती है। कर्क रेखा पर अवस्थित देश - हवाई द्वीप, मैक्सिको (उत्तरी अमेरिका), मिस्र, लीबिया, नाइजर, अल्जीरिया, माली, चाड, प. सहारा, मॉरिटानिया (अफ्रीका), ताइवान, चीन, म्यांमार, बांग्लादेश, भारत, ओमान, संयुक्त अरब अमीरात, सऊदी अरब (एशिया)।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. Spl. 2004", "lang": "hi", "page": 554, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0066", "q": "निम्नलिखित तिथियों में से किसमें दोपहर को आपकी छाया सबसे छोटी होती है", "options": ["दिसम्बर 25", "मार्च 21", "जून 21", "फरवरी 14"], "answer": 2, "explanation": "21 जून की दोपहर को आपकी छाया सबसे छोटी होती है क्योंकि इस समय सूर्य कर्क रेखा पर लम्बवत् चमकता है। जब सूर्य कर्क रेखा पर लम्बवत चमकता है तो इस समय भूमध्य रेखा से उत्तर की ओर दिन की अवधि बढ़ती जाती है, उत्तरी ध्रुव पर 6 महीने का दिन होता है। इसके विपरीत भूमध्य रेखा से दक्षिण जाने पर दिन की लम्बाई कम होती जाती है। दक्षिणी ध्रुव पर 6 महीने की रात होती है। 21 जून को उत्तरी गोलार्द्ध में सबसे लम्बा दिन होता है तथा 22 दिसम्बर को दक्षिणी गोलार्द्ध में सबसे लम्बा दिन होता है। 21 मार्च एवं 23 सितम्बर को, जब सूर्य विषुवत रेखा पर लम्बवत चमकता है तो सर्वत्र दिन एवं रात बराबर होते हैं।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. 2006", "lang": "hi", "page": 554, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0067", "q": "किस तारीख को सबसे बड़ा दिन होगा", "options": ["22 जुलाई", "25 दिसम्बर", "21 जून", "23 मार्च"], "answer": 2, "explanation": "उत्तरी गोलार्द्ध में 21 जून को सबसे बड़ा दिन व 22 दिसबर को सबसे छोटा दिन होता है। इसके ठीक विपरीत दक्षिणी गोलार्द्ध मे 22 दिसंबर को सबसे ब डा दिन व 21 जून को सबसे छोटा दिन होता है। 21 जून को कर्क संक्रान्ति या ग्रीष्म अयनान्त तथा 22 दिसंबर को मकर संक्रान्ति या शीत अयनान्त कहा जाता है। 21 मार्च व 23 सितम्बर को विषुव (Equinox) के चलते सम्पूर्ण पृथ्वी पर 12- 12 घंटे का दिन व रात होता है। प्रश्न में गोलार्द्धों का जिक्र न करने से किसी विकल्प का चयन नहीं किया जा सकता है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. 1992", "lang": "hi", "page": 554, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0068", "q": "मकर रेखा नहीं गुजरती है–", "options": ["बोलीविया से", "पराग्वे से", "अर्जेन्टीना से", "ब्राजील से"], "answer": 0, "explanation": "बोलीविया, पराग्वे, अर्जेन्टीना तथा ब्राजील देश दक्षिण अमेरिका महाद्वीप में स्थित हैं जिसमें से बोलीविया से मकर रेखा नहीं गुजरती है। मकर रेखा दक्षिणी गोलार्द्ध में भूमध्य रेखा के समानान्तर 23.5° दक्षिणी अक्षांश पर ग्लोब पर पश्चिम से पूरब की ओर खींची गई एक काल्पनिक रेखा है। इस रेखा पर स्थित देश निम्नलिखित हैं-ब्राजील, पराग्वे, अर्जेन्टीना, चिली, ऑस्ट्रेलिया, मेडागॉस्कर, मोजाम्बिक, दक्षिण अफ्रीका, बोत्सवाना और नामीबिया। ज्ञातव्य है कि विषुवत् रेखा एवं मकर रेखा दोनों ब्राजील से होकर गुजरती हैं।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP Lower (Pre) G.S. 1998", "lang": "hi", "page": 555, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0069", "q": "मकर संक्रान्ति के समय कर्क रेखा पर दोपहर के सूर्य का उन्नतांश होता है ─", "options": ["23.5o", "43.0o", "47.0o", "66.5o"], "answer": 1, "explanation": "22 दिसम्बर को मकर संक्रांति होती है उस समय मकर रेखा पर सूर्य की किरणें लंबवत् पड़ती हैं। जिससे दक्षिणी गोलार्द्ध में दिन की अवधि लम्बी होती है। चूँकि पृथ्वी अपने अक्ष पर 23½0 झुकी हुई है, इसलिए मकर रेखा पर जब 900 सूर्य का उन्नतांश कोण होगा, ठीक इसी समय कर्क रेखा पर 900 – 470 430 कोण बनेगा। मकर रेखा से कर्क रेखा के मध्य अंतर 23½ ° + 23½ ° = 470। F. मानक समय (Standard Time) मानक समय - • 0º देशान्तर रेखा को मानक समय या ग्रीनविच रेखा भी कहा जाता है। जो इंग्लैण्ड के ग्रीनविच शहर से होकर गुजरती है। • ग्रीनविच रेखा और विषुवत रेखा दोनों एक दूसरे से अटलांटिक महासागर में मिलती हैं। मानक समय (0º देशान्तर ) पर स्थित देश- • इंग्लैण्ड, फ्रांस, स्पेन, अल्जीरिया, माली, बुर्किना फांसो, टोंगो तथा घाना।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre.) G.S. 1997", "lang": "hi", "page": 556, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0070", "q": "जब ग्रीनविच में मध्याह्न है, एक जगह का स्थानीय समय 5 बजे सायं है। निम्नांकित में वह कौन सा याम्योत्तर है, जिस पर उपर्युक्त जगह अवस्थित है?", "options": ["750 E/750 पू", "750 W/750 प", "1500 E/1500 पू", "1500 W/1500 प"], "answer": 0, "explanation": "ग्रीनविच में मध्याह्न हैं, 75º पू. का स्थानीय समय है – 5 बजे सायं होगा। 00 देशांतर पर 12 बजे हैं, दिया गया स्थानीय समय इससे 5 घण्टे आगे है। अतः यह स्थान पूर्व में स्थित होगा। चूंकि 150 देशांतर = 1 घण्टा ∴ 750 देशान्तर = 5 घण्टा", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS Spl, (Pre) G.S. 2008", "lang": "hi", "page": 557, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0071", "q": "किसी जगह का स्थानीय समय 6.00 प्रातः है जबकि ग्रीनविच मीन टाइम (G.M.T.) 3.00 प्रातः है। उस जगह की देशान्तर रेखा क्या होगी?", "options": ["450 पश्चिम", "450 पूर्व", "1200 पूर्व", "1200 पश्चिम"], "answer": 1, "explanation": "किसी जगह का स्थानीय समय 6.00 प्रातः है जबकि ग्रीनविच मीन टाइम ( जी . एम . टी ) 3.00 प्रातः है। उस जगह की देशान्तर रेखा 450 पूर्व होगी, क्योंकि 15° देशान्तर रेखाआें का अंतर 1 घंटा होता है। 3 घंटे आधक होने के कारण इसकी दिशा पूर्व में और स्थिति 45° देशांतर होगी।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. 2006", "lang": "hi", "page": 557, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0072", "q": "कथन (S) तिथि निर्धारक रेखा पर ग्रीनविच से 12 घंटे का अंतर है।\nकारण (R) तिथि निर्धारक रेखा 180 डिग्री देशांतर पर स्थित है।", "options": ["S, R दोनों सत्य हैं, और R, S की व्याख्या करता है", "S और R सत्य हैं, R, S की व्याख्या नहीं करता है", "S सत्य है, R असत्य है", "R सत्य है, S असत्य है"], "answer": 0, "explanation": "अंतर्राष्ट्रीय तिथि रेखा 180° देशान्तर से होकर गुजरती है जबकि ग्रीनविच शून्य डिग्री देशांतर पर स्थित है। अतः दोनों में 1800 का अंतर है। चूँकि 40 = 1 मिनट ∴ 1800 = 1800 × 4 = 720 मिनट = 12 घण्टे अतः कथन (S) तथा कारण (R) दोनों सत्य हैं तथा कारण (R), कथन (S) की सही व्याख्या कर रहा है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre) G.S. 1992", "lang": "hi", "page": 557, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0073", "q": "10 यदि इंग्लैण्ड में एक क्रिकेट कमेन्ट्री 10 बजे पूर्वाह्न ( जी एम टी .) से शुरू होती है, तो उसे भारत में भारतीय समयानुसार कितने बजे से सुनी जा सकती है?", "options": ["10: 10 बजे पूर्वाह्न से", "4: 30 बजे पूर्वाह्न से", "3: 30 बजे अपराह्न से", "2: 30 बजे अपराह्न से"], "answer": 2, "explanation": "इंग्लैण्ड में क्रिकेट कमेन्ट्री का प्रारम्भ = 10 बजे 1 0 पूर्वाह्न या 10 बजे सुबह भारत, पूर्वी देशान्तर 82 पर 2 अवस्थित है तो समय को एक देशांतर खिसकने में 4 मिनट का समय लगता है 1 0 1 82 × 4 = 5 घण्टा 2 2 अतः भारत में यह 3: 30 बजे अपराह्न सुनी जायेगी।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP UDA/LDA Spl. (Pre) 2010", "lang": "hi", "page": 557, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0074", "q": "भूमध्य रेखा, कर्क रेखा और मकर रेखा तीनों निम्न में से किस एक महाद्वीप से गुजरते हैं?", "options": ["अफ्रीका", "एशिया", "उत्तरी अमेरिका", "दक्षिण अमेरिका"], "answer": 0, "explanation": "अफ्रीका महाद्वीप विश्व का एकमात्र महाद्वीप है जिसका विस्तार सभी गोलार्द्धो में है। इस महाद्वीप से भूमध्य रेखा ( विषुवत रेखा ) कर्क रेखा और मकर रेखा तीनों गुजरती हैं। इस महाद्वीप में कर्क रेखा इसके उत्तरी भाग ( प . सहारा, मॉरिटानिया, माली, अल्जीरिया, लीबिया, एवं मिस्र ) से गुजरती है। मकर रेखा नामीबिया, बोत्सवाना, द . अफ्रीका, मोजाम्बिक एवं मेडागास्कर से होकर गुजरती है तथा विषुवत रेखा गैबोन, कांगो, कांगो गणराज्य, युगांडा, केन्या एवं सोमालिया से होकर गुजरती है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Mains) Spl. G.S. 2004 | CAPF (AC) Paper-I, 2009", "lang": "hi", "page": 561, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0075", "q": "निम्नलिखित में से कौन सा देश आर्कटिक वृत्त के दक्षिण में पाया जाता है?", "options": ["फिनलैण्ड", "आइसलैण्ड", "नार्वे", "स्वीडन"], "answer": 1, "explanation": "आइसलैण्ड देश आर्कटिक वृत्त के दक्षिण में स्थित है। अन्य तीनों देश फिनलैण्ड, नार्वे तथा स्वीडन से आर्कटिक वृत्त गुजरता है।", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UP RO/ARO (Pre) 2013", "lang": "hi", "page": 562, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0076", "q": "निम्नलिखित में से कौन-सा कथन सही नहीं है?", "options": ["जलवाष्प निचले वायुमण्डल की आत परिवर्ती गैस है", "आधकतम तापमान की मेखला विषुवत रेखा के सहारे पायी जाती है", "शीत कटिबन्ध उभय गोलार्द्धों ध्रुवीय वृत्त एवं ध्रुवों के बीच उपस्थित है", "जेट वायुधाराएँ अत्यधिक ऊँचाई की हवाएँ हैं जो धरातलीय मौसमी दशाओं को प्रभावित करती हैं"], "answer": 1, "explanation": "पृथ्वी पर आधकतम तापमान विषुवत रेखा पर नहीं पाया जाता बल्कि यह कर्क एवं मकर रेखाआें पर पाया जाता है क्योंकि विषुवत रेखीय क्षेत्रों में मेघों ( बादल ) की उपस्थिति सघन होती है और ये प्रकाश के अच्छे परावर्तक होते हैं। जबकि अयनवर्ती क्षेत्र में मौसम साफ रहता है जिससे प्रकाश का अवशोषण आधकतम होता है। जलवाष्प निचले वायुमण्डल की आत परिवर्ती गैस है। शीत कटिबन्ध उभय गोलार्द्धों अर्थात् धु्रवीय वृत एवं ध्रुवों के बीच उपस्थित है। जेट वायुधाराएँ अत्यधिक उँचाई की हवाएँ हैं जो धरातलीय मौसमी दशाआें को प्रभावित करती हैं। अतः विकल्प (b) सही नहीं है। 03 महाद्वीप, देश, CAPITAL A. महाद्वीप (The Continents) महाद्वीप क्षेत्रफल (वर्ग किमी. में) एशिया 44579000 अफ्रीका 30065000 उत्तरी अमेरिका 24256000 दक्षिणी अमेरिका 17819000 अंटार्कटिका 13209000 यूरोप 9938000 ऑस्ट्रेलिया 7688287 एशिया महाद्वीप • यह विश्व का सबसे बड़ा महाद्वीप है। • विश्व में सर्वाधिक वर्षा वाला स्थान - मॉसिनराम • विश्व का सबसे उँचा पर्वत शिखर - माउण्ट एवरेस्ट • एशिया की सबसे बड़ी नदी- याग्त्सी क्यांग • विश्व का सबसे बड़ा प्रायद्वीप - अरब प्रायद्वीप • विश्व की सबसे बड़ी झील - कैस्पियन सागर • विश्व की सबसे गहरी झील - बैकाल झील • विश्व का सबसे …", "topic": "अक्षांश एवं देशान्तर रेखाएँ", "source": "UPPCS (Pre.) G.S. 2002", "lang": "hi", "page": 565, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0077", "q": "निम्न में से किस महाद्वीप में सबसे आधक देश है?", "options": ["यूरोप", "एशिया", "अफ्रीका", "उत्तरी अमेरिका", "उपर्युक्त मेें से कोई नहीं/उपर्युक्त में से एक से आधक"], "answer": 2, "explanation": "विश्व में कुल सात महाद्वीप हैं, जो क्षेत्रफल के अनुसार इस प्रकार हैं– एशिया > अफ्रीका > उत्तरी अमेरिका > दक्षिणी अमेरिका > अंटार्कटिका > यूरोप > ऑस्ट्रेलिया। सबसे आधक देश अफ्रीका महाद्वीप में है। जहाँ देशों की कुल संख्या 54 है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "66th BPSC (Pre) 2020 | UPPCS (Mains) 1st Paper GS, 2015", "lang": "hi", "page": 567, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0078", "q": "निम्नलिखित में से कौन-सा देश अफ्रीका महाद्वीप में अवस्थित नहीं है?", "options": ["गैबोन", "गुयाना", "गिनी", "गिनी बिस्साऊ"], "answer": 1, "explanation": "‘गुयाना’ दक्षिण अमेरिका के उत्तर-मध्य में स्थित है। इसकी राजधानी जार्ज टाउन है। गैबोन, गनी व गिनी बिसाऊ अफ्रीका महाद्वीप के देश हैं। गैबोन की राजधानी लिबे्रविल्ले, गिनी की राजधानी कोनाक्री व गिनी बिस्साऊ की राजधानी बिस्साऊ है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC ACF/RFO (M) 2020 (Paper-Ist) | UPPCS (Mains) 2017 | ACF/RFO (Mins) 1st 2018", "lang": "hi", "page": 567, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0079", "q": "निम्नलिखित देशों में कौन-सा क्षेत्रफल की दृष्टि से अफ्रीका महाद्वीप का सबसे बड़ा देश है?", "options": ["कांगो लोकतांत्रिक गणराज्य", "चाड", "अल्जीरिया", "नाइजीरिया"], "answer": 2, "explanation": "अफ्रीका महाद्वीप क्षेत्रफल की दृष्टि से एशिया के बाद दूसरा सबसे बड़ा महाद्वीप है। इस महाद्वीप में क्षेत्रफल की दृष्टि से सबसे बड़ा देश अल्जीरिया और सबसे छोटा देश सेशेल्स है। अफ्रीका का मुख्य क्षेत्र आम तौर से ‘सब-सहारा’ कहलाता है। नाइजीरिया अप्रीका का सबसे आधक जनसंख्या वाला देश है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC ACF/RFO (M) 2020 (Paper-Ist)", "lang": "hi", "page": 567, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0080", "q": "निम्नलिखित देशों में कौन अफ्रीका के पश्चिमी तट पर नहीं स्थित है?", "options": ["गैबोन", "बोत्सवाना", "लाइबेरिया", "अंगोला"], "answer": 1, "explanation": "अफ्रीका के पश्चिमी तट पर गैबोन, लाइबेरिया, अंगोला स्थित है जबकि बोत्सवाना अफ्रीका के दक्षिणी भाग के मध्य में स्थित एक स्थलबद्ध देश है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC RO/ARO (Re-exam) 2016", "lang": "hi", "page": 568, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0081", "q": "निम्नलिखित में कौन महाद्वीपों के क्षेत्रफल का सही अनुक्रम ( अवरोही क्रम में ) प्रस्तुत करता है", "options": ["एशिया, अफ्रीका, उत्तरी अमेरिका, यूरोप", "अफ्रीका, एशिया, यूरोप, उत्तरी अमेरिका", "उत्तरी अमेरिका, अफ्रीका, एशिया, यूरोप", "उत्तरी अमेरिका, एशिया, अफ्रीका, यूरोप"], "answer": 0, "explanation": "महाद्वीपों के क्षेत्रफल का सही अवरोही क्रम इस प्रकार हैं - एशिया (44579000 वर्ग किमी .), अफ्रीका (30065000 वर्ग किमी .), उत्तरी अमेरिका (24256000 वर्ग किमी .) तथा यूरोप 9938000 वर्ग किमी .)। अतः विकल्प (a) सही है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains)-2017", "lang": "hi", "page": 568, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0082", "q": "निम्न में सबसे छोटा महाद्वीप कौन है", "options": ["अंटार्कटिका", "एशिया", "यूरोप", "ऑस्ट्रेलिया"], "answer": 3, "explanation": "विश्व का सबसे छोटा महाद्वीप ऑस्ट्रेलिया महाद्वीप है। सबसे बड़ा महाद्वीप एशिया महाद्वीप है। इसके बाद क्रमशः अफ्रीका, उत्तरी अमेरिका, दक्षिणी अमेरिका, अंटार्कटिका, यूरोप और ऑस्ट्रेलिया का स्थान है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre.) G.S. 1992", "lang": "hi", "page": 568, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0083", "q": "विश्व के दो सबसे छोटे महाद्वीप हैं", "options": ["ऑस्ट्रेलिया और अंटार्कटिका", "अंटार्कटिका और यूरोप", "ऑस्ट्रेलिया और यूरोप", "ऑस्ट्रेलिया और दक्षिण अमेरिका"], "answer": 2, "explanation": "विश्व का सबसे छोटा महाद्वीप ऑस्ट्रेलिया महाद्वीप है। सबसे बड़ा महाद्वीप एशिया महाद्वीप है। इसके बाद क्रमशः अफ्रीका, उत्तरी अमेरिका, दक्षिणी अमेरिका, अंटार्कटिका, यूरोप और ऑस्ट्रेलिया का स्थान है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS Spl, (Pre) G.S. 2008", "lang": "hi", "page": 568, "repeat_flag": true, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0084", "q": "निम्नलिखित में से किस एक महाद्वीप में उसके सम्पूर्ण क्षेत्रफल में मैदानी भाग का प्रतिशत सर्वाधिक है?", "options": ["एशिया", "यूरोप", "उत्तरी अमेरिका", "दक्षिणी अमेरिका"], "answer": 1, "explanation": "क्षेत्रफल की दृष्टि से सात महाद्वीपों में यूरोप का छठा स्थान है। इसका कुल क्षेत्रफल 9938000 (विश्व के भू-क्षेत्र का 6. 8 प्रतिशत) वर्ग किमी. है। इस महाद्वीप के सर्वाधिक क्षेत्रफल में (67%) मैदान का विस्तार पाया जाता है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains) G.S. Ist Paper 2013", "lang": "hi", "page": 568, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0085", "q": "निम्नलिखित महाद्वीपों में से किसमें कोई स्थल-रुद्ध राज्य नहीं है?", "options": ["अफ्रीका", "एशिया", "यूरोप", "उत्तरी अमेरिका"], "answer": 3, "explanation": "उत्तरी अमेरिका महाद्वीप में कोई स्थल-रुद्ध राज्य नहीं है। यह महाद्वीप संपूर्ण स्थल खंड के लगभग 16.2 भू-भाग पर फैला हुआ है एवं विश्व का तीसरा सबसे बड़ा महाद्वीप है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains) G.S. Ist Paper, 2005", "lang": "hi", "page": 568, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0086", "q": "पृथ्वी के कुल भूमिक्षेत्र की अपनी-अपनी प्रतिशतता के अवरोही क्रम में\nनीचे दिए गए महाद्वीपों का सही अनुक्रम कौन-सा है?", "options": ["उत्तरी अमेरिका अफ्रीका दक्षिणी अमेरिका यूरोप", "अफ्रीका उत्तरी अमेरिका दक्षिणी अमेरिका यूरोप", "उत्तरी अमेरिका अफ्रीका यूरोप दक्षिणी अमेरिका", "अफ्रीका उत्तरी अमेरिका यूरोप दक्षिणी अमेरिका"], "answer": 1, "explanation": "पृथ्वी के कुल भूमिक्षेत्र की प्रतिशतता के अनुसार महाद्वीपों का अवरोही क्रम इस प्रकार हैं – अफ्रीका ( 20 . 3 ), उत्तरी अमेरिका ( 16 . 2 ), दक्षिणी अमेरिका ( 11 . 9 ), यूरोप ( 6 . 8 )।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "IAS (Pre) 2005 | UPPCS (Mains) Ist Paper G.S 2015", "lang": "hi", "page": 569, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0087", "q": "निम्नलिखित में से कौन-सा/से देश अरब प्रायद्वीप का हिस्सा नहीं है/हैं?\n1. /ओमान\n2. /इराक\n3. /कुवैत\n4. /सीरिया\nनीचे दिए गए कूट में से सही उत्तर का चयन कीजिए − कूट −", "options": ["2 और 4 दोनों", "2 और 3 दोनों", "केवल 4", "केवल 1"], "answer": 0, "explanation": "सीरिया एवं इराक अरब प्रायद्वीप का हिस्सा नहीं है। अरब प्रायद्वीप विश्व का सबसे ब डा प्रायद्वीप है। यह अफ्रीका और एशिया के मध्य दक्षिण-पश्चिम एशिया में स्थित एक प्रायद्वीप है जो मुख्य रूप से रेगिस्तान से बना है। इस प्रायद्वीप के अन्तर्गत सऊदी अरब, कुवैत, बहरीन, कतर, यूएई, ओमान तथा यमन देश आते हैं।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS RO/ARO (Pre) 2023 (Cancelled)", "lang": "hi", "page": 570, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0088", "q": "निम्नलिखित में से कौन सा सुमेलित नहीं है? ( भाषा ) ( देश )", "options": ["डेनिश डेनमार्क", "डच नीदरलैंड", "मंदारिन चीन", "बहासा थाईलैंड"], "answer": 3, "explanation": "सही सुमेलित युग्म इस प्रकार हैं– (भाषा) (देश) डेनिश – डेनमार्क डच – नीदरलैण्ड मंदारिन – चीन थाई – थाईलैण्ड • ध्यातव्य है कि बहासा, इण्डोनेशिया की आधिकारिक भाषा है। अतः विकल्प ( d ) सही सुमेलित नहीं है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC RO/ARO (Pre) 2021", "lang": "hi", "page": 571, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0089", "q": "निम्नलिखित में से कौन-से देश समुद्र/महासागर के तट पर स्थित नहीं हैं?\n1. कांगो गणराज्य\n2. नाइजर\n3. इथियोपिया\n4. गिनी बिसाऊ\nनीचे दिए गए कूट से सही उत्तर चुनिएः\nकूटः", "options": ["1 और 3", "2 और 4", "2 और 3", "3 और 4"], "answer": 2, "explanation": "नाइजर व इथियोपिया अफ्रीका महाद्वीप के स्थलबद्ध देश हैं। इस महाद्वीप के अन्य स्थलबद्ध देश बोत्सवाना, बुर्किना- फासों, मध्य अफ्रीकन गणतंत्र, बुरूण्डी, चाड, लेसोथो, मलावी, माली, रवांडा, दक्षिणी सूडान, स्वाजीलैण्ड, युगाण्डा, जाम्बिया, जिम्बाब्वे आदि हैं। अफ्रीका महाद्वीप में कुल 16 स्थलबद्ध देश हैं।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC ACF/RFO (M) 2020 (Paper-Ist)", "lang": "hi", "page": 572, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0090", "q": "निम्नलिखित में से कौन एक अफ्रीका का स्थलाबद्ध देश है?", "options": ["अंगोला", "चाड", "केन्या", "सेनेगल"], "answer": 1, "explanation": "उपर्युक्त प्रश्न की व्याख्या देेखें।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UP UDA/LDA (M) 2010", "lang": "hi", "page": 572, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0091", "q": "निम्नलिखित में से किस देश में जनसंख्या का घनत्व सबसे कम है?", "options": ["मंगोलिया", "सऊदी अरब", "इराक", "अफगानिस्तान"], "answer": 0, "explanation": "उपर्युक्त विकल्पों में मंगोलिया का जनघनत्व (2 व्यक्ति प्रति वर्ग किमी. ) सबसे कम है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC RO/ARO (Mains) 2017", "lang": "hi", "page": 573, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0092", "q": "निम्न देशों में से कौन-सा एक स्थलरुद्ध है?", "options": ["बोलीविया", "पेरू", "सूरीनाम", "उरुग्वे"], "answer": 0, "explanation": "जो देश चारों तरफ स्थल भागों से घिरे होते हैं, स्थलरुद्ध देश कहलाते हैं। बोलीविया, दक्षिणी अमेरिका का एक स्थलरुद्ध देश है। बोलीविया की सीमा पेरू, ब्राजील, पराग्वे, अर्जेन्टीना तथा चिली देशों से लगी हुई है। क्षेत्रफल की दृष्टि से दक्षिणी अमेरिका का सबसे बड़ा देश ब्राजील तथा सबसे छोटा देश फ्रेंच गुयाना है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) 2022 | IAS (Pre) G.S. 2003", "lang": "hi", "page": 573, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0093", "q": "निम्नलिखित में से कौन से देश स्लोवाकिया के पड़ोसी देश हैं?\n1. सर्बिया\n2. चेक गणराज्य\n3. हंगरी\n4. ऑस्टि्रया\nनीचे दिए गए कूट से सही उत्तर चुनिएः\nकूटः", "options": ["1, 2 तथा 4", "1, 2 तथा 3", "2, 3 तथा 4", "1, 3 तथा 4"], "answer": 2, "explanation": "स्लोवाकिया एक यूरोपीय देश हैं। इसके पड़ोसी देश– हंगरी, ऑस्टि्रया, चेक गणराज्य, पोलैंड एवं यूक्रेन हैं। सर्बिया इसका पड़ोसी देश नहीं है, यह हंगरी का पड़ोसी देश है। अतः विकल्प ( c ) सही है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC ACF (Pre), 2017", "lang": "hi", "page": 573, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0094", "q": "निम्नलिखित देशों में से कौन देश स्थल बाधित हैं?\n1. अफगानिस्तान\n2. हंगरी\n3. मलेशिया\n4. स्विट्जरलैण्ड\nनीचे दिये गये कूट में से सही उत्तर का चयन कीजिए-\nकूटः", "options": ["1 और 2", "1, 2, और 3", "2, 3 और 4", "1, 2 और 4"], "answer": 3, "explanation": "स्थल बाधित देश चारों तरफ से भूमि से घिरे होते हैं। दिये गये विकल्प में स्थल बाधित देश निम्न हैं – अफगानिस्तान, हंगरी एवं स्विट्जरलैण्ड।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) G.S. 2009", "lang": "hi", "page": 575, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0095", "q": "निम्नलिखित देशों में से कौन-सा स्थल अवरूद्ध देश नहीं है?", "options": ["अफगानिस्तान", "लाइबेरिया", "लाओस", "लक्जेमबर्ग"], "answer": 1, "explanation": "लाइबेरिया अफ्रीका महाद्वीप के पश्चिम में दक्षिणी अटलांटिक महासागर के किनारे स्थित है। लाओस के उत्तर में चीन, पूर्व में वियतनाम, पश्चिम में म्यांमार तथा दक्षिण में थाइलैण्ड तथा कम्बोडिया स्थित है। अफगानिस्तान, तुर्कमेनिस्तान, उज्बेकिस्तान, ताजिकिस्तान, भारत, पाकिस्तान और ईरान के बीच स्थित है। लक् जमबर्ग - दो तरफ से जर्मनी, उत्तर-पूर्व में बेल्जियम तथा पश्चिम से दक्षिण तक फ्रांस से घिरा हुआ है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) G.S. 2005", "lang": "hi", "page": 575, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0096", "q": "निम्नांकित में से कौन स्कैण्डिनेवियन देशों के समूह में सम्मिलित नहीं है?", "options": ["डेनमार्क", "फिनलैण्ड", "नार्वे", "स्वीडन"], "answer": 1, "explanation": "फिनलैण्ड स्कैंडिनेवियन देशों के समूह में सम्मिलित नहीं है। यूरोप में स्थित नार्वे, स्वीडन, आइसलैण्ड और डेनमार्क स्कैंडिनेवियन देशों के समूह हैं। फिनलैण्ड में हिमोढ़ों के जमाव से हजारों झीलें निर्मित हुई हैं इसलिए फिनलैण्ड को `झीलों का देश' कहा जाता है। नार्वे को `उगते हुए सूर्य का देश' कहते हैं।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) G.S. 2003", "lang": "hi", "page": 575, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0097", "q": "दक्षिण-पूर्वी एशिया में निम्न में स्थल अवरुद्ध देश है, केवल ─", "options": ["कम्बोडिया", "लाओस", "मलेशिया", "थाईलैण्ड"], "answer": 1, "explanation": "लाओस, दक्षिण-पूर्वी एशिया में स्थित एकमात्र स्थलरूद्ध देश है। इसकी सीमाएं चीन, म्यांमार, वियतनाम, थाइलैण्ड तथा कम्बोडिया से लगती हैं। नेपाल तथा भूटान भी स्थलरूद्ध देश हैं। थाइलैण्ड एक स्थलरूद्ध देश नहीं है, क् योंकि इसकी सीमा दक्षिण चीन सागर से लगती है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre.) G.S. 2003 | RAS/RTS (Pre.) G.S. 1996 | IAS (Pre) 1993", "lang": "hi", "page": 575, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0098", "q": "निम्नलिखित में से कौन-सा एक देश भौगोलिक रूप से अमेरिका में स्थित होने पर भी राजनीतिक दृष्टि से यूरोप का भाग है?", "options": ["आइसलैण्ड", "केनरी आइसलैण्ड्स", "ग्रीनलैण्ड", "क्यूबा"], "answer": 2, "explanation": "ग्रीनलैण्ड, भौगोलिक दृष्टि से उत्तरी अमेरिका महाद्वीप में स्थित है परन्तु राजनैतिक रूप से वह डेनमार्क ( यूरोप महाद्वीप का देश ) का भाग है। क्यूबा मध्य अमेरिका का देश है। आइसलैण्ड यूरोप के स्कैंडिनेवियन देशों के समूह ( डेनमार्क, नार्वे, स्वीडन ) में से एक है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre.) G.S. 2002", "lang": "hi", "page": 575, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0099", "q": "क्षेत्रफल की दृष्टि से निम्न देशों का सही आरोही क्रम कौन सा है?", "options": ["ब्राजील, अर्जेन्टीना, ऑस्ट्रेलिया, भारत", "ऑस्ट्रेलिया, ब्राजील, भारत, अर्जेन्टीना", "अर्जेन्टीना, भारत, ऑस्ट्रेलिया, ब्राजील", "भारत, ब्राजील, अर्जेन्टीना, ऑस्ट्रेलिया"], "answer": 2, "explanation": "दिये गये प्रश्न में (c) विकल्प सही है। प्रमुख देशों का क्षेत्रफल आरोही क्रम में इस प्रकार है – अर्जेन्टीना (2780400 वर्ग किमी .), भारत (3287263 वर्ग किमी .), ऑस्ट्रेलिया (7741220 वर्ग किमी .), ब्राजील (8515770 वर्ग किमी .)।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) GS, 2012", "lang": "hi", "page": 575, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0100", "q": "आज संसार में सर्वाधिक नगरीकृत देश है", "options": ["जर्मनी", "जापान", "सिंगापुर", "U.S.A./ संयुक्त राज्य अमेरिका"], "answer": 2, "explanation": "विश्व के प्रमुख सर्वाधिक नगरीकृत देश इस प्रकार हैं – सिंगापुर- 100%, हांगकांग -100%, कुवैत- 100%, बेल्जियम- 98%।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) G.S. 2005", "lang": "hi", "page": 576, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0101", "q": "सूची- I से सूची- II का सुमेल कीजिए तथा\nनीचे दिये गये कूट से सही उत्तर का चयन कीजिये ─\nसूची- I सूची- II ( समुद्री यात्री ) ( देश )\nA. स्पेन वास्को-डिगामा\nB. पुर्तगाल क्रिस्टोफर कोलम्बस\nC. हॉलैण्ड कैप्टन कुक\nD. तस्मान\n4. ग्रेट बि्रटेन\nकूटः A B C D", "options": ["3 2 1 4", "2 1 4 3", "1 4 3 2", "4 3 2 1"], "answer": 1, "explanation": "सही सुमेलित युग्म इस प्रकार हैं- सूची -I सूची -II (समुद्री यात्री) (देश) वास्को-डिगामा - पुर्तगाल क्रिस्टोफर कोलम्बस - स्पेन कैप्टन कुक - ग्रेट बि्रटेन तस्मान - हॉलैण्ड अतः विकल्प (b) सही सुमेलित है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) G.S. 1994", "lang": "hi", "page": 576, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0102", "q": "‘अफ्रीका का सींग’ में किसे सम्मिलित नहीं किया जाता है?", "options": ["इथियोपिया", "इरीटि्रया", "सोमालिया", "सूडान"], "answer": 3, "explanation": "अफ्रीका का सींग (हार्न ऑफ अफ्रीका) में सूडान सम्मिलित नहीं है। हार्न ऑफ अफ्रीका में शामिल देश हैं– इथियोपिया, इरीटि्रया, सोमालिया व जिबूती।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains) G.S. Ist Paper 2009", "lang": "hi", "page": 576, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0103", "q": "निम्नलिखित देशों में से किन्हें “स्वर्णिम अर्द्धचन्द्र” में सम्मिलित किया जाता है?\n1. अफगानिस्तान\n2. ईरान\n3. इराक\n4. पाकिस्तान\nनीचे दिए गए कूट से सही उत्तर का चयन कीजिएः\nकूटः", "options": ["1 एवं 2", "3 एवं 4", "1, 2 एवं 3", "1, 2 एवं 4"], "answer": 3, "explanation": "अफगानिस्तान, ईरान, पाकिस्तान को ‘स्वर्णिम अर्द्धचन्द्र’ (Golden Crescent) कहा जाता है। ये अफीम उत्पादक देश हैं। अतः विकल्प (d) सही है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains) G.S. Ist Paper 2007", "lang": "hi", "page": 576, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0104", "q": "निम्नलिखित देशों के समूहों में से कौन से एक समूह को `बेनिलक्स देश' कहा जाता है?", "options": ["बेल्जियम, डेनमार्क, नीदरलैंड्स", "बेल्जियम, नीदरलैंड्स, लक्जमबर्ग", "डेनमार्क, फिनलैंड, लक्जमबर्ग", "नार्वे, स्वीडन, फिनलैंड"], "answer": 1, "explanation": "बेल्जियम, नीदरलैंड और लक्जमबर्ग को ʻ बेनिलक्स देश ʼ कहा जाता है। इसका मुख्यालय ब्रूसेल्स (बेल्जियम) में स्थित है। इस संगठन का उद्देश्य व्यापारिक सहयोग है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains) Spl. G.S. 2004", "lang": "hi", "page": 576, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0105", "q": "निम्नलिखित में से किस अफ्रीकी देश की सीमा भूमध्य सागर से नहीं मिलती है?", "options": ["अल्जीरिया", "चाड", "मोरक्को", "ट्यूनीशिया"], "answer": 1, "explanation": "अफ्रीकी देश चाड की सीमा भूमध्य सागर से नहीं मिलती है। भूमध्य सागर की सीमा से लगे अफ्रीकी देश हैं– मोरक्को, अल्जीरिया, ट्यूनीशिया, लीबिया तथा मिस्र।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains) G.S. Ist Paper 2010", "lang": "hi", "page": 576, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0106", "q": "निम्नलिखित देशों में से कौन मध्य अमेरिका में स्थित नहीं है?", "options": ["पनामा", "सियरा लियोन", "होण्डूरास", "ग्वाटेमाला"], "answer": 1, "explanation": "सिएरा लियोन मध्य अमेरिका में स्थित न होकर अफ्रीका में स्थित है। मध्य अमेरिका में कुल सात देश हैं जो निम्नलिखित हैं– (1) ग्वाटेमाला (2) बेलीज (3) अल सल्वाडोर (4) होण्डूरास (5) कोस्टारिका (6) निकारागुआ (7) पनामा।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UP RO/ARO (M) 2014", "lang": "hi", "page": 576, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0107", "q": "दक्षिण अमेरिका का सबसे घना बसा देश है–", "options": ["बोलीविया", "कोलम्बिया", "इक्वेडोर", "वेनेजुएला"], "answer": 2, "explanation": "दक्षिण अमेरिका का सबसे घना बसा देश इक्वेडोर है। देश जनघनत्व ( व्यक्ति/वर्ग किमी. ) इक्वेडोर 72 कोलम्बिया 47 वेनेजुएला 32 बोलीविया 11", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UP UDA/LDA (M) 2010", "lang": "hi", "page": 577, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0108", "q": "निम्नलिखित देशों में कौन अन्तर्महाद्वीपीय हैं?\n1. लाओस\n2. जॉर्जिया\n3. टर्की\n4. ट्यूनीशिया\nनीचे दिए गए कूट से सही उत्तर का चयन कीजिए ─\nकूटः", "options": ["1 एवं 2", "2 एवं 3", "1 एवं 4", "3 एवं 4"], "answer": 1, "explanation": "अन्तर्महाद्वीपीय देश उन देशों को कहा जाता है जो एक से आधक महाद्वीपों में विस्तृत हों। उपर्युक्त विकल्प में अन्तर्महाद्वीपीय देश जॉर्जिया तथा टर्की हैं। जार्जिया और टर्की का विस्तार एशिया और यूरोप दोनों महाद्वीपों में है। अतः विकल्प (b) सही है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UP Lower (Pre) 2009", "lang": "hi", "page": 577, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0109", "q": "निम्न में से कौन सा देश क्षेत्रफल में भारत से ब डा नहीं है?", "options": ["रूस", "ब्राजील", "कनाडा", "फ्रांस"], "answer": 3, "explanation": "क्षेत्रफल की दृष्टि विश्व के प्रमुख देश निम्नलिखित हैं– (देश) (क्षेत्रफल) 1. रूस 17098242 वर्ग किमी. 2. कनाडा 9984670 वर्ग किमी. 3. संयुक्त राज्य अमेरिका 9833517 वर्ग किमी. 4. चीन 9596960 वर्ग किमी. 5. ब्राजील 8515770 वर्ग किमी. 6. ऑस्ट्रेलिया 7741220 वर्ग किमी. 7. भारत 3287263 वर्ग किमी. 8. फ्रांस 549970 वर्ग किमी. अतः स्पष्ट है कि प्रांस, भारत से ब डा नहीं है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UP RO/ARO (Pre) 2013", "lang": "hi", "page": 577, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0110", "q": "निम्नलिखित कथनों पर विचार कीजिएः\n1. रूस में जनसंख्या घनत्व निम्न है तथा आधकांश जनसंख्या यूराल के पूर्वी भाग में है।\n2. रूस के आधकांश बड़े नगर यूरोपी- रूस में स्थित हैं।\n3. रूस उत्तरी गोलार्द्ध का सर्वाधिक जनसंख्या वाला देश है।\n4. रूस एक बहुसंस्कृतिक देश है। उपरोक्त में से सही कथन हैंः", "options": ["केवल 1, 2 तथा 3", "केवल 2 तथा 4", "केवल 2, 3 तथा 4", "उपरोक्त सभी कथन सही हैं।"], "answer": 1, "explanation": "रूस में जनसंख्या घनत्व निम्न है तथा आधकांश जनसंख्या यूराल के पश्चिमी भाग में बसी है न कि पूर्वी भाग में। रूस दो महाद्वीपों में विस्तृत विश्व का विशालतम देश है इसका विस्तार एशिया और यूरोप दोनों महाद्वीपों में है। उल्लेखनीय है कि रूस के आधकांश ब डे नगर यूरोपी-रूस में स्थित हैं। रूस एक बहुसंस्कृतिक देश है। उत्तरी गोलार्द्ध का सर्वाधिक जनसंख्या वाला देश चीन है न कि रूस। अतः विकल्प (b) सही है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC ACF (Pre) 2017", "lang": "hi", "page": 577, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0111", "q": "निम्नलिखित में से कौन-सा युग्म सही सुमेलित नहीं है? राजधानी देश", "options": ["ओटावा कनाडा", "डब्लिन आयरलैंड", "नैप्यीदाँ म्याँमार", "खार्तूम इथोपिया"], "answer": 3, "explanation": "सही सुमेलित युग्म इस प्रकार हैं– ( राजधानी ) ( देश ) ओटावा कनाडा डब्लिन आयरलैंड नैप्यीदाँ म्यांमार खार्तूम सूडान अतः विकल्प (d) सही सुमेलित नहीं है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Pre) 2024", "lang": "hi", "page": 581, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0112", "q": "निम्नलिखित में से कौन-सा/से यूरोप के किसी देश की राजधानी नहीं है/हैं?\n1. /रीगा\n2. /रॉटरडैम\n3. /जाग्रेब\n4. /ज्यूरिख\nनीचे दिए गए कूट में से सही उत्तर का चयन कीजिए − कूट −", "options": ["केवल 1", "1 और 3", "केवल 4", "2 और 4"], "answer": 3, "explanation": "दिए गए विकल्पों में रॉ टरडैम एवं ज्यूरिख किसी भी यूरोपीय देश की राजधानी नहीं हैं। रॉटरडैम, नीदरलैंड का एक व्यापारिक बन्दरगाह है तथा ज्यूरिख, स्विट्जरलैण्ड का सबसे बड़ा नगर है जबकि रीगा, लाटविया देश की राजधानी है एवं जाग्रेब, क्रोएशिया की राजधानी है। अतः विकल्प ( d ) सही है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS RO/ARO (Pre) 2023 (Cancelled)", "lang": "hi", "page": 581, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0113", "q": "सूची- I को सूची- II से सुमेलित कीजिए तथा\nनीचे दिए गए कूट से सही उत्तर चुनिए −\nसूची- I सूची- II देश ) राजधानी शहर )\nA. कंपाला\n1. रवांडा\nB. किगाली\n2. यूगांडा\nC. किंशासा\n3. सूडान\nD. खार्तूम\n4. कांगो लोकतांत्रिक गणराज्य कूट − A B C D", "options": ["1 2 4 3", "1 2 3 4", "2 1 4 3", "2 1 3 4"], "answer": 2, "explanation": "सही सुमेलित युग्म इस प्रकार हैं- सूची- I सूची- II (राजधानी शहर) (देश) कंपाला – युगांडा किगाली – रवांडा किंशासा – कांगो लोकतान्त्रिक गणराज्य खार्तूम – सूडान अतः विकल्प (c) सही सुमेलित है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS RO/ARO (Pre) 2023 (Cancelled)", "lang": "hi", "page": 581, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0114", "q": "निम्नलिखित में से कौन-सा युग्म सुमेलित नहीं है? देश ) राजधानी )", "options": ["एंटिगुआ और बारबूडा सेंट जॉन्स", "डोमिनिका सेंटो डोमिंगो", "अल साल्वाडोर सैन सल्वाडोर", "बहामास नासाउ"], "answer": 1, "explanation": "सही सुमेलित युग्म इस प्रकार हैं- (देश) (राजधानी) एंटिगुआ और बारबूडा – सेंट जॉन्स डोमिनिका – रोसेउ अल साल्वाडोर – सैन सल्वाडोर बहामास – नासाऊ अतः विकल्प (b) सही सुमेलित नहीं है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPSC RO/ARO (Pre) 2021", "lang": "hi", "page": 582, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0115", "q": "निम्न में से कौन सा युग्म सही सुमेलित है? देश नगर", "options": ["वेनेजुएला ─ बोगोटा", "न्यूजीलैण्ड ─ कराकास", "कोलम्बिया ─ वेलिंग्टन", "साइप्रस ─ निकोसिया"], "answer": 3, "explanation": "सही सुमेलित युग्म इस प्रकार हैं – (देश) (राजधानी) कोलम्बिया – बोगोटा वेनेजुएला – कराकास न्यूजीलैण्ड – वेलिंग्टन साइप्रस – निकोसिया अतः विकल्प (d) सही सुमेलित है।", "topic": "महाद्वीप, देश, राजधानी एवं सीमाएँ", "source": "UPPCS (Mains) G.S. Ist Paper 2012", "lang": "hi", "page": 582, "repeat_flag": false, "exam": "uppsc", "subject": "geography", "series": "world_geography"}, {"id": "world_geography-0116", "q": "निम्नलिखित में किसका सुमेल नहीं है?", "options": ["फिजी सुवा", "