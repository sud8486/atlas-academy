ment-0516", "q": "‘भितरकणिका’ जिसे अभी हाल में ही विश्व धरोहर स्थल की सूची में सम्मिलित किया गया है‚ अवस्थित है", "options": ["आंध्र प्रदेश में", "छत्तीसगढ़ में", "ओडिशा में", "पश्चिम बंगाल में"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Spl.) (Mains) 2008", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0517", "q": "सूची-I को सूची-II से सुमेलित कीजिए तथा सूचियों के नीचे दिए\nगए कूट का प्रयोग कर सही उत्तर चुनिए।\nसूची-I (वन्यजीव अभयारण्य)\nसूची-II (राज्य)\nA. नामदफा\n1. कर्नाटक\nB. बांदीपुर\n2. अरुणाचलpप्रदेnशapdfs\nC. पेरियार अध्ययन in @A 3J.o मणिपुर\nD. लामजाओ\n4. केरल\nकूट :\nA\nB\nC\nD", "options": ["2 1 4 3", "4 3 2 1", "4 2 1 3", "2 4 3 1"], "answer": 0, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2015", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0518", "q": "निम्निलखित में कौन प्राकृतिक गैस का मुख्य भाग है?", "options": ["ईथेन", "ब्यूटेन", "कार्बन मोनोऑक्साइड", "मीथेन"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. P.C.S. (Pre) 2018", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0519", "q": "समुद्री घास निम्नलिखित तत्व का मुख्य तथा महत्वपूर्ण स्रोत है", "options": ["आयोडीन", "क्लोरीन", "ब्रोमीन", "उपर्युक्त में से कोई नहीं"], "answer": 0, "explanation": "", "topic": "", "source": "U.P. R.O./A.R.O. (Pre) 2017", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0520", "q": "निम्नलिखित में से कौन सही सुमेलित नहीं है? जंतु नस्ल", "options": ["भैंस भदावरी", "गाय सिंधी", "बकरी जमुनापारी", "भेड़ थारपारकर"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2021", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0521", "q": "सूची-I को सूची-II से सुमेलित कीजिए तथा सूचियों के नीचे दिए\nगए कूट का प्रयोग कर सही उत्तर चुनिए।\nसूची-II\nसूची-I\nA. त्वचा कैंसर\n1. क्लोरोफ्लोरोकार्बन\nB. ध्वनि प्रदूषण\n2. पराबैंगनी प्रकाश\nC. वैश्विक तापन\n3. डेसीबल\nD. ओजोन छिद्र\n4. कार्बन डाइऑक्साइड\nकूट :\nA\nB\nC\nD", "options": ["1 2 3 4", "2 3 4 1 अध्ययन pdfs Apna @ n i o J", "2 3 1 4", "4 3 2 1"], "answer": 1, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2015", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0522", "q": "उत्तर प्रदेश में प्रथम बायो-टेक पाक स्थापित किया गया है", "options": ["आगरा में", "इलाहाबाद में", "लखनऊ में", "वाराणसी में"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.U.D.A./L.D.A. (Mains) 2010 | U.P.P.C.S. (Mains) 2008 | U.P.P.C.S. (Mains) 2010 | U.P.P.C.S (Mains) 2011 | U.P.P.C.S. (Mains) 2005", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0523", "q": "निम्नलिखित में से किस हरिकेन ने सन् 2012 में यू.एस.ए. के उत्तरपूर्व एवं पूर्वी तटीय प्रांतों को दुष्प्रभावित किया?", "options": ["कैटरीना", "विल्मा", "रीटा", "सैण्डी"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Mains) 2014", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0524", "q": "‘इको माक’ योजना‚ 1991 में उपभोक्ताओं को ऐसे उत्पादों को खरीदने के लिए प्रोत्साहित करने हेतु आरंभ की गई जिनका पर्यावरणीय प्रभाव कम हानिकर हो। निम्नलिखित उपभोक्ता उत्पादों में से कौन-सा इस योजना के अंतर्गत अधिसूचित नहीं है?", "options": ["साबुन एवं अपमार्जक", "कागज एवं प्लास्टिक", "सौंदर्य प्रसाधन एवं ऐरोसॉल", "ओषधियां एवं प्रतिजैविकी"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2013", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0525", "q": "कौन-सा भारतीय वैज्ञानिक‚ ‘यूनपे ’ (UNEP) द्वारा ‘‘फादर ऑफ इकोनॉमिक इकोलॉजी’’ अभिम्यत है?", "options": ["बी.पी. पाल", "यश पाल", "एम.एस. स्वामीनाथन", "आर. मिश्रा"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2007", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0526", "q": "प्रायद्वीपीय भारत निम्न हिम युगों में से किस युग में हिमानीकृत हुआ?", "options": ["ह्यूरोनियन हिम युग", "काब नीफेरस हिम युग", "प्लीस्टोसीन हिम युग", "लिटिल हिम युग"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.U.D.A./L.D.A. (Spl.) (Mains) 2010", "lang": "hi", "test_no": 22, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0527", "q": "भारत के सबसे बड़े चरखे के संदर्भ में निम्नलिखित में से कौन-सा\nकथन सही है/हैं?\n1. इसका उद्घाटन नोएडा में हुआ।\n2. यह उपयोग किए हुए प्लास्टिक कचरे से बना है।\nनीचे दिए कूट में से सही उत्तर चुनिए–\nकूट :", "options": ["केवल 1", "केवल 2", "1 तथा 2 दोनों", "न तो 1 और न ही 2 (e) उपर्युक्त में से कोई नहीं"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2019", "lang": "hi", "test_no": 22, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0528", "q": "भारत में मिट्टी बचाओ आंदोलन कहां से प्रारंभ हुआ?", "options": ["थाने‚ महाराष्ट्र", "मैसूर‚ कर्नाटक", "दरभंगा‚ बिहार", "होशंगाबाद‚ मध्य प्रदेश"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2020", "lang": "hi", "test_no": 22, "exam": "uppsc", "subject": "environment", "series": "environment"}]PK
