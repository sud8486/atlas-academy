01", "q": "निम्नलिखित में से कौन सही सुमेलित नहीं है?", "options": ["विश्व पर्यावरण दिवस - 5 जून", "पृथ्वी दिवस - 22 अप्रैल", "तंबाकू निषेध दिवस - 5 मई", "ओजोन दिवस - 16 सितंबर"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2017", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0502", "q": "सूची-I को सूची-II से सुमेलित कीजिए तथा नीचे दिए गए कूट से\nसही उत्तर चुनिए —\nसूची-II (दिनांक)\nसूची-I (महत्वपूर्ण दिवस)\nA. विश्व जनसंख्या दिवस\n1. मार्च 03\nB. विश्व वन्यजीव दिवस\n2. जुलाई 11\nC. विश्व ओजोन दिवस\n3. अप्रैल 07\nD. विश्व स्वास्थ्य दिवस\n4. सितंबर 16\nकूट —", "options": ["A-1, B-2, C-3, D-4", "A-1, B-3, C-4, D-2", "A-2, B-1, C-3, D-4", "A-2, B-1, C-4, D-3"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.R.O./A.R.O. (Pre) 2023", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0503", "q": "जयपुर के ‘जंतर-मंतर’ को यूनेस्को (यू.एन.ई.एस.सी.ओ.) द्वारा विश्व धरोहर का दर्जा घोषित होने के साथ भारत में‚ अगस्त‚ 2010 तक कितने स्थलों को यह दर्जा प्राप्त हो चुका है?", "options": ["29", "28", "27", "26"], "answer": 1, "explanation": "", "topic": "", "source": "U.P. Lower Sub. (Pre) 2009", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0504", "q": "यूनेस्को की विश्व विरासत सूची में हाल ही में सम्मिलित की गई इमारत है", "options": ["बुलंद दरवाजा", "चार मीनार", "महाबोधि मंदिर", "कोणाक का सूर्य मंदिर"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2002", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0505", "q": "यूनेस्को ‘विश्व धरोहर समिति’ द्वारा इसके किस शहर में संपन्न हुए 43वें सत्र में जयपुर को ‘विश्व धरोहर स्थल’ के रूप में सूचीबद्ध किया गया है?", "options": ["बाकू (अजरबैजान)", "बिश्केक (किर्गिस्तान)", "इस्तांबुल (तुर्की)", "मारकेश (मोरक्को)"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2019", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0506", "q": "निम्नलिखित युग्मों में से कौन एक सुमेलित नहीं है?", "options": ["एपिको आंदोलन पी. हेगड़े", "चिपको आंदोलन एस.एल. बहुगुणा", "नर्मदा बचाओ आंदोलन मेधा पाटकर", "शांत घाटी आंदोलन बाबा आम्टे"], "answer": 3, "explanation": "", "topic": "", "source": "U.P. Lower (Sub.) (Pre) 2009", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0507", "q": "भारत में ‘रैली फॉर वैली’ प्रोग्राम का आयोजन निम्न में से किस एक समस्या को उजागर करने के लिए किया गया था ?", "options": ["पर्यावरण विकृति", "जैव विविधता", "विस्थापितों के पुनर्वास की समस्या", "कृषि भूमि की क्षति"], "answer": 2, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2003", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0508", "q": "सूची-I को सूची-II के साथ सुमेल कीजिए तथा नीचे दिए गए कूट\nसे सही उत्तर चुनिए।\nसूची-I (राज्य)\nसूची-II (राष्ट्रीय उद्यान)\nA. असम\n1. काजीरंगा\nB. गुजरात\n2. कान्हा\nC. मध्य प्रदेश\n3. काबट\nD. उत्तराखंड\n4. गिर\nकूट :\nA\nB\nC\nD", "options": ["3 2 4 1", "2 4 1 3", "1 3 2 4", "1 4 2 3"], "answer": 3, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Mains) 2002", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0509", "q": "राज्य राष्ट्रीय उद्यान असम काजीरंगा गुजरात गिर मध्य प्रदेश कान्हा उत्तराखंड काबट धूल प्रदूषण रोकने के लिए उपयुक्त वृक्ष है", "options": ["सीता अशोक", "महुआ", "पॉपलर", "नीम"], "answer": 0, "explanation": "", "topic": "", "source": "U.P.P.C.S. (Pre) 2007", "lang": "hi", "test_no": 21, "exam": "uppsc", "subject": "environment", "series": "environment"}, {"id": "environment-0510", "q": "पेरियार वन्यजीव अभयारण्य निम्नलिखित में से किस राज्य म