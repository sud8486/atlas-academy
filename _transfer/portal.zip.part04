pic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0109", "q": "स्थाई जमा सुविधा (Standing Deposit Facility) दर कितनी रखी गई?", "options": ["3 प्रतिशत", "5 प्रतिशत", "4 प्रतिशत", "9 प्रतिशत"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "भारतीय रिज़र्व बैंक (RBI) ने रेपो दर कितनी रखी है? → 5.25 प्रतिशत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0110", "q": "सीमांत स्थाई सुविधा (Marginal Standing Facility) दर कितनी है?", "options": ["3.85 प्रतिशत", "6.16 प्रतिशत", "5.50 प्रतिशत", "4.84 प्रतिशत"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "भारतीय रिज़र्व बैंक (RBI) ने रेपो दर कितनी रखी है? → 5.25 प्रतिशत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0111", "q": "बैंक दर कितनी रखी गई है?", "options": ["4.84 प्रतिशत", "3.85 प्रतिशत", "8.80 प्रतिशत", "5.50 प्रतिशत"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "भारतीय रिज़र्व बैंक (RBI) ने रेपो दर कितनी रखी है? → 5.25 प्रतिशत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0112", "q": "वित्त वर्ष 2025-26 में कुल कितने UPI लेनदेन हुए?", "options": ["लगभग 14980.25 करोड़", "लगभग 38658.70 करोड़", "लगभग 24161.69 करोड़", "लगभग 18846.12 करोड़"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0113", "q": "UPI लेन-देन में वर्ष-दर-वर्ष वृद्धि कितनी रही?", "options": ["26 प्रतिशत", "48 प्रतिशत", "34 प्रतिशत", "30 प्रतिशत"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "वित्त वर्ष 2025-26 में कुल कितने UPI लेनदेन हुए? → लगभग 24161.69 करोड़", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0114", "q": "इस UPI लेन-देन का कुल मूल्य कितना रहा?", "options": ["₹314 लाख करोड़", "₹502 लाख करोड़", "₹195 लाख करोड़", "₹220 लाख करोड़"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "वित्त वर्ष 2025-26 में कुल कितने UPI लेनदेन हुए? → लगभग 24161.69 करोड़", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0115", "q": "FY 2025-26 में प्रमुख बंदरगाहों ने कितना कार्गो हैंडल किया?", "options": ["640.62 मिलियन टन", "915.17 मिलियन टन", "805.35 मिलियन टन", "1143.96 मिलियन टन"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0116", "q": "FY 2025-26 में शीर्ष प्रदर्शन करने वाला प्रमुख बंदरगाह कौन रहा?", "options": ["दीनदयाल पोर्ट अथॉरिटी (200.14 मिलियन टन), गुजरात", "दीनदयाल पोर्ट अथॉरिटी (256.18 मिलियन टन), गुजरात", "दीनदयाल पोर्ट अथॉरिटी (227.36 मिलियन टन), गुजरात", "दीनदयाल पोर्ट अथॉरिटी (160.11 मिलियन टन), गुजरात"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "FY 2025-26 में प्रमुख बंदरगाहों ने कितना कार्गो हैंडल किया? → 915.17 मिलियन टन", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0117", "q": "आवधिक श्रम बल सर्वेक्षण (PLFS) वार्षिक रिपोर्ट 2025 के अनुसार, 15 वर्ष और अधिक आयु वर्ग में बेरोजगारी दर कितनी रही?", "options": ["4.4 प्रतिशत", "3.1 प्रतिशत", "2.2 प्रतिशत", "1.9 प्रतिशत"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0118", "q": "वर्ष 2025 में 15 वर्ष और अधिक आयु वर्ग के शिक्षित व्यक्तियों में बेरोजगारी दर कितनी रही?", "options": ["4.5%", "10.4%", "6.5%", "7.3%"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "आवधिक श्रम बल सर्वेक्षण (PLFS) वार्षिक रिपोर्ट 2025 के अनुसार, 15 वर्ष और अधिक आयु वर्ग में बेरोजगारी दर कितनी रही? → 3.1 प्रतिशत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0119", "q": "2025 में 15 वर्ष और अधिक आयु वर्ग में श्रम बल भागीदारी दर कितनी रही?", "options": ["94.9%", "59.3%", "41.5%", "52.2%"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "आवधिक श्रम बल सर्वेक्षण (PLFS) वार्षिक रिपोर्ट 2025 के अनुसार, 15 वर्ष और अधिक आयु वर्ग में बेरोजगारी दर कितनी रही? → 3.1 प्रतिशत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0120", "q": "जनवरी-दिसंबर, 2025 में देश में औसतन 15 वर्ष और अधिक आयु के कितने लोग रोजगार में थे?", "options": ["43.1 करोड़", "98.6 करोड़", "61.6 करोड़", "87.5 करोड़"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "आवधिक श्रम बल सर्वेक्षण (PLFS) वार्षिक रिपोर्ट 2025 के अनुसार, 15 वर्ष और अधिक आयु वर्ग में बेरोजगारी दर कितनी रही? → 3.1 प्रतिशत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0121", "q": "सरकार ने PDS (सार्वजनिक वितरण प्रणाली) SKO मुक्त राज्यों/केंद्रशासित प्रदेशों में किस वस्तु के वितरण को अधिकृत किया?", "options": ["ब्यूरो ऑफ पोर्ट सिक्योरिटी (BoPS)", "हाउस ऑफ लॉर्ड्स (यू.के.)", "भारत समुद्री बीमा पूल (BMI Pool)", "उच्च गुणवत्ता वाला केरोसिन तेल"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0122", "q": "सरकार ने SEBI में किसे पूर्णकालिक सदस्य नियुक्त किया?", "options": ["कोम्पेला वेंकट रमण मूर्ति", "निर्मला सीतारमण", "सोनाली सेन गुप्ता", "एस. सुब्रमण्येस्वर"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0123", "q": "WTO की 14वीं मंत्रिस्तरीय बैठक कहां संपन्न हुई?", "options": ["ब्रुसेल्स (बेल्जियम)", "याउंडे, कैमरून", "मुंबई", "उत्तर प्रदेश"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0124", "q": "‘गृह सुगम’ पोर्टल किसने लॉन्च किया?", "options": ["विश्व बैंक", "राष्ट्रीय स्टॉक एक्सचेंज (NSE)", "भारतीय प्रतिस्पर्धा आयोग (CCI)", "राष्ट्रीय आवास बैंक"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0125", "q": "‘गृह सुगम’ पोर्टल का मुख्य उद्देश्य किन कर्मियों के लिए गृह ऋण प्रक्रिया को सुविधाजनक बनाना है?", "options": ["निर्यात संवर्धन मिशन (EPM) के तहत", "रक्षा, अर्धसैनिक और सरकारी कर्मी", "मोबाइल फोन विनिर्माण योजना (MPMS)", "भारत औद्योगिक विकास योजना (BHAVYA)"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "‘गृह सुगम’ पोर्टल किसने लॉन्च किया? → राष्ट्रीय आवास बैंक", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0126", "q": "किस संगठन ने भारत को सबसे तेजी से बढ़ती प्रमुख अर्थव्यवस्था बताया?", "options": ["राष्ट्रीय सांख्यिकी कार्यालय (NSO)", "शिपिंग कॉरपोरेशन ऑफ इंडिया लिमिटेड", "विश्व व्यापार संगठन (WTO)", "आर्थिक सहयोग और विकास संगठन (OECD)"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0127", "q": "OECD के अनुसार 2025–26 में भारत की GDP वृद्धि दर कितनी रहेगी?", "options": ["9.5%", "8.5%", "7.6%", "5.3%"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "किस संगठन ने भारत को सबसे तेजी से बढ़ती प्रमुख अर्थव्यवस्था बताया? → आर्थिक सहयोग और विकास संगठन (OECD)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0128", "q": "2026–27 में भारत की GDP वृद्धि दर कितनी रहने का अनुमान है?", "options": ["8.7%", "4.8%", "6.1%", "4.3%"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "किस संगठन ने भारत को सबसे तेजी से बढ़ती प्रमुख अर्थव्यवस्था बताया? → आर्थिक सहयोग और विकास संगठन (OECD)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0129", "q": "‘निवेश मित्र 3.0’ डिजिटल प्लेटफॉर्म कहां लॉन्च हुआ?", "options": ["उत्तर प्रदेश", "हिमाचल प्रदेश", "महाराष्ट्र", "कर्नाटक"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0130", "q": "‘निवेश मित्र 3.0’ का मुख्य उद्देश्य क्या है?", "options": ["सार्वजनिक परिसंपत्तियों का मुद्रीकरण कर नए इंफ्रास्ट्रक्चर में निवेश", "बिना किसी क्षेत्र को छोड़े या दोहराए मकान सूचीकरण ब्लॉकों का डिजिटल निर्माण करना", "निवेशक संबंधी स्वीकृतियों को सरल, त्वरित, पारदर्शी और निवेशक-अनुकूल बनाना", "आवास की स्थिति, उपलब्ध सुविधाओं और परिवारों की परिसंपत्तियों से संबंधित जानकारी"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "‘निवेश मित्र 3.0’ डिजिटल प्लेटफॉर्म कहां लॉन्च हुआ? → उत्तर प्रदेश", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0131", "q": "अंतरराष्ट्रीय मुद्रा कोष (IMF) ने आर्थिक संकट का सामना कर रहे पाकिस्तान को कितनी राशि की तत्काल निकासी की मंजूरी दी है?", "options": ["लगभग 1.32 अरब डॉलर", "लगभग 2.11 अरब डॉलर", "लगभग 1.16 अरब डॉलर", "लगभग 1.48 अरब डॉलर"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0132", "q": "केंद्रीय मंत्रिमंडल ने हाल ही में किस योजना को मंजूरी दी है?", "options": ["आपातकालीन क्रेडिट लाइन गारंटी योजना 5.0 (ECLGS 5.0)", "आपातकालीन क्रेडिट लाइन गारंटी योजना 3.9 (ECLGS 5.0)", "आपातकालीन क्रेडिट लाइन गारंटी योजना 4.4 (ECLGS 5.0)", "आपातकालीन क्रेडिट लाइन गारंटी योजना 8.0 (ECLGS 5.0)"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0133", "q": "आपातकालीन क्रेडिट लाइन गारंटी योजना 5.0 किस कारण से शुरू की गई है?", "options": ["प्रधानमंत्री गरीब कल्याण अन्न योजना (PMGKAY)", "निर्यात संवर्धन मिशन (EPM) के तहत", "मोबाइल फोन विनिर्माण योजना (MPMS)", "पश्चिम एशिया की स्थिति के मद्देनजर"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "केंद्रीय मंत्रिमंडल ने हाल ही में किस योजना को मंजूरी दी है? → आपातकालीन क्रेडिट लाइन गारंटी योजना 5.0 (ECLGS 5.0)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0134", "q": "केंद्रीय मंत्रिमंडल ने किस मिशन को मंजूरी दी है?", "options": ["भारत समुद्री बीमा पूल", "कपास उत्पादकता मिशन", "एक्सपोर्ट प्रमोशन मिशन (EPM)", "सौर, पवन और बैटरी भंडारण"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0135", "q": "मिशन का मुख्य लक्ष्य क्या है?", "options": ["2033-31 तक कपास उत्पादकता को 440 किग्रा./हेक्टेयर से बढ़ाकर 755 किग्रा. प्रति हेक्टेयर करना", "2029-31 तक कपास उत्पादकता को 440 किग्रा./हेक्टेयर से बढ़ाकर 755 किग्रा. प्रति हेक्टेयर करना", "2027-31 तक कपास उत्पादकता को 440 किग्रा./हेक्टेयर से बढ़ाकर 755 किग्रा. प्रति हेक्टेयर करना", "2030-31 तक कपास उत्पादकता को 440 किग्रा./हेक्टेयर से बढ़ाकर 755 किग्रा. प्रति हेक्टेयर करना"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 5, "test_no": 3, "note": "केंद्रीय मंत्रिमंडल ने किस मिशन को मंजूरी दी है? → कपास उत्पादकता मिशन", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0136", "q": "केंद्रीय मंत्रिमंडल की आर्थिक मामलों की समिति ने चीनी सीजन 2026-27 के लिए गन्ने का उचित और लाभकारी मूल्य (FRP) कितना तय किया है?", "options": ["321 रुपये प्रति क्विंटल", "518 रुपये प्रति क्विंटल", "365 रुपये प्रति क्विंटल", "456 रुपये प्रति क्विंटल"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0137", "q": "इंडिया पोस्ट पेमेंट्स बैंक ने कौन-सा नया खाता शुरू किया है?", "options": ["निवेशक शिक्षा एवं संरक्षण कोष (IEPF)", "DBS बैंक", "भारतीय रिजर्व बैंक (RBI)", "स्वयं सहायता समूह बचत खाता"], "answer": 3, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0138", "q": "भारतीय रिज़र्व बैंक ने किसका बैंकिंग लाइसेंस रद्द कर दिया है?", "options": ["भारतीय स्टेट बैंक (SBI)", "स्वयं सहायता समूह बचत खाता", "पेटीएम पेमेंट्स बैंक लिमिटेड", "निवेशक शिक्षा एवं संरक्षण कोष (IEPF)"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0139", "q": "केंद्रीय कैबिनेट ने हाल ही में किस समुद्री बीमा व्यवस्था के गठन को मंजूरी दी?", "options": ["सुरक्षित ऑफलाइन अनुप्रयोग के रूप में", "भारत समुद्री बीमा पूल (BMI Pool)", "घरेलू यूरिया विनिर्माण बढ़ाना", "प्रयोगशाला अनुसंधान को बाजार में बदलना"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0140", "q": "भारत समुद्री बीमा पूल का मुख्य उद्देश्य क्या है?", "options": ["राजनीतिक मामलों की मंत्रिमंडलीय समिति (CCPA) ने", "भारतीय जहाजों को सतत और किफायती समुद्री बीमा उपलब्ध कराना", "सार्वजनिक परिसंपत्तियों का मुद्रीकरण कर नए इंफ्रास्ट्रक्चर में निवेश", "भारत निवासी और भारत के बाहर निवासी पक्षों वाली सीमा-पार गारंटियां"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "note": "केंद्रीय कैबिनेट ने हाल ही में किस समुद्री बीमा व्यवस्था के गठन को मंजूरी दी? → भारत समुद्री बीमा पूल (BMI Pool)", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0141", "q": "विश्व में सबसे बड़ा दूध उत्पादक देश कौन है?", "options": ["भारत", "सोना और चांदी", "यूरोज़ोन", "नीलम और तोतापुरी"], "answer": 0, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0142", "q": "वैश्विक दूध उत्पादन में भारत का योगदान कितना है?", "options": ["लगभग 31%", "लगभग 25%", "लगभग 28%", "लगभग 16%"], "answer": 1, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "note": "विश्व में सबसे बड़ा दूध उत्पादक देश कौन है? → भारत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0143", "q": "पिछले दशक (2014-15 से 2024-25) में दूध उत्पादन की चक्रवृिद्ध वार्षिक वृद्धि दर क्या रही?", "options": ["7.68%", "4.76%", "5.41%", "3.35%"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "note": "विश्व में सबसे बड़ा दूध उत्पादक देश कौन है? → भारत", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0144", "q": "अंतरराष्ट्रीय मुद्रा कोष (IMF) द्वारा अपनी प्रमुख आर्थिक रिपोर्ट किस नाम से जारी की जाती है?", "options": ["भारतीय स्टेट बैंक (SBI)", "ग्लोबल फाइनेंस (न्यूयॉर्क)", "वर्ल्ड इकोनॉमिक आउटलुक", "यंत्र इंडिया लिमिटेड (YIL)"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0145", "q": "IMF के नवीनतम जुलाई, 2026 के अनुसार, WEO Update वर्ष 2026-27 के लिए भारत की ‘रियल जीडीपी’ (Real GDP) विकास दर कितनी रहने का अनुमान है?", "options": ["7.2%", "4.5%", "6.4%", "10.2%"], "answer": 2, "explanation": "", "topic": "महत्वपूर्ण आर्थिक घटनाक्रम", "source": "", "lang": "hi", "page": 6, "test_no": 3, "note": "अंतरराष्ट्रीय मुद्रा कोष (IMF) द्वारा अपनी प्रमुख आर्थिक रिपोर्ट किस नाम से जारी की जाती है? → वर्ल्ड इकोनॉमिक आउटलुक", "exam": "uppsc", "subject": "economy", "series": "samsamayik_arthiki"}, {"id": "samsamayik_arthiki-0146", "q": "IMF के नवीनतम पूर्ण WEO डेटाबेस के सांकेतिक GDP (वर्तमान अमेरिकी डॉलर) के आधार पर भारत का वैश्विक स्थान क्या है?", "options": ["आठवां", "चौथा", 